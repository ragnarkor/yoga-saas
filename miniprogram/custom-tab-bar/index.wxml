<view wx:if="{{!hidden}}" class="tab-bar" style="--tab-active-color: {{selectedColor}};">
  <view
    wx:for="{{list}}"
    wx:key="key"
    class="tab-bar-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image class="tab-icon" src="{{item.iconSrc}}" mode="aspectFit" />
    <text
      class="tab-bar-text"
      style="color: {{selected === index ? selectedColor : color}}"
    >{{item.text}}</text>
  </view>
</view>
