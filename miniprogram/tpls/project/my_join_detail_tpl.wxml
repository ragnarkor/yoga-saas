<!-- [AI_START TIMESTAMP=2025-01-25 15:00:00] -->
<template name="myJoinDetailTpl">
	<!-- 加载中 -->
	<view wx:if="{{isLoad===false}}" class="jd-loading">
		<van-loading size="48rpx" color="{{themeColor}}" type="spinner" />
	</view>

	<!-- 不存在 -->
	<van-empty wx:if="{{isLoad===null}}" description="数据不存在" />

	<view wx:if="{{isLoad}}" class="jd-page">
		<!-- 课程信息卡 -->
		<view class="jd-card jd-course">
			<view class="jd-status-tag jd-status-tag--success" wx:if="{{join.JOIN_STATUS==1}}">{{join.JOIN_IS_CHECKIN==1 ? '已签到' : '预约成功'}}</view>
			<view class="jd-status-tag jd-status-tag--pending" wx:if="{{join.JOIN_STATUS==0}}">待确认</view>
			<view class="jd-status-tag jd-status-tag--cancel" wx:if="{{join.JOIN_STATUS==10}}">已取消</view>
			<view class="jd-status-tag jd-status-tag--system" wx:if="{{join.JOIN_STATUS==99}}">系统取消</view>
			<view class="jd-course-layout" bindtap="url" data-url="../../meet/detail/meet_detail?id={{join.JOIN_MEET_ID}}" aria-role="button" aria-label="查看课程详情">
				<view class="jd-course-body">
					<view class="jd-course-name-wrap">
						<text class="jd-course-name">{{join.JOIN_MEET_TITLE}}</text>
					</view>
					<view class="jd-course-time">
						<van-icon name="clock-o" size="28rpx" color="#999" />
						<text>{{join.JOIN_MEET_DAY}} {{join.JOIN_MEET_TIME_START}}～{{join.JOIN_MEET_TIME_END}}</text>
					</view>
					<view class="jd-course-hint" wx:if="{{join.JOIN_STATUS==1 && join.JOIN_IS_CHECKIN!=1}}">到店后开启定位并完成签到</view>
					<view class="jd-course-reason" wx:if="{{join.JOIN_STATUS==99 && join.JOIN_REASON}}">{{join.JOIN_REASON}}</view>
				</view>
				<view class="jd-course-arrow">
					<van-icon name="arrow" size="28rpx" color="#c0c4cc" />
				</view>
			</view>
			<view class="jd-card-checkin" wx:if="{{join.JOIN_STATUS==1}}">
				<view class="jd-checkin-panel" wx:if="{{join.JOIN_IS_CHECKIN!=1}}">
					<view class="jd-checkin-circle jd-checkin-circle--{{checkinState}}" bindtap="bindLocationCheckinTap" aria-role="button" aria-label="{{checkinCountdownText || '到店签到'}}">
						<van-icon name="location" size="54rpx" color="{{checkinState=='ready' ? '#ffffff' : '#9aa3b2'}}" />
						<text class="jd-checkin-circle-title">{{checkinCountdownText}}</text>
						<text class="jd-checkin-circle-sub">{{checkinState=='before' ? '到签到时间自动开启' : (checkinState=='ended' ? '请联系前台处理' : '需在场馆附近')}}</text>
					</view>
				</view>
				<view class="jd-checkin-done" wx:if="{{join.JOIN_IS_CHECKIN==1}}"><van-icon name="success" size="42rpx" color="#059669" /><text>已完成到店签到</text></view>
			</view>
		</view>

		<!-- 预约操作 -->
		<view class="jd-actions" wx:if="{{join.JOIN_STATUS==0 || join.JOIN_STATUS==1}}">
			<view class="jd-btn jd-btn--ghost" wx:if="{{join.JOIN_IS_CHECKIN==0}}" bindtap="bindCancelTap" aria-role="button" aria-label="取消该预约">取消预约</view>
			<view class="jd-btn jd-btn--primary" bindtap="bindCalendarTap" aria-role="button" aria-label="将本次课程加入手机日程">加入手机日程</view>
		</view>
	</view>
</template>
<!-- [AI_END LINES=66 TIMESTAMP=2025-01-25 15:00:00] -->
