<!-- [AI_START TIMESTAMP=2025-01-24 12:20:00] -->
<template name="calendarIndexTpl">
	<van-empty wx:if="{{isLoad===null}}" description="暂无课程数据" />
	<view wx:if="{{isLoad===false}}" class="loading-wrap">
		<van-loading size="48rpx" color="{{themeColor}}" type="spinner" />
	</view>

	<view class="booking-main" wx:if="{{isLoad}}">

		<!-- 动态页面标题 -->
		<view class="page-header">
			<view class="page-header-bg"></view>
			<view class="page-header-content">
				<view class="page-title text-cut">{{pageTitle}}</view>
				<view class="page-subtitle">{{pageSubtitle}}</view>

				<!-- 卡资产玻璃条 · 有可用卡：展示主卡摘要，点击进入我的卡包 -->
				<view
					wx:if="{{cardAsset && cardAsset.has}}"
					class="asset-bar"
					hover-class="asset-bar--active"
					bindtap="bindCardPackTap"
					aria-role="button"
					aria-label="{{cardAsset.name}}，{{cardAsset.type === 'times' ? '剩' + cardAsset.quota + '次' : cardAsset.balanceText}}，点击查看我的卡包"
				>
					<view class="ab-stack">
						<view wx:if="{{cardAsset.backShade}}" class="ab-chip ab-chip--back" style="{{cardAsset.backShade}}">
							<image wx:if="{{cardAsset.backCover}}" class="ab-cover" src="{{cardAsset.backCover}}" mode="aspectFill" />
						</view>
						<view class="ab-chip ab-chip--front {{cardAsset.frontCover ? '' : 'ab-chip--bare'}}" style="{{cardAsset.frontShade}}">
							<image wx:if="{{cardAsset.frontCover}}" class="ab-cover" src="{{cardAsset.frontCover}}" mode="aspectFill" />
							<text class="ab-chip-type">{{cardAsset.typeLabel}}</text>
						</view>
						<view wx:if="{{cardAsset.count > 1}}" class="ab-count">{{cardAsset.count}}</view>
					</view>
					<view class="ab-body">
						<view class="ab-name text-cut">{{cardAsset.name}}<text class="ab-type">{{cardAsset.typeLabel}}</text></view>
						<view class="ab-sub" wx:if="{{cardAsset.type === 'times'}}">剩 <text class="ab-num">{{cardAsset.quota}}</text> 次{{cardAsset.endShort ? ' · 至 ' + cardAsset.endShort : ''}}</view>
						<view class="ab-sub" wx:else>{{cardAsset.balanceText}}{{cardAsset.endShort ? ' · 至 ' + cardAsset.endShort : ''}}</view>
					</view>
					<view class="ab-more">我的卡包<text class="ab-more-arrow">›</text></view>
				</view>

				<!-- 卡资产玻璃条 · 无可用卡：引导购卡 -->
				<view
					wx:elif="{{cardAsset && !cardAsset.has}}"
					class="asset-bar"
					hover-class="asset-bar--active"
					bindtap="bindGoCardShopTap"
					aria-role="button"
					aria-label="暂无可用会员卡，点击去购卡"
				>
					<view class="ab-none">
						<view class="ab-none-title">暂无可用会员卡</view>
						<view class="ab-none-sub">购卡后即可预约课程</view>
					</view>
					<text class="ab-none-btn">去购卡</text>
				</view>
			</view>
		</view>

		<!-- 课程分类（自定义 Tab，避免 template 内 van-tabs 异步不刷新） -->
		<scroll-view
			wx:if="{{tabs.length}}"
			class="category-tabs"
			scroll-x
			enhanced
			show-scrollbar="{{false}}"
			aria-role="tablist"
		>
			<view class="category-tabs-inner">
				<view
					class="category-tab {{activeTab === index ? 'active' : ''}}"
					wx:for="{{tabs}}"
					wx:key="id"
					data-index="{{index}}"
					bindtap="bindCategoryTap"
					aria-role="tab"
					aria-label="{{item.name}}"
					aria-selected="{{activeTab === index}}"
				>
					<text class="category-tab-text">{{item.name}}</text>
					<view class="category-tab-line" wx:if="{{activeTab === index}}"></view>
				</view>
			</view>
		</scroll-view>

		<!-- 日期选择条 -->
		<view class="date-selector">
			<scroll-view class="date-scroll" scroll-x scroll-with-animation enhanced show-scrollbar="{{false}}">
				<view class="date-list">
					<view class="date-item {{dateItem.day === selectedDate ? 'active' : ''}}"
						wx:for="{{dateList}}" wx:key="day" wx:for-item="dateItem"
						bindtap="bindDateSelect" data-day="{{dateItem.day}}"
						aria-role="button"
						aria-label="{{dateItem.dateMonth}}{{dateItem.dateDay}}日 {{dateItem.weekday}}{{dateItem.hasCourse ? '，有课程' : ''}}"
						aria-selected="{{dateItem.day === selectedDate}}">
						<view class="date-weekday">{{dateItem.weekday}}</view>
						<view class="date-day">{{dateItem.dateDay}}</view>
						<view class="date-month">{{dateItem.dateMonth}}</view>
						<view class="date-indicator" wx:if="{{dateItem.hasCourse}}"></view>
					</view>
				</view>
			</scroll-view>
		</view>

		<!-- 私教 · 特殊课程卡（仅配置了私教课的场馆展示，随时可约，不受分类筛选影响） -->
		<view class="course-list" wx:if="{{showPrivateEntry}}">
			<view class="course-card course-card--private" hover-class="course-card--press" bindtap="bindPrivateBookTap" aria-role="button" aria-label="预约私教课">
				<view class="card-time-section private-time-section">
					<view class="pv-time-top">随时</view>
					<view class="pv-time-sub">时间自选</view>
				</view>
				<view class="card-info-section">
					<view class="course-name">私教课</view>
					<view class="course-tags">
						<text class="pv-badge">私教</text>
						<text class="pv-tag">1v1</text>
					</view>
					<view class="course-coach">
						<view class="coach-avatar-wrap">
							<text class="coach-avatar-fallback">专</text>
						</view>
						<text class="coach-name">专属教练 · 一对一指导</text>
					</view>
				</view>
				<view class="card-action-section">
					<text class="pv-action-top">按次</text>
					<text class="slots-label">划卡预约</text>
					<view class="book-btn"><text>预约</text></view>
				</view>
			</view>
		</view>

		<!-- 课程列表 -->
		<view class="course-list {{showPrivateEntry ? 'course-list--joined' : ''}}" wx:if="{{courseList && courseList.length > 0}}">
			<view class="course-card" wx:for="{{courseList}}" wx:key="cardKey"
				bindtap="url" data-url="/pages/default/meet/detail/meet_detail?id={{item._id}}&day={{selectedDate}}&timeMark={{item.timeMark}}"
				aria-role="button"
				aria-label="{{item.title}}，{{item.timeStart}}至{{item.timeEnd}}，{{item.status === 'booked' ? '已预约，点击查看' : item.status === 'full' ? '已满员，点击候补' : '点击预约'}}">

				<view class="card-time-section">
					<view class="time-primary">{{item.timeStart}}</view>
					<view class="time-secondary">{{item.timeEnd}}</view>
					<view class="time-duration">{{item.duration}}</view>
				</view>

				<view class="card-info-section">
					<view class="course-name text-cut">{{item.title}}</view>
					<view class="course-tags">
						<view class="course-stars" wx:if="{{item.levelNum > 0}}">
							<text
								wx:for="{{item.levelStars}}"
								wx:for-item="star"
								wx:key="index"
								class="course-star {{star ? 'on' : ''}}"
							>★</text>
						</view>
						<van-tag plain type="warning" size="medium" custom-class="course-tag" wx:if="{{item.typeName}}">{{item.typeName}}</van-tag>
					</view>
					<view class="course-coach">
					<view class="coach-avatar-wrap">
						<image wx:if="{{item.coachAvatar}}" class="coach-avatar" src="{{item.coachAvatar}}" mode="aspectFill" />
						<text wx:else class="coach-avatar-fallback">{{item.coachName ? item.coachName[0] : '教'}}</text>
					</view>
						<text class="coach-name">{{item.coachName}}</text>
					</view>
				</view>

				<view class="card-action-section">
					<view class="slots-info">
						<block wx:if="{{item.status === 'available'}}">
							<text class="slots-number">{{item.slots}}</text>
							<text class="slots-label">余位</text>
						</block>
						<block wx:elif="{{item.status === 'booked'}}">
							<text class="slots-status booked">已预约</text>
						</block>
						<block wx:elif="{{item.status === 'full'}}">
							<text class="slots-status full">已满员</text>
						</block>
						<block wx:else>
							<text class="slots-number">{{item.slots}}</text>
							<text class="slots-label">余位</text>
						</block>
					</view>
					<view class="book-btn {{item.status === 'full' ? 'disabled' : ''}}">
						<text>{{item.status === 'booked' ? '查看' : item.status === 'full' ? '候补' : '预约'}}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 空状态：私教卡在上方时收紧排版，避免插画与私教卡脱节 -->
		<view class="empty-state {{showPrivateEntry ? 'empty-state--compact' : ''}}" wx:if="{{!courseList || courseList.length === 0}}">
			<view class="empty-illustration">
				<image class="empty-image" src="{{emptyImage}}" mode="aspectFit" />
			</view>
			<view class="empty-text">{{emptyText}}</view>
			<van-button size="small" round bindtap="bindReload" custom-style="margin-top: 30rpx; padding: 0 40rpx;">
				重新加载
			</van-button>
		</view>

	</view>

	<!-- 底部安全区 -->
	<view class="safe-bottom" wx:if="{{isLoad}}"></view>

</template>
<!-- [AI_END LINES=97 TIMESTAMP=2025-01-24 12:20:00] -->
