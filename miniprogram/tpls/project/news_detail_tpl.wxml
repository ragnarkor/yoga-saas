<!-- [AI_START TIMESTAMP=2025-01-25 15:06:00] -->
<!-- 安全：仅允许 https 协议的 NEWS_URL 进入 web-view，防止 javascript:/file:/data: 等协议注入 -->
<wxs module="urlSafe">
function isSafe(url) {
	if (!url || typeof url !== 'string') {
		return false;
	}
	return url.toLowerCase().indexOf('https://') === 0;
}
module.exports = {
	isSafe: isSafe
};
</wxs>
<template name="newsDetailTpl">
	<van-empty wx:if="{{isLoad===null}}" description="内容不存在" />
	<view wx:if="{{isLoad===false}}" class="loading-wrap">
		<van-loading size="48rpx" color="{{themeColor || '#5b8a72'}}" type="spinner" />
	</view>

	<view wx:if="{{isLoad}}" class="main padding-project">

		<view wx:if="{{news.NEWS_TYPE==0}}" class="article-box margin-top-xs">
			<!-- article content begin -->
			<view class="article card-project shadow-project">
				<view class="title"><text user-select="true">{{news.NEWS_TITLE}}</text></view>
				<view class="time">{{news.NEWS_ADD_TIME}} {{news.NEWS_CATE_NAME}}</view>



			<block wx:if="{{news.NEWS_CONTENT_DELTA}}">
				<rich-text nodes="{{newsContentNodes}}" class="article-rich-text" />
			</block>
			<block wx:else>
				<block wx:for="{{news.NEWS_CONTENT}}" wx:key="key">
					<view class="content" wx:if="{{item.type=='text'}}">
						<text user-select="{{true}}">{{item.val}}</text>
					</view>
					<view class="pics" wx:if="{{item.type=='img'}}">
						<image bindtap="url" data-type='img' data-url="{{item.val}}" show-menu-by-longpress="{{true}}" class="loading" mode='widthFix' lazy-load="true" src="{{item.val}}">
						</image>
					</view>
				</block>
			</block>
			<!-- article content end -->




			</view>
			<!-- article content end -->


		</view>

		<web-view wx:if="{{news.NEWS_TYPE==1 && urlSafe.isSafe(news.NEWS_URL)}}" src="{{news.NEWS_URL}}"></web-view>


	</view>
</template>
