<template name="defaultIndexTpl">

	<cmpt-tenant-switch title="首页" theme-color="{{themeColor}}" />

	<view class="home-page">

		<!-- 顶部横幅 -->
		<view class="home-hero">
			<view class="home-banner" wx:if="{{banners.length > 0}}">
				<swiper class="banner-swiper" indicator-dots autoplay circular interval="4000" duration="500">
					<swiper-item wx:for="{{banners}}" wx:key="_id">
						<view class="banner-item" bindtap="bindBannerTap" data-url="{{item.linkUrl}}">
							<video wx:if="{{item.type === 'video' && item.video}}" class="banner-media" src="{{item.video}}" poster="{{item.pic}}" object-fit="cover" show-center-play-btn="{{false}}" controls="{{false}}"></video>
							<image wx:else class="banner-media" mode="aspectFill" src="{{item.pic || skin.IMG_DEFAULT_INDEX_BG}}" />
						</view>
					</swiper-item>
				</swiper>
			</view>
			<view class="home-banner home-banner-fallback" wx:else>
				<image mode="aspectFill" src="{{skin.IMG_DEFAULT_INDEX_BG}}" />
			</view>
		</view>

		<!-- 场馆名 + 电话 -->
		<view class="home-studio-card">
			<view class="home-studio-main">
				<text class="home-studio-name text-cut">{{tenantName || '瑜伽馆'}}</text>
				<view class="home-studio-divider"></view>
				<view class="home-studio-phone" bindtap="bindPhoneTap">
					<van-icon name="phone-o" size="40rpx" color="{{themeColor}}" />
				</view>
			</view>
			<view class="home-studio-announce" wx:if="{{announcements.length}}" bindtap="bindAnnounceStripTap">
				<van-icon name="volume-o" size="25rpx" color="{{themeColor}}" />
				<text class="home-studio-announce-title text-cut">{{announcements[0].title}}</text>
				<van-icon name="arrow" size="24rpx" color="#b2b5ae" />
			</view>
		</view>

		<!-- 统一行动卡：会员一眼完成查看、复约和私教预约 -->
		<view class="home-action-card" wx:if="{{memberDashboardLoaded}}">
			<view wx:if="{{nextJoin}}" class="home-action-item" data-id="{{nextJoin.id}}" bindtap="bindNextJoinTap">
				<van-icon name="records" size="32rpx" color="{{themeColor}}" />
				<text class="home-action-label">最新预约</text>
				<text class="home-action-main text-cut">{{nextJoin.title}}</text>
				<text class="home-action-sub">{{nextJoin.timeStart}}–{{nextJoin.timeEnd}}</text>
			</view>
			<view wx:else class="home-action-item" bindtap="bindHomeBookingTap">
				<van-icon name="records" size="32rpx" color="{{themeColor}}" />
				<text class="home-action-label">最新预约</text>
				<text class="home-action-main">暂无预约</text>
				<text class="home-action-sub">去看看课程</text>
			</view>
			<view class="home-action-item" bindtap="bindHomeBookingTap">
				<van-icon name="replay" size="32rpx" color="{{themeColor}}" />
				<text class="home-action-label">再约一次</text>
				<text class="home-action-main">课程预约</text>
				<text class="home-action-sub">查看本周排课</text>
			</view>
			<view class="home-action-item" bindtap="bindPrivateBookingTap">
				<van-icon name="friends-o" size="32rpx" color="{{themeColor}}" />
				<text class="home-action-label">私教预约</text>
				<text class="home-action-main">一对一定制</text>
				<text class="home-action-sub">自选教练与时间</text>
			</view>
		</view>

		<view class="home-practice-card" wx:if="{{memberDashboardLoaded}}" bindtap="bindAchievementTap">
			<view>
				<text class="home-practice-title">练习进度</text>
				<text class="home-practice-sub">每一次来到垫上，都会成为积累</text>
			</view>
			<view class="home-practice-stats">
				<view><text>{{practiceProgress.totalClasses || 0}}</text><text>次上课</text></view>
				<view><text>{{practiceProgress.currentStreak || 0}}</text><text>周连续</text></view>
				<view><text>{{practiceProgress.badgeCount || 0}}</text><text>枚徽章</text></view>
			</view>
		</view>

		<!-- 金牌老师（横向滑动） -->
		<view class="home-section" wx:if="{{teachers.length > 0}}">
			<view class="section-head">
				<text class="section-title">金牌老师</text>
			</view>
			<scroll-view class="hscroll" scroll-x enhanced show-scrollbar="{{false}}">
				<view class="hscroll-inner">
					<view class="teacher-card" wx:for="{{teachers}}" wx:key="_id" bindtap="bindTeacherTap" data-id="{{item._id}}">
						<image class="teacher-cover" mode="aspectFill" src="{{item.cover || item.avatar}}" />
						<view class="teacher-name text-cut">{{item.name}}</view>
					</view>
				</view>
			</scroll-view>
		</view>

		<!-- 照片墙（相册横向滑动） -->
		<view class="home-section" wx:if="{{photoAlbums.length > 0}}">
			<view class="section-head">
				<text class="section-title">照片墙</text>
			</view>
			<scroll-view class="hscroll" scroll-x enhanced show-scrollbar="{{false}}">
				<view class="hscroll-inner">
					<view
						class="photo-album-card"
						wx:for="{{photoAlbums}}"
						wx:key="id"
						bindtap="bindHomeAlbumTap"
						data-index="{{index}}"
					>
						<view class="photo-album-thumbs photo-album-thumbs--{{item.thumbCount || 1}}">
							<block wx:if="{{item.thumbs.length}}">
								<image
									wx:for="{{item.thumbs}}"
									wx:for-item="thumb"
									wx:key="*this"
									lazy-load="{{true}}"
									class="photo-album-thumb"
									mode="aspectFill"
									src="{{thumb}}"
								/>
							</block>
							<view wx:else class="photo-album-thumb photo-album-thumb--empty">
								<van-icon name="photo-o" size="48rpx" color="#c8c9cc" />
							</view>
						</view>
						<view class="photo-title text-cut">{{item.title}}</view>
					</view>
				</view>
			</scroll-view>
		</view>

		<view class="home-safe-bottom"></view>
	</view>

	<block wx:if="{{skin.IS_SUB}}">
		<import src="../../tpls/public/menu_tpl.wxml" />
		<template is="menuTpl" data="{{skin,themeColor,curMenu:'home_index',returnHome}}" />
	</block>

</template>
