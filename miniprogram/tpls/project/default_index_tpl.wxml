<template name="defaultIndexTpl">

	<cmpt-tenant-switch title="首页" theme-color="{{themeColor}}" />

	<view class="home-page">

		<!-- 顶部文案横幅 -->
		<view
			class="home-editorial"
			bindtap="bindBannerTap"
			data-url="{{editorialLink}}"
			aria-role="button"
			aria-label="{{tenantName || '瑜伽馆'}}"
		>
			<image class="home-editorial-bg" mode="aspectFill" src="{{editorialCover}}" />
			<view class="home-editorial-copy">
				<text class="home-editorial-small">{{tenantName || '瑜伽馆'}} · 今天也为自己留一点时间</text>
				<text class="home-editorial-title">{{editorialTitle}}</text>
			</view>
		</view>

		<!-- 场馆卡 -->
		<view class="home-place" bindtap="bindStudioLocationTap" aria-role="button" aria-label="查看场馆位置">
			<view class="home-place-info">
				<text class="home-place-name text-cut">{{tenantName || '瑜伽馆'}}</text>
				<text class="home-place-addr text-cut" wx:if="{{studioAddress}}">{{studioAddress}}</text>
			</view>
			<text
				wx:if="{{openStatus}}"
				class="home-place-state {{openStatus.open ? '' : 'closed'}}"
			>{{openStatus.label}}{{openStatus.timeText ? ' · ' + openStatus.timeText : ''}}</text>
		</view>

		<!-- 下一节课 / 本周推荐 -->
		<block wx:if="{{memberDashboardLoaded}}">

			<view
				wx:if="{{nextJoin}}"
				class="home-next"
				bindtap="bindNextJoinTap"
				data-id="{{nextJoin.id}}"
				aria-role="button"
				aria-label="下一节课 {{nextJoin.title}}"
			>
				<view class="home-next-body">
					<text class="home-next-label">下一节课 · {{nextJoin.subText}}</text>
					<text class="home-next-title text-cut">{{nextJoin.title}}</text>
					<text class="home-next-sub">{{nextJoin.checkedIn ? '已签到' : '已预约'}} · 点击查看详情</text>
				</view>
				<view class="home-next-btn" catchtap="bindGoCourseTap" aria-role="button" aria-label="查看课程">查看课程</view>
				<view class="home-next-ring"></view>
			</view>

			<view wx:elif="{{recommendMeets.length > 0}}" class="home-week">
				<view class="home-section-head">
					<text class="home-section-title">本周推荐</text>
					<text class="home-section-more" bindtap="bindHomeBookingTap" aria-role="button" aria-label="查看全部课程">查看全部 ›</text>
				</view>
				<scroll-view class="home-suggest" scroll-x enhanced show-scrollbar="{{false}}">
					<view class="home-suggest-inner">
						<view
							class="class-mini {{index % 3 === 1 ? 'alt-a' : (index % 3 === 2 ? 'alt-b' : '')}}"
							wx:for="{{recommendMeets}}"
							wx:key="index"
							bindtap="bindRecommendTap"
							data-id="{{item.meetId}}"
							data-type="{{item.type}}"
							aria-role="button"
							aria-label="{{item.title}}"
						>
							<image class="class-mini-bg" mode="aspectFill" src="{{item.cover}}" lazy-load="{{true}}" />
							<view class="class-mini-shade"></view>
							<text class="class-mini-when">{{item.smallText}}</text>
							<text class="class-mini-name text-cut">{{item.title}}</text>
							<text class="class-mini-sub text-cut" wx:if="{{item.spanText}}">{{item.spanText}}</text>
						</view>
					</view>
				</scroll-view>
			</view>

			<view wx:else class="home-week">
				<view class="home-section-head">
					<text class="home-section-title">本周推荐</text>
					<text class="home-section-more" bindtap="bindHomeBookingTap" aria-role="button" aria-label="查看全部课程">查看全部 ›</text>
				</view>
				<view class="class-mini home-private-fallback" bindtap="bindPrivateBookingTap" aria-role="button" aria-label="私教预约">
					<text class="class-mini-when">私教体验</text>
					<text class="class-mini-name">一对一定制</text>
					<text class="class-mini-sub">自选教练与时间 ›</text>
				</view>
			</view>

			<!-- 下一枚成就进度环 -->
			<view wx:if="{{practiceProgress.nextAchievement}}" class="home-ring-card" bindtap="bindAchievementTap" aria-role="button" aria-label="查看我的成就">
				<view class="home-ring" style="background:conic-gradient(var(--projectColor, #6fae96) 0deg {{homeRingDeg}}deg, var(--projectColorLight, #d5e7dc) {{homeRingDeg}}deg 360deg);">
					<view class="home-ring-center">
						<text>{{practiceProgress.nextAchievement.progress || 0}} / {{practiceProgress.nextAchievement.target}}</text>
					</view>
				</view>
				<view class="home-ring-info">
					<text class="home-ring-title">{{practiceProgress.nextAchievement.name}}</text>
					<text class="home-ring-sub">{{practiceProgress.nextAchievement.unlockHint}}</text>
				</view>
				<text class="home-ring-more">成就 ›</text>
			</view>
		</block>

		<!-- 公告 -->
		<view class="home-notice" wx:if="{{announcements.length}}">
			<view class="home-notice-dot"></view>
			<swiper class="home-notice-swiper" vertical circular autoplay="{{announcements.length > 1}}" interval="4200" duration="650">
				<swiper-item wx:for="{{announcements}}" wx:key="_id">
					<view class="home-notice-row" bindtap="bindAnnounceTap" data-id="{{item._id}}" aria-role="button" aria-label="公告 {{item.title}}">
						<text class="home-notice-text text-cut">{{item.title}}</text>
						<text class="home-notice-time" wx:if="{{item.publishAgo}}">{{item.publishAgo}}</text>
					</view>
				</swiper-item>
			</swiper>
			<text class="home-notice-arrow">›</text>
		</view>

		<!-- 馆内时光 -->
		<view class="home-community" wx:if="{{teachers.length > 0 || photoAlbumsTop.length > 0}}">
			<view class="home-section-head">
				<text class="home-section-title">馆内时光</text>
				<view class="home-section-actions">
					<text
						wx:if="{{teachers.length > 1}}"
						class="home-section-more"
						bindtap="bindTeacherMoreTap"
						aria-role="button"
						aria-label="更多老师"
					>更多老师 ›</text>
					<text
						wx:if="{{photoAlbumsTop.length > 0}}"
						class="home-section-more"
						bindtap="bindPhotoWallTap"
						aria-role="button"
						aria-label="更多相册"
					>更多相册 ›</text>
				</view>
			</view>
			<view class="home-merged {{photoAlbumsTop.length === 0 ? 'only-teacher' : ''}} {{teachers.length === 0 ? 'only-album' : ''}}">

				<view class="merged-teacher" wx:if="{{teachers.length > 0}}">
					<swiper
						class="merged-teacher-swiper"
						circular
						autoplay
						interval="4000"
						duration="500"
						current="{{teacherCurrent}}"
						bindchange="bindTeacherSwiperChange"
					>
						<swiper-item
							wx:for="{{teachers}}"
							wx:key="_id"
							bindtap="bindTeacherTap"
							data-id="{{item._id}}"
							aria-role="button"
							aria-label="教练 {{item.name}}"
						>
							<view class="merged-teacher-card">
								<image class="merged-teacher-bg" mode="aspectFill" src="{{item.cover || item.avatar}}" lazy-load="{{index > 0}}" />
								<view class="merged-teacher-shade"></view>
								<text class="merged-teacher-label">金牌老师</text>
								<text class="merged-teacher-name text-cut">{{item.name}}</text>
							</view>
						</swiper-item>
					</swiper>
					<view class="merged-teacher-dots" wx:if="{{teachers.length > 1}}">
						<view
							class="merged-teacher-dot {{teacherCurrent === idx ? 'active' : ''}}"
							wx:for="{{teachers}}"
							wx:for-index="idx"
							wx:key="_id"
						></view>
					</view>
				</view>

				<view class="merged-albums" wx:if="{{photoAlbumsTop.length > 0}}">
					<view
						class="merged-album {{item.ready ? 'is-ready' : ''}} {{index === 1 ? 'alt' : ''}}"
						wx:for="{{photoAlbumsTop}}"
						wx:key="id"
						bindtap="bindHomeAlbumTap"
						data-index="{{index}}"
						aria-role="button"
						aria-label="相册 {{item.title}}"
					>
						<image class="merged-album-layer {{item.front === 'a' ? 'is-front' : ''}}" mode="aspectFill" src="{{item.bufA || item.thumbs[0]}}" fade-in="{{false}}" bindload="bindAlbumImageLoad" binderror="bindAlbumImageError" data-album-index="{{index}}" data-layer="a" data-pic="{{item.bufA || item.thumbs[0]}}" />
						<image wx:if="{{item.bufB}}" class="merged-album-layer {{item.front === 'b' ? 'is-front' : ''}}" mode="aspectFill" src="{{item.bufB}}" lazy-load="{{true}}" fade-in="{{false}}" bindload="bindAlbumImageLoad" binderror="bindAlbumImageError" data-album-index="{{index}}" data-layer="b" data-pic="{{item.bufB}}" />
						<view class="merged-album-memory"></view>
						<view class="merged-album-shade"></view>
						<text class="merged-album-name text-cut">{{item.title}}</text>
						<text class="merged-album-count">{{item.count}} 张回忆</text>
					</view>
				</view>

			</view>
		</view>

		<view class="home-safe-bottom"></view>
	</view>

	<block wx:if="{{skin.IS_SUB}}">
		<import src="../../tpls/public/menu_tpl.wxml" />
		<template is="menuTpl" data="{{skin,themeColor,curMenu:'home_index',returnHome}}" />
	</block>

</template>
