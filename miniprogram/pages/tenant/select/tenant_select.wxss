/* [AI_START TIMESTAMP=2025-01-25 19:10:00] */
.tenant-select {
  padding: 20rpx;
  min-height: 100vh;
  background: #f6f7f5;
}

.tenant-expired-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #646a73;
}

.tenant-empty {
  padding: 40rpx 0 80rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.tenant-list {
  padding-bottom: 40rpx;
}

.tenant-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid transparent;
}

.tenant-card--current {
  border-color: var(--themeColor, #6fae96);
}

.tenant-current-badge {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.6;
  color: var(--themeColor, #6fae96);
  background: var(--themeColorLight, #f0f5f1);
  border-radius: 8rpx;
  vertical-align: middle;
}

.tenant-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--themeColorLight, #f0f5f1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.tenant-logo--default {
  background: var(--themeColor, #6fae96);
}

.tenant-logo-icon {
  font-size: 60rpx !important;
  line-height: 1;
}

.logo-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.tenant-info {
  flex: 1;
  margin-left: 24rpx;
}

.tenant-name {
  font-weight: bold;
  color: var(--neutralText, #1f2329);
}

.tenant-desc {
  margin-top: 8rpx;
  color: var(--neutralTextSecondary, #646a73);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tenant-arrow-icon {
  opacity: 0.45;
}

.tenant-arrow {
  flex-shrink: 0;
  padding-left: 10rpx;
}
