@import "../../../style/project/base/appt.wxss";
@import "../skin/skin.wxss";
@import "../../../style/project/default_index_base.wxss";

.home-page {
  background: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* ---- 顶部横幅 ---- */

.home-hero {
  position: relative;
  background: #fff;
}

.home-banner,
.home-banner-fallback {
  width: 100%;
  height: 300rpx;
  overflow: hidden;
}

.banner-swiper,
.banner-item,
.banner-media,
.home-banner-fallback image {
  width: 100%;
  height: 300rpx;
}

.banner-item {
  position: relative;
}

/* ---- 场馆信息卡 ---- */

.home-studio-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin: -36rpx 24rpx 0;
  padding: 30rpx 28rpx 24rpx;
  position: relative;
  z-index: 2;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 32rpx rgba(31, 35, 41, 0.07);
}

.home-studio-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.home-studio-info {
  flex: 1;
  min-width: 0;
}

.home-studio-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.home-studio-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.home-open-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
}

.home-open-badge.is-open {
  color: var(--projectColor, #6fae96);
  background: var(--projectColorLight, #edf5f0);
}

.home-open-badge.is-closed {
  color: #8a8e86;
  background: #f2f1ed;
}

.home-open-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.home-studio-addr {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  min-width: 0;
  color: #9a9d96;
  font-size: 21rpx;
}

.home-studio-addr text {
  flex: 1;
  min-width: 0;
}

.home-studio-divider {
  width: 1rpx;
  height: 48rpx;
  margin: 0 20rpx;
  background: #eeece7;
}

.home-studio-phone {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--projectColorLight, #edf5f0);
  border-radius: 18rpx;
  flex-shrink: 0;
}

.home-studio-phone:active {
  opacity: 0.7;
}

/* ---- 场馆内公告 ---- */

.home-studio-announce {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0eee9;
  color: #73776f;
}

.home-studio-announce-title {
  flex: 1;
  min-width: 0;
  display: block;
  color: #596057;
  font-size: 23rpx;
}
.home-studio-announce-time {
  flex-shrink: 0;
  color: #a4aaa3;
  font-size: 20rpx;
  white-space: nowrap;
}

.home-announce-swiper {
  flex: 1;
  min-width: 0;
  height: 40rpx;
}

.home-announce-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 40rpx;
}

/* ---- 快捷功能 ---- */

.home-action-card {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
}

.home-action-item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
  box-sizing: border-box;
}

.home-action-item:active {
  opacity: 0.85;
}

.home-action-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f4f1ea;
}

.home-action-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.home-action-label {
  color: #a8ab9f;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.home-action-main {
  width: 100%;
  margin-top: 6rpx;
  color: #39483d;
  font-size: 26rpx;
  font-weight: 600;
}

.home-action-sub {
  width: 100%;
  margin-top: 4rpx;
  color: #9a9d96;
  font-size: 20rpx;
}

/* ---- 练习进度 ---- */

.home-practice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  background: #fcfbf7;
}
.home-practice-card {
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
}
.home-practice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #425448;
}
.home-practice-sub {
  display: block;
  margin-top: 8rpx;
  color: #94978f;
  font-size: 21rpx;
}
.home-practice-stats {
  display: flex;
  flex-shrink: 0;
  gap: 18rpx;
}
.home-practice-stats view {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.home-practice-stats text:first-child {
  color: var(--projectColor, #6fae96);
  font-size: 31rpx;
  font-weight: 700;
}
.home-practice-stats text:last-child {
  margin-top: 2rpx;
  color: #999d95;
  font-size: 19rpx;
}
.home-practice-teaser {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 28rpx;
  background: #fcfbf7;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
}
.home-practice-teaser-text {
  flex: 1;
  min-width: 0;
}
.home-practice-teaser-main {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #425448;
}
.home-practice-teaser-sub {
  display: block;
  margin-top: 4rpx;
  color: #94978f;
  font-size: 21rpx;
}

/* ---- 板块 ---- */

.home-section {
  margin: 32rpx 0 0;
  padding: 0 0 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-more {
  color: #8a958c;
  font-size: 23rpx;
}

/* ---- 横向滚动通用 ---- */

.hscroll {
  width: 100%;
}

.hscroll-inner {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 24rpx 12rpx;
}

/* ---- 金牌老师 ---- */

.teacher-card {
  position: relative;
  width: 258rpx;
  height: 340rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #dfe6df;
  box-shadow: 0 10rpx 28rpx rgba(31, 35, 41, 0.13);
  flex-shrink: 0;
}

.teacher-card:active {
  opacity: 0.88;
}

.teacher-cover {
  width: 100%;
  height: 100%;
  background: #e8ece8;
}

.teacher-shade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 55%;
  background: linear-gradient(transparent, rgba(17, 29, 23, 0.78));
}

.teacher-info {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  left: 22rpx;
}

.teacher-name,
.teacher-specialty {
  display: block;
  color: #fff;
}

.teacher-name {
  font-size: 31rpx;
  font-weight: 700;
}

.teacher-specialty {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
}

/* ---- 照片墙（相册） ---- */

.photo-album-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  overflow: hidden;
  padding: 0;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.08);
  flex-shrink: 0;
}

.photo-album-card:active {
  opacity: 0.88;
}

.photo-album-thumbs {
  width: 280rpx;
  height: 186rpx;
  border-radius: 0;
  overflow: hidden;
  display: grid;
  gap: 4rpx;
  background: #f0f1f3;
}

.photo-album-thumbs--1 {
  grid-template-columns: 1fr;
  grid-template-rows: 1fr;
}

.photo-album-thumbs--2 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr;
}

.photo-album-thumbs--3 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.photo-album-thumbs--3 .photo-album-thumb:first-child {
  grid-row: span 2;
}

.photo-album-thumbs--4 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.photo-album-thumb {
  width: 100%;
  height: 100%;
  min-height: 0;
  background: #f0f1f3;
}

.photo-album-thumb--empty {
  grid-column: 1 / -1;
  grid-row: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-album-meta {
  padding: 17rpx 18rpx 18rpx;
}

.photo-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.photo-count {
  display: block;
  margin-top: 7rpx;
  color: #929991;
  font-size: 20rpx;
}

.home-safe-bottom {
  /* 为固定底部导航留出完整空间，避免最后一排照片被遮住 */
  height: 160rpx;
}

.menu .item {
  width: 50%;
}
