/* ===== 首页 · member-core 版式 ===== */

page {
  background: var(--neutralBg, #f5f6f8);
}

.home-page {
  min-height: 100vh;
  padding: 0 36rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---- 顶部文案横幅 ---- */
.home-editorial {
  position: relative;
  height: 456rpx;
  margin: 0 -36rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(145deg, var(--projectColor, #527868), var(--projectColorDark, #2c4a3d));
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.32);
}

.home-editorial-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-editorial-copy {
  position: absolute;
  z-index: 1;
  left: 40rpx;
  right: 40rpx;
  bottom: 46rpx;
}

.home-editorial-small {
  display: block;
  font-size: 22rpx;
  opacity: 0.86;
}

.home-editorial-title {
  display: block;
  margin-top: 12rpx;
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

/* ---- 场馆卡 ---- */
.home-place {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin: -32rpx 0 28rpx;
  padding: 28rpx 30rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 48rpx rgba(43, 68, 56, 0.11);
}

.home-place-info {
  flex: 1;
  min-width: 0;
}

.home-place-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--neutralText, #1f2329);
}

.home-place-addr {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--neutralTextTertiary, #8f959e);
}

.home-place-state {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: var(--projectColorLight, #edf5f0);
  color: var(--projectColorDark, #4f8c76);
  font-size: 20rpx;
  font-weight: 700;
}

.home-place-state.closed {
  background: #f0f1ef;
  color: #89918c;
}

/* ---- 通用 section 头 ---- */
.home-section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 0 2rpx 20rpx;
}

.home-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--neutralText, #1f2329);
}

.home-section-actions {
  display: flex;
  align-items: baseline;
  gap: 28rpx;
}

.home-section-more {
  font-size: 24rpx;
  color: var(--projectColorDark, #4f8c76);
}

/* ---- 下一节课 ---- */
.home-next {
  position: relative;
  overflow: hidden;
  padding: 36rpx;
  border-radius: 40rpx;
  color: #ffffff;
  background: linear-gradient(145deg, var(--projectColor, #6fae96), var(--projectColorDark, #4f8c76));
  box-shadow: 0 12rpx 32rpx rgba(43, 68, 56, 0.16);
}

.home-next-ring {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  right: -110rpx;
  bottom: -184rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  box-shadow: 0 0 0 44rpx rgba(255, 255, 255, 0.08);
}

.home-next-body {
  position: relative;
  z-index: 1;
}

.home-next-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.8;
}

.home-next-title {
  display: block;
  margin: 36rpx 0 8rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.home-next-sub {
  display: block;
  font-size: 22rpx;
  opacity: 0.82;
}

.home-next-btn {
  position: absolute;
  z-index: 2;
  right: 34rpx;
  bottom: 34rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: var(--projectColorDark, #4f8c76);
  font-size: 22rpx;
  font-weight: 700;
}

.home-next-btn:active {
  opacity: 0.85;
}

/* ---- 本周推荐 ---- */
.home-week {
  margin: 28rpx 0 24rpx;
}

.home-week .home-section-head {
  margin-bottom: 20rpx;
}

.home-suggest {
  width: 100%;
  white-space: nowrap;
}

.home-suggest-inner {
  display: inline-flex;
  gap: 22rpx;
  padding-bottom: 8rpx;
}

.class-mini {
  position: relative;
  flex-shrink: 0;
  width: 300rpx;
  height: 250rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(145deg, #7aa58f, #477966);
}

.class-mini.alt-a {
  background: linear-gradient(145deg, #c99c72, #9a674f);
}

.class-mini.alt-b {
  background: linear-gradient(145deg, #768fb0, #536b91);
}

.class-mini:active {
  opacity: 0.92;
}

.class-mini-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.class-mini-shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0) 46%,
    rgba(18, 30, 26, 0.44) 100%
  );
}

.class-mini-when {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 20rpx;
  opacity: 0.82;
}

.class-mini-name {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 82rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.class-mini-sub {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  opacity: 0.85;
}

/* ---- 下一枚成就进度环 ---- */
.home-ring-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 30rpx 0;
  min-height: 156rpx;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: #fcfbf7;
  border: 2rpx solid #eee9df;
}

.home-ring-card:active {
  background: #f7f5ee;
}

.home-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 50%;
  box-sizing: border-box;
}

.home-ring-center {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #fcfbf7;
  color: var(--projectColorDark, #4f8c76);
  font-size: 24rpx;
  font-weight: 800;
}

.home-ring-info {
  flex: 1;
  min-width: 0;
}

.home-ring-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--neutralText, #1f2329);
}

.home-ring-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7d8981;
  line-height: 1.4;
}

.home-ring-more {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--projectColorDark, #4f8c76);
}

/* ---- 公告 ---- */
.home-notice {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 10rpx 4rpx 36rpx;
  color: #657269;
  font-size: 22rpx;
}

.home-notice-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #dd9168;
}

.home-notice-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-notice-swiper {
  flex: 1;
  min-width: 0;
  height: 42rpx;
}

.home-notice-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  height: 42rpx;
}

.home-notice-time {
  flex-shrink: 0;
  color: #919c94;
  font-size: 19rpx;
}

.home-notice-arrow {
  flex-shrink: 0;
  color: #9aa49d;
}

/* ---- 馆内时光 ---- */
.home-community {
  margin-top: 16rpx;
}

.home-community .home-section-head {
  margin-bottom: 26rpx;
}

.home-merged {
  display: flex;
  gap: 18rpx;
  height: 320rpx;
}

.merged-teacher {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 100%;
  border-radius: 34rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #b3aca0, #8a8175);
}

.home-merged.only-teacher .merged-teacher {
  flex: 1;
}

.merged-teacher-swiper {
  width: 100%;
  height: 100%;
}

.merged-teacher-card {
  position: relative;
  width: 100%;
  height: 100%;
}

.merged-teacher-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-position: center 32%;
}

.merged-teacher-shade {
  position: absolute;
  inset: 40% 0 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.54));
}

.merged-teacher-label {
  position: absolute;
  z-index: 1;
  left: 26rpx;
  top: 24rpx;
  font-size: 20rpx;
  color: #ffffff;
  opacity: 0.88;
}

.merged-teacher-name {
  position: absolute;
  z-index: 1;
  left: 26rpx;
  right: 26rpx;
  bottom: 58rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.merged-teacher-dots {
  position: absolute;
  z-index: 2;
  right: 24rpx;
  bottom: 26rpx;
  display: flex;
  gap: 8rpx;
}

.merged-teacher-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}

.merged-teacher-dot.active {
  width: 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.merged-albums {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.home-merged.only-album .merged-albums {
  flex: 1;
}

.merged-album {
  position: relative;
  flex: 1;
  min-height: 134rpx;
  border-radius: 28rpx;
  overflow: hidden;
  opacity: 0;
  color: #ffffff;
  background: linear-gradient(
    135deg,
    #d3bea2 0 48%,
    #a39a8b 48% 55%,
    #9ab2b3 55%
  );
  transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

.merged-album.alt {
  background: linear-gradient(
    135deg,
    #778fa9 0 48%,
    #e0d7be 48% 55%,
    #b17c6e 55%
  );
}

.merged-album.is-ready {
  opacity: 1;
}

.merged-album.is-ready:active {
  opacity: 0.92;
}

/*
 * 回忆式交叉淡化：新图先在不可见层完成预载，再用长交叠与极轻微推近接替旧图。
 * 过渡只发生在相册局部，不影响首页滚动与点击响应。
 */
.merged-album-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transform: scale(1);
  filter: saturate(0.9) brightness(0.94);
  transition:
    opacity 1.8s cubic-bezier(0.16, 1, 0.3, 1),
    transform 8.4s linear,
    filter 1.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.merged-album-layer.is-front {
  opacity: 1;
  transform: scale(1.055);
  filter: saturate(1) brightness(1);
}

.merged-album-memory {
  position: absolute;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    135deg,
    rgba(255, 244, 226, 0.1),
    transparent 52%,
    rgba(89, 72, 102, 0.08)
  );
}

.merged-album-shade {
  position: absolute;
  z-index: 2;
  inset: 38% 0 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.45));
}

.merged-album-name {
  position: absolute;
  z-index: 3;
  left: 20rpx;
  right: 20rpx;
  bottom: 46rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.merged-album-count {
  position: absolute;
  z-index: 3;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
  font-size: 16rpx;
  opacity: 0.88;
}

/* ---- 底部安全区 ---- */
.home-safe-bottom {
  height: 40rpx;
}
