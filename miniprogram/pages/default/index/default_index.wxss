@import "../../../style/project/base/appt.wxss";
@import "../skin/skin.wxss";
@import "../../../style/project/default_index_base.wxss";

.home-page {
  background: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* ---- 顶部横幅 ---- */

.home-hero {
  position: relative;
  background: #fff;
}

.home-banner,
.home-banner-fallback {
  width: 100%;
  height: 300rpx;
  overflow: hidden;
}

.banner-swiper,
.banner-item,
.banner-media,
.home-banner-fallback image {
  width: 100%;
  height: 300rpx;
}

.banner-item {
  position: relative;
}

/* ---- 场馆信息卡 ---- */

.home-studio-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin: -36rpx 24rpx 0;
  padding: 30rpx 28rpx 24rpx;
  position: relative;
  z-index: 2;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 32rpx rgba(31, 35, 41, 0.07);
}

.home-studio-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.home-studio-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.home-studio-divider {
  width: 1rpx;
  height: 48rpx;
  margin: 0 20rpx;
  background: #eeece7;
}

.home-studio-phone {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--projectColorLight, #edf5f0);
  border-radius: 18rpx;
  flex-shrink: 0;
}

.home-studio-phone:active {
  opacity: 0.7;
}

/* ---- 场馆内公告 ---- */

.home-studio-announce {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0eee9;
  color: #73776f;
}

.home-studio-announce-title {
  flex: 1;
  min-width: 0;
  display: block;
  color: #596057;
  font-size: 23rpx;
}

.home-studio-announce:active {
  opacity: 0.85;
}

/* ---- 快捷功能 ---- */

.home-action-card {
  display: flex;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
}

.home-action-item {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 12rpx;
  text-align: center;
}

.home-action-item + .home-action-item::before {
  content: '';
  position: absolute;
  top: 12rpx;
  bottom: 12rpx;
  left: 0;
  width: 1rpx;
  background: #efede8;
}

.home-action-label {
  display: block;
  margin-top: 10rpx;
  color: #747a72;
  font-size: 21rpx;
}

.home-action-main {
  display: block;
  width: 100%;
  margin-top: 8rpx;
  color: #39483d;
  font-size: 24rpx;
  font-weight: 600;
}

.home-action-sub {
  display: block;
  width: 100%;
  margin-top: 6rpx;
  color: #9a9d96;
  font-size: 19rpx;
  white-space: nowrap;
}

/* ---- 练习进度 ---- */

.home-practice-card { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin:20rpx 24rpx 0; background: #fcfbf7; }
.home-practice-card { padding: 28rpx; border-radius: 20rpx; box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06); }
.home-practice-title { font-size: 26rpx; font-weight: 600; color: #425448; }
.home-practice-sub { display: block; margin-top: 8rpx; color: #94978f; font-size: 21rpx; }
.home-practice-stats { display: flex; flex-shrink: 0; gap: 18rpx; }
.home-practice-stats view { display: flex; flex-direction: column; align-items: center; }
.home-practice-stats text:first-child { color: var(--projectColor, #6fae96); font-size: 31rpx; font-weight: 700; }
.home-practice-stats text:last-child { margin-top: 2rpx; color: #999d95; font-size: 19rpx; }

/* ---- 板块 ---- */

.home-section {
  margin: 32rpx 0 0;
  padding: 0 0 8rpx;
}

.section-head {
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* ---- 横向滚动通用 ---- */

.hscroll {
  width: 100%;
}

.hscroll-inner {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 24rpx 12rpx;
}

/* ---- 金牌老师 ---- */

.teacher-card {
  display: inline-flex;
  flex-direction: column;
  width: 220rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.06);
  flex-shrink: 0;
}

.teacher-card:active {
  opacity: 0.88;
}

.teacher-cover {
  width: 188rpx;
  height: 188rpx;
  border-radius: 12rpx;
  background: #f0f1f3;
}

.teacher-name {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}

/* ---- 照片墙（相册） ---- */

.photo-album-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.06);
  flex-shrink: 0;
}

.photo-album-card:active {
  opacity: 0.88;
}

.photo-album-thumbs {
  width: 248rpx;
  height: 186rpx;
  border-radius: 12rpx;
  overflow: hidden;
  display: grid;
  gap: 4rpx;
  background: #f0f1f3;
}

.photo-album-thumbs--1 {
  grid-template-columns: 1fr;
  grid-template-rows: 1fr;
}

.photo-album-thumbs--2 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr;
}

.photo-album-thumbs--3 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.photo-album-thumbs--3 .photo-album-thumb:first-child {
  grid-row: span 2;
}

.photo-album-thumbs--4 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.photo-album-thumb {
  width: 100%;
  height: 100%;
  min-height: 0;
  background: #f0f1f3;
}

.photo-album-thumb--empty {
  grid-column: 1 / -1;
  grid-row: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-title {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}

.home-safe-bottom {
  /* 为固定底部导航留出完整空间，避免最后一排照片被遮住 */
  height: 160rpx;
}

.menu .item {
  width: 50%;
}
