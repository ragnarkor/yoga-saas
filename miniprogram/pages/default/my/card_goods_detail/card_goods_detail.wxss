.detail {
  min-height: 100vh;
  background: #f5f6f8;
  /* 底部留白，避免内容被吸底购买栏遮挡 */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  min-height: 50vh;
  box-sizing: border-box;
}

/* ============ 卡面大图 ============ */
.detail-hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  height: 320rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  color: #fff;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.detail-hero-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  line-height: 1.4;
}

.detail-hero-name {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.detail-hero-vip {
  margin-top: 10rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  opacity: 0.75;
}

/* ============ 白卡片 ============ */
.detail-card {
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.detail-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 20rpx;
}

/* ============ 价格区 ============ */
.detail-price-card {
  padding: 30rpx 28rpx;
}

.detail-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.detail-price-cur {
  font-size: 30rpx;
  font-weight: 600;
}

.detail-price {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.1;
}

.detail-price-origin {
  font-size: 26rpx;
  color: #c8c9cc;
  text-decoration: line-through;
}

.detail-price-off {
  margin-left: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  align-self: center;
}

.detail-price-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #969799;
}

/* ============ 权益行 ============ */
.detail-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
}

.detail-row-label {
  font-size: 27rpx;
  color: #969799;
  width: 140rpx;
  flex-shrink: 0;
}

.detail-row-value {
  flex: 1;
  font-size: 27rpx;
  color: #323233;
  text-align: right;
}

/* ============ 说明文案 ============ */
.detail-desc {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.7;
}

.detail-desc--sub {
  margin-top: 10rpx;
  color: #969799;
  font-size: 24rpx;
}

/* ============ 吸底购买栏 ============ */
.detail-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.detail-bar-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.detail-bar-cur {
  font-size: 28rpx;
  font-weight: 600;
}

.detail-bar-num {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
}

.detail-bar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  height: 88rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.detail-bar-btn:active {
  opacity: 0.92;
}
