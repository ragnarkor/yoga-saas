.detail {
  min-height: 100vh;
  background: var(--projectBgSoft, #fafbf9);
  /* 底部留白，避免内容被吸底购买栏遮挡 */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.detail-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  min-height: 50vh;
  box-sizing: border-box;
}

/* ============ 卡面大图 ============ */
.detail-hero {
  position: relative;
  margin: 24rpx 28rpx 0;
  height: 320rpx;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  color: #fff;
  box-shadow: 0 16rpx 36rpx rgba(43, 63, 52, 0.18);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* 封面图上的暗化层，保证白字对比度 */
.detail-hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(115deg, rgba(9, 26, 17, 0.42), rgba(9, 26, 17, 0.06) 57%, rgba(9, 26, 17, 0.22));
}

/* 装饰同心圆 */
.detail-hero-ring {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  z-index: 0;
}

.detail-hero-ring--lg {
  width: 380rpx;
  height: 380rpx;
  right: -110rpx;
  top: -150rpx;
}

.detail-hero-ring--sm {
  width: 230rpx;
  height: 230rpx;
  right: -20rpx;
  top: -120rpx;
}

.detail-hero-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 1;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  line-height: 1.4;
}

.detail-hero-name {
  position: relative;
  z-index: 1;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}

.detail-hero-vip {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  opacity: 0.78;
}

/* ============ 白卡片 ============ */
.detail-card {
  margin: 24rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(43, 63, 52, 0.06);
}

.detail-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f3d35;
  margin-bottom: 20rpx;
}

/* ============ 价格区 ============ */
.detail-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.detail-price-cur {
  font-size: 30rpx;
  font-weight: 700;
}

.detail-price {
  font-size: 60rpx;
  font-weight: 800;
  line-height: 1.1;
}

.detail-price-origin {
  font-size: 26rpx;
  color: #9ba59f;
  text-decoration: line-through;
}

.detail-price-off {
  margin-left: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  align-self: center;
}

.detail-price-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #6b7a70;
}

.detail-divider {
  height: 1rpx;
  margin: 22rpx 0 6rpx;
  background: rgba(63, 78, 68, 0.08);
}

/* ============ 权益行 ============ */
.detail-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 0;
}

.detail-row + .detail-row {
  border-top: 1rpx solid rgba(63, 78, 68, 0.07);
}

.detail-row-label {
  font-size: 27rpx;
  color: #7a867f;
  width: 140rpx;
  flex-shrink: 0;
}

.detail-row-value {
  flex: 1;
  font-size: 27rpx;
  color: #2f3d35;
  text-align: right;
}

/* ============ 购买流程三步 ============ */
.detail-steps {
  display: flex;
  align-items: flex-start;
  padding-top: 6rpx;
}

.detail-step {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  text-align: center;
}

.detail-step-no {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: var(--themeColor, #5b8a72);
  font-size: 24rpx;
  font-weight: 700;
}

.detail-step-name {
  color: #2f3d35;
  font-size: 25rpx;
  font-weight: 600;
}

.detail-step-desc {
  color: #7a867f;
  font-size: 22rpx;
  line-height: 1.5;
}

.detail-step-arrow {
  flex-shrink: 0;
  padding: 12rpx 2rpx 0;
}

/* ============ 说明文案 ============ */
.detail-desc {
  font-size: 26rpx;
  color: #5c6a61;
  line-height: 1.7;
}

.detail-desc--sub {
  margin-top: 10rpx;
  color: #8b958e;
  font-size: 24rpx;
}

/* ============ 吸底购买栏 ============ */
.detail-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 20rpx rgba(43, 63, 52, 0.08);
}

.detail-bar-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.detail-bar-cur {
  font-size: 28rpx;
  font-weight: 700;
}

.detail-bar-num {
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.1;
}

.detail-bar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  height: 88rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  transition: filter 0.2s ease;
}

.detail-bar-btn:active {
  filter: brightness(0.92);
}
