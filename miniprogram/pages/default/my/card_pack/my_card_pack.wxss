@import "../../skin/skin.wxss";

.card-pack-page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: var(--projectBgSoft, #fafbf9);
  box-sizing: border-box;
}

.card-pack-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 28rpx 0;
}

.card-pack-intro-count {
  color: #8b958e;
  font-size: 22rpx;
}

.card-pack-intro-links {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.card-pack-order-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 0;
  color: var(--themeColor, #5b8a72);
  font-size: 22rpx;
  line-height: 1.6;
}

.card-pack-order-arrow {
  font-size: 30rpx;
  line-height: 1;
}

/* 失效卡筛选胶囊：表达“切换列表口径”，与右侧“购卡订单”这类跳转链接在视觉语言上区分 */
.card-pack-status-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(152, 160, 153, 0.4);
  color: #7c8680;
  font-size: 22rpx;
  line-height: 1.6;
}

.card-pack-status-chip.is-active {
  border-color: var(--themeColorLight, #dbe8e1);
  background: var(--themeColorLight, #dbe8e1);
  color: #4a5c52;
  font-weight: 600;
}

.card-pack-chip--press {
  opacity: 0.82;
}

.chip-back {
  font-size: 26rpx;
  line-height: 1;
}

.card-pack-link-divider {
  width: 1rpx;
  height: 24rpx;
  background: rgba(63, 78, 68, 0.16);
}

.card-pack-order-link:active,
.card-pack-item:active,
.card-pack-buy:active {
  opacity: 0.84;
}

.card-pack-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
  padding: 120rpx 32rpx;
  box-sizing: border-box;
}

.card-pack-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 16rpx 28rpx;
}

.card-pack-item {
  position: relative;
  height: 388rpx;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 28rpx;
  color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
  box-shadow: 0 16rpx 36rpx rgba(43, 63, 52, 0.18);
  box-sizing: border-box;
}

.card-pack-cover {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
}

.card-pack-shade {
  position: absolute;
  z-index: 1;
  inset: 0;
  background: linear-gradient(115deg, rgba(9, 26, 17, 0.42), rgba(9, 26, 17, 0.06) 57%, rgba(255, 255, 255, 0.07));
}

.card-pack-top,
.card-pack-name-row,
.card-pack-name,
.card-pack-sub,
.card-pack-bottom {
  position: relative;
  z-index: 2;
}

.card-pack-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-pack-brand {
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
  opacity: 0.92;
}

.card-pack-badge {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.32);
  font-size: 20rpx;
}

.card-pack-name-row {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  margin-top: 48rpx;
}

.card-pack-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-pack-more {
  flex-shrink: 0;
  padding: 0 4rpx 4rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.card-pack-sub {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-pack-bottom {
  position: absolute;
  right: 30rpx;
  bottom: 26rpx;
  left: 30rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.card-pack-meta-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.85;
}

.card-pack-main-value {
  display: block;
  margin-top: 5rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.card-pack-expire {
  min-width: 176rpx;
  text-align: right;
}

.card-pack-expire-value {
  display: block;
  margin-top: 7rpx;
  font-size: 24rpx;
}

.card-pack-item.is-invalid {
  filter: saturate(0.28);
}

.card-pack-item.is-invalid .card-pack-shade {
  background-color: rgba(25, 31, 28, 0.4);
}

.card-pack-buy-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(63, 78, 68, 0.08);
  background: rgba(250, 251, 249, 0.94);
  box-shadow: 0 -4rpx 20rpx rgba(43, 63, 52, 0.05);
  backdrop-filter: blur(16rpx);
  box-sizing: border-box;
}

.card-pack-buy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  border-radius: 18rpx;
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}

/* —— 去约课反链：列表底部的单行白色行动条，与卡区之间用分割线分隔 —— */
.card-pack-divider {
  height: 1rpx;
  margin: 12rpx 32rpx 24rpx;
  background: rgba(63, 78, 68, 0.12);
}

.go-booking {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 28rpx 28rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(31, 35, 41, 0.06);
}

.go-booking--active {
  opacity: 0.88;
}

.go-booking-ico {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--themeColorLight, #dbe8e1);
}

.go-booking-cover {
  width: 100%;
  height: 100%;
}
/* 卡类型徽标：封面与渐变卡面上都叠加展示（次卡/期限卡） */
.go-booking-ico-type {
  position: absolute;
  left: 8rpx;
  bottom: 6rpx;
  z-index: 1;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.18);
  color: rgba(255, 255, 255, 0.95);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.4;
}

.go-booking-body {
  flex: 1;
  min-width: 0;
}

.go-booking-label {
  display: block;
  overflow: hidden;
  font-size: 20rpx;
  color: #98a099;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.go-booking-chips {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
  overflow: hidden;
  white-space: nowrap;
}

.go-booking-chip {
  flex-shrink: 0;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: var(--projectColorLight, #eef4f1);
  color: var(--themeColor, #5b8a72);
  font-size: 22rpx;
  font-weight: 600;
}

.go-booking-fallback {
  display: block;
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--themeColor, #5b8a72);
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.go-booking-cta {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: var(--themeColor, #5b8a72);
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
  white-space: nowrap;
}
