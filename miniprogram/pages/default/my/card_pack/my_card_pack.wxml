<page-meta page-style="{{pageStyle}}" />
<view class="card-pack-page theme-scope" style="{{pageStyle}}">
  <view wx:if="{{loading}}" class="card-pack-loading">
    <van-loading size="48rpx" color="{{themeColor}}">加载中...</van-loading>
  </view>

  <van-empty wx:elif="{{!cardList.length}}" description="{{showInvalid ? '暂无失效会员卡' : '暂无可用会员卡'}}" />

  <block wx:else>
    <view class="card-pack-intro">
      <text class="card-pack-intro-count">{{listIntroSub}}</text>
      <view class="card-pack-intro-links">
        <view class="card-pack-status-chip {{showInvalid ? 'is-active' : ''}}" hover-class="card-pack-chip--press" bindtap="bindSegTap" data-invalid="{{!showInvalid}}" aria-role="button" aria-label="{{showInvalid ? '返回有效卡' : '查看失效卡'}}">
          <van-icon wx:if="{{!showInvalid}}" name="clock-o" size="24rpx" />
          <text wx:else class="chip-back">‹</text>
          <text>{{showInvalid ? '返回有效卡' : '失效卡'}}</text>
        </view>
        <view class="card-pack-link-divider"></view>
        <view class="card-pack-order-link" bindtap="bindOrderTap">
          <text>购卡订单</text>
          <text class="card-pack-order-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="card-pack-list">
      <view
        wx:for="{{cardList}}"
        wx:key="id"
        class="card-pack-item {{item.isActive ? '' : 'is-invalid'}}"
        bindtap="bindCardTap"
        data-id="{{item.id}}"
      >
        <image wx:if="{{item.coverUrl}}" class="card-pack-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="card-pack-shade" style="{{item.shadeBg}}"></view>

        <view class="card-pack-top">
          <text class="card-pack-brand">{{tenantName}}</text>
          <text wx:if="{{item.statusLabel && item.statusLabel !== '正常'}}" class="card-pack-badge">{{item.statusLabel}}</text>
        </view>
        <view class="card-pack-name-row">
          <text class="card-pack-name">{{item.name}}</text>
          <text class="card-pack-more">···</text>
        </view>
        <text class="card-pack-sub">{{item.typeLabel}} · {{item.scopeDesc || '适用指定课程'}}</text>

        <view class="card-pack-bottom">
          <view>
            <text class="card-pack-meta-label">{{item.type === 'period' ? '练习权益' : '剩余次数'}}</text>
            <text class="card-pack-main-value">{{item.balanceText}}</text>
          </view>
          <view class="card-pack-expire">
            <text class="card-pack-meta-label">有效期至</text>
            <text class="card-pack-expire-value">{{item.endTimeDesc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 去约课反链：列表底部轻量行动条，分割线与卡区分隔；缩略图即主卡卡面（封面或品牌渐变） -->
    <view class="card-pack-divider" wx:if="{{goBooking}}"></view>
    <view class="go-booking" wx:if="{{goBooking}}" hover-class="go-booking--active" bindtap="bindGoBookingTap">
      <view class="go-booking-ico" style="{{goBooking.shadeBg}}">
        <image wx:if="{{goBooking.coverUrl}}" class="go-booking-cover" src="{{goBooking.coverUrl}}" mode="aspectFill" />
        <text class="go-booking-ico-type">{{goBooking.typeLabel}}</text>
      </view>
      <view class="go-booking-body">
        <text class="go-booking-label">{{goBooking.name}} · 这张卡能上</text>
        <view class="go-booking-chips" wx:if="{{goBooking.chips.length}}">
          <text class="go-booking-chip" wx:for="{{goBooking.chips}}" wx:key="index">{{item}}</text>
        </view>
        <text class="go-booking-fallback" wx:else>{{goBooking.scopeDesc}}</text>
      </view>
      <view class="go-booking-cta">去约课 ›</view>
    </view>
  </block>

  <view class="card-pack-buy-bar">
    <view class="card-pack-buy" style="background:{{themeColor}}" bindtap="bindCardShopTap">
      <van-icon name="shopping-cart-o" size="32rpx" color="#fff" />
      <text>购买会员卡</text>
    </view>
  </view>
</view>
