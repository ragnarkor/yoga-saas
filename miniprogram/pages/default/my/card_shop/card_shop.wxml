<view class="shop"><view wx:if="{{loading}}" class="loading"><van-loading color="{{themeColor}}">加载中...</van-loading></view><van-empty wx:elif="{{!cards.length}}" description="暂无可购买套餐"/><block wx:else><view class="shop-tip">{{guide || '提交申请后，请按馆方说明付款，到账后自动发卡。'}}</view><view wx:for="{{cards}}" wx:key="id" class="shop-card"><view class="shop-color" style="background:{{item.color}}"></view><view class="shop-info"><text class="shop-name">{{item.name}}</text><text class="shop-meta">{{item.type === 'times' ? item.quota + ' 次' : item.days + ' 天'}} · ¥{{item.priceFee / 100}}</text><text wx:if="{{item.desc}}" class="shop-desc">{{item.desc}}</text></view><van-button round size="small" color="{{themeColor}}" data-id="{{item.id}}" bind:click="buy">申请购买</van-button></view><view wx:if="{{contact}}" class="shop-contact">联系馆方：{{contact}}</view></block></view>
