<page-meta page-style="{{pageStyle}}" />

<view class="shop theme-scope" style="{{pageStyle}}">
  <cmpt-tenant-switch title="购买会员卡" theme-color="{{themeColor}}" show-back="{{true}}" />

  <view wx:if="{{loading}}" class="shop-loading">
    <van-loading color="{{themeColor}}">加载中...</van-loading>
  </view>

  <van-empty wx:elif="{{!cards.length}}" description="暂无可购买套餐" />

  <block wx:else>
    <view class="shop-hero" style="background:linear-gradient(135deg, {{themeColor}} 0%, {{themeColor}}b8 100%);">
      <text class="shop-hero-eyebrow">MEMBERSHIP</text>
      <text class="shop-hero-title">为练习留一张卡</text>
      <text class="shop-hero-sub">选择适合你的节奏，随时开始练习</text>
    </view>

    <view class="shop-tools">
      <view><text class="shop-tools-title">精选套餐</text><text class="shop-tools-count">{{cards.length}} 款在售</text></view>
      <view class="view-toggle">
        <view class="view-toggle-btn {{viewMode === 'list' ? 'is-active' : ''}}" data-mode="list" bindtap="bindViewToggle">
          <van-icon name="bars" size="32rpx" color="{{viewMode === 'list' ? themeColor : '#9ba59f'}}" />
        </view>
        <view class="view-toggle-btn {{viewMode === 'grid' ? 'is-active' : ''}}" data-mode="grid" bindtap="bindViewToggle">
          <van-icon name="apps-o" size="32rpx" color="{{viewMode === 'grid' ? themeColor : '#9ba59f'}}" />
        </view>
      </view>
    </view>

    <!-- 套餐列表：list 横排行 / grid 网格卡 -->
    <view class="shop-list {{viewMode === 'grid' ? 'shop-list--grid' : ''}}">
      <view
        wx:for="{{cards}}"
        wx:key="id"
        class="shop-item"
        data-id="{{item.id}}"
        bindtap="bindCardTap"
      >
        <view class="shop-thumb" style="background:linear-gradient(135deg, {{item.color}} 0%, {{item.colorDark}} 100%);{{item.coverStyle}}"></view>
        <view class="shop-item-main">
          <view class="shop-item-name">
            <text class="shop-item-title">{{item.name}}</text>
            <text class="shop-item-tag">{{item.typeDesc}}</text>
          </view>
          <text class="shop-item-desc">{{item.mainAttr}} · {{item.scopeText}}</text>
        </view>
        <view class="shop-item-aside">
          <view class="shop-item-price">
            <text class="shop-price-cur" style="color:{{themeColor}}">¥</text>
            <text class="shop-price-num" style="color:{{themeColor}}">{{item.priceYuan}}</text>
            <text wx:if="{{item.hasDiscount}}" class="shop-price-origin">¥{{item.originYuan}}</text>
          </view>
          <view class="shop-item-btn" style="background:{{themeColor}};" catchtap="bindCardTap" data-id="{{item.id}}">查看套餐</view>
        </view>
      </view>
    </view>
  </block>
</view>
