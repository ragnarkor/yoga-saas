.shop {
  min-height: 100vh;
  background: var(--projectBgSoft, #fafbf9);
  padding-bottom: env(safe-area-inset-bottom);
}

.shop-loading {
  display: flex;
  justify-content: center;
  padding: 160rpx 0;
}

/* 顶部 hero */
.shop-hero {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 8rpx;
  min-height: 218rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  color: #fff;
  box-shadow: 0 10rpx 26rpx rgba(61, 78, 69, 0.16);
}

.shop-hero-eyebrow {
  opacity: 0.76;
  letter-spacing: 3rpx;
  font-size: 19rpx;
}

.shop-hero-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.shop-hero-sub {
  max-width: 430rpx;
  opacity: 0.86;
  font-size: 22rpx;
  line-height: 1.55;
}

/* 区块标题 + 视图切换 */
.shop-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 28rpx 0;
}

.shop-tools-title {
  display: block;
  color: #35443b;
  font-size: 30rpx;
  font-weight: 700;
}

.shop-tools-count {
  display: block;
  margin-top: 2rpx;
  color: #9ba59f;
  font-size: 22rpx;
}

.view-toggle {
  display: flex;
  gap: 10rpx;
}

.view-toggle-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(43, 63, 52, 0.08);
  transition: background-color 0.2s ease;
}

/* 扩大点击热区至约 88rpx，避免图标按钮视觉不变但难点中 */
.view-toggle-btn::before {
  content: "";
  position: absolute;
  inset: -12rpx;
}

.view-toggle-btn.is-active {
  background: var(--projectColorLight, #e5f1ec);
}

.view-toggle-btn:active {
  opacity: 0.85;
}

/* 套餐列表：横排行 */
.shop-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 22rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
}

.shop-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(43, 63, 52, 0.06);
}

.shop-thumb {
  flex-shrink: 0;
  width: 132rpx;
  height: 108rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.1);
}

.shop-item-main {
  flex: 1;
  min-width: 0;
}

.shop-item-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.shop-item-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #2f3d35;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
}

.shop-item-tag {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  color: var(--themeColor, #5b8a72);
  background: var(--projectColorLight, #e5f1ec);
  font-size: 19rpx;
  font-weight: 500;
}

.shop-item-desc {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #8b958e;
  font-size: 23rpx;
  line-height: 1.5;
}

.shop-item-aside {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.shop-item-price {
  display: flex;
  align-items: baseline;
}

.shop-price-cur {
  font-size: 24rpx;
  font-weight: 700;
}

.shop-price-num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.shop-price-origin {
  margin-left: 10rpx;
  color: #b5bcb7;
  font-size: 22rpx;
  text-decoration: line-through;
}

.shop-item-btn {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  transition: filter 0.2s ease;
}

.shop-item-btn:active {
  filter: brightness(0.92);
}

/* ===== 网格视图（2 列块卡） ===== */
.shop-list--grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.shop-list--grid .shop-item {
  display: block;
  padding: 0 0 22rpx;
}

.shop-list--grid .shop-thumb {
  width: 100%;
  height: 150rpx;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: none;
}

.shop-list--grid .shop-item-main {
  padding: 16rpx 20rpx 0;
}

.shop-list--grid .shop-item-title {
  font-size: 26rpx;
}

.shop-list--grid .shop-item-tag {
  padding: 2rpx 10rpx;
  font-size: 18rpx;
}

.shop-list--grid .shop-item-desc {
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.shop-list--grid .shop-item-aside {
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
}

.shop-list--grid .shop-item-btn {
  display: none;
}

.shop-list--grid .shop-price-cur {
  font-size: 20rpx;
}

.shop-list--grid .shop-price-num {
  font-size: 34rpx;
}

.shop-list--grid .shop-price-origin {
  font-size: 20rpx;
}
