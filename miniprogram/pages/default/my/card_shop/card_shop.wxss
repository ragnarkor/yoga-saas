.shop {
  min-height: 100vh;
  background: #f5f6f8;
}

.shop-loading {
  display: flex;
  justify-content: center;
  padding: 160rpx 0;
}

/* 商品卡列表 */
.shop-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 16rpx 24rpx 36rpx;
}
.shop-hero { display:flex; align-items:flex-end; justify-content:space-between; gap:16rpx; min-height:218rpx; margin:24rpx 24rpx 0; padding:28rpx; border-radius:24rpx; box-sizing:border-box; color:#fff; box-shadow:0 10rpx 26rpx rgba(61,78,69,.16); }
.shop-hero-eyebrow { display:block; opacity:.76; letter-spacing:3rpx; font-size:19rpx; }
.shop-hero-title { display:block; margin-top:8rpx; font-size:36rpx; font-weight:700; line-height:1.35; }
.shop-hero-sub { display:block; margin-top:8rpx; max-width:430rpx; opacity:.86; font-size:22rpx; line-height:1.55; }
.shop-order-entry { display:flex; flex-direction:column; align-items:center; gap:7rpx; min-width:94rpx; font-size:21rpx; }
.shop-section-head { display:flex; align-items:baseline; justify-content:space-between; margin:30rpx 28rpx 0; color:#35443b; font-size:30rpx; font-weight:700; }.shop-section-head text:last-child{color:#9ba59f;font-size:22rpx;font-weight:400;}
.goods {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

/* 卡面头图 */
.goods-cover {
  position: relative;
  height: 200rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.goods-cover-name {
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}
.goods-cover-tag {
  align-self: flex-start;
  margin-top: 14rpx;
  padding: 4rpx 18rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
}

.goods-body {
  padding: 24rpx 28rpx 28rpx;
}
.goods-selling { display:block; margin-bottom:17rpx; color:#59675f; font-size:25rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

/* 权益标签 */
.goods-attrs {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
}
.goods-attr {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #4a5550;
  font-size: 25rpx;
}

.goods-desc {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  color: #7d887f;
  font-size: 24rpx;
  line-height: 1.6;
  background: #f7f8f7;
  border-radius: 12rpx;
}

/* 价格 + 按钮 */
.goods-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
.goods-price-wrap {
  display: flex;
  align-items: baseline;
}
.goods-price-cur {
  font-size: 28rpx;
  font-weight: 700;
}
.goods-price {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}
.goods-price-origin {
  margin-left: 14rpx;
  color: #b5bcb7;
  font-size: 26rpx;
  text-decoration: line-through;
}
.goods-btn {
  min-width: 180rpx;
  height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 购买说明 */
.shop-guide-bar {
  margin:0 24rpx;padding:20rpx 8rpx calc(28rpx + env(safe-area-inset-bottom));
}
.shop-guide-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.shop-guide-row--contact {
  margin-top: 10rpx;
}
.shop-guide-text {
  flex: 1;
  color: #4a5550;
  font-size: 25rpx;
  line-height: 1.55;
}
.shop-guide-text--sub {
  color: #a0a8a2;
  font-size: 24rpx;
}
