.shop{min-height:100vh;padding:28rpx;background:#f7f8f7}.loading{display:flex;justify-content:center;padding:120rpx}.shop-tip,.shop-contact{margin-bottom:20rpx;color:#7d887f;font-size:25rpx;line-height:1.65}.shop-contact{margin-top:28rpx}.shop-card{display:flex;align-items:center;gap:18rpx;margin-bottom:18rpx;padding:24rpx;border-radius:20rpx;background:#fff}.shop-color{width:12rpx;height:88rpx;border-radius:99rpx}.shop-info{flex:1;min-width:0}.shop-name,.shop-meta,.shop-desc{display:block}.shop-name{color:#34423a;font-size:30rpx;font-weight:700}.shop-meta{margin-top:8rpx;color:#7d887f;font-size:24rpx}.shop-desc{margin-top:5rpx;color:#a0a8a2;font-size:22rpx}
