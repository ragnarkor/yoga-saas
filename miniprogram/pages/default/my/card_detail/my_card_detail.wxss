@import "../../skin/skin.wxss";

.card-detail-page {
  min-height: 100vh;
  background: var(--projectBgSoft, #fafbf9);
}

.card-detail-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
}

.card-detail-content {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 卡面（正/反翻面） ===== */
.card-face-wrap {
  height: 400rpx;
  position: relative;
  margin-bottom: 42rpx;
  perspective: 1200rpx;
}

.card-face {
  position: absolute;
  inset: 0;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 28rpx;
  color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
  box-shadow: 0 16rpx 36rpx rgba(43, 63, 52, 0.18);
  backface-visibility: hidden;
  transition: transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1);
  box-sizing: border-box;
}

.card-face--front {
  transform: rotateY(0);
}

.card-face--back {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 30rpx 40rpx;
  background: linear-gradient(145deg, #315347, #1e382f);
  transform: rotateY(180deg);
}

.card-face-wrap.is-back .card-face--front {
  transform: rotateY(-180deg);
}

.card-face-wrap.is-back .card-face--back {
  transform: rotateY(0);
}

.card-face-cover,
.card-face-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.card-face-shade {
  background: linear-gradient(115deg, rgba(9, 26, 17, 0.5), rgba(9, 26, 17, 0.08) 57%, rgba(255, 255, 255, 0.08));
}

.card-face--front.is-invalid {
  filter: saturate(0.28);
}

.card-face--front.is-invalid .card-face-shade {
  background: linear-gradient(115deg, rgba(9, 26, 17, 0.5), rgba(9, 26, 17, 0.08) 57%, rgba(255, 255, 255, 0.08)), rgba(25, 31, 28, 0.4);
}

.card-face-top,
.card-face-name,
.card-face-scope,
.card-face-bottom {
  position: relative;
  z-index: 1;
}

.card-face-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.92;
}

.card-face-top text:last-child {
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 0;
}
.card-face-name {
  display: block;
  margin-top: 48rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.2;
}

.card-face-scope {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.card-face-bottom {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.card-face-bottom text {
  display: block;
  font-size: 20rpx;
  opacity: 0.85;
}

.card-face-bottom b {
  display: block;
  margin-top: 5rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.card-face-end {
  min-width: 176rpx;
  text-align: right;
}

.card-face-end b {
  font-size: 24rpx;
  font-weight: 400;
}

/* ===== 卡背面资料行（留足呼吸感） ===== */
.card-back-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  font-size: 24rpx;
}

.card-back-row + .card-back-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.card-back-row text {
  opacity: 0.72;
}

.card-back-row b {
  text-align: right;
  font-size: 24rpx;
  font-weight: 500;
}

.card-back-copy {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 卡号复制热区较小，扩大点击热区至约 88rpx */
.card-back-copy::before {
  content: "";
  position: absolute;
  inset: -30rpx;
}

.card-back-memo {
  display: block;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 上课记录（原始样式） ===== */
.card-detail-section {
  margin-top: 28rpx;
}

.card-detail-section-head {
  margin-bottom: 14rpx;
}

.card-detail-title {
  display: block;
  font-size: 32rpx;
  font-weight: 650;
  color: #293a31;
}

.card-detail-sub {
  display: block;
  margin-top: 4rpx;
  color: #98a099;
  font-size: 22rpx;
}

.card-usage-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.card-usage-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 28rpx;
  position: relative;
}

.card-usage-item:last-child {
  padding-bottom: 0;
}

.card-usage-item:not(:last-child)::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 28rpx;
  bottom: 0;
  width: 2rpx;
  background: #ebedf0;
}

.card-usage-dot {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-top: 6rpx;
  background: var(--themeColor, #5b8a72);
  position: relative;
  z-index: 1;
  box-shadow: 0 0 0 6rpx rgba(91, 138, 114, 0.12);
}

.card-usage-dot--manual {
  background: #ffa940;
  box-shadow: 0 0 0 6rpx rgba(250, 169, 64, 0.12);
}

.card-usage-dot--refund {
  background: #969799;
  box-shadow: 0 0 0 6rpx rgba(150, 151, 153, 0.12);
}

.card-usage-body {
  flex: 1;
  min-width: 0;
}

.card-usage-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-usage-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  line-height: 1.4;
}

.card-usage-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.card-usage-type {
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--themeColor, #5b8a72);
  background: var(--projectColorLight, #e3efe8);
}

.card-usage-deduct {
  font-size: 24rpx;
  color: #646566;
}

.card-usage-schedule {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}

.card-usage-status {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--themeColor, #5b8a72);
  background: var(--projectColorLight, #e3efe8);
}

.card-usage-status.is-refund {
  color: #969799;
  background: #f2f3f5;
}

.card-usage-status.is-manual {
  color: #fa8c16;
  background: #fff7e6;
}
