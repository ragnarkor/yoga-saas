@import "../../skin/skin.wxss";

.card-detail-page {
  min-height: 100vh;
  background: #f5f6f8;
}

.card-detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  min-height: 50vh;
  box-sizing: border-box;
}

.card-detail-tabs {
  display: flex;
  background: var(--themeColor, #5b8a72);
}

.card-detail-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  background: transparent;
}

.card-detail-tab.is-active {
  color: var(--themeColor, #5b8a72);
  background: #fff;
  font-weight: 600;
  border-radius: 16rpx 16rpx 0 0;
}

.card-detail-panel {
  padding: 24rpx;
}

.card-usage-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.card-usage-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 28rpx;
  position: relative;
}

.card-usage-item:last-child {
  padding-bottom: 0;
}

.card-usage-item:not(:last-child)::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 28rpx;
  bottom: 0;
  width: 2rpx;
  background: #ebedf0;
}

.card-usage-dot {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-top: 6rpx;
  background: var(--themeColor, #5b8a72);
  position: relative;
  z-index: 1;
  box-shadow: 0 0 0 6rpx rgba(91, 138, 114, 0.12);
}

.card-usage-dot--manual {
  background: #ffa940;
  box-shadow: 0 0 0 6rpx rgba(250, 169, 64, 0.12);
}

.card-usage-dot--refund {
  background: #969799;
  box-shadow: 0 0 0 6rpx rgba(150, 151, 153, 0.12);
}

.card-usage-body {
  flex: 1;
  min-width: 0;
}

.card-usage-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-usage-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  line-height: 1.4;
}

.card-usage-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.card-usage-type {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 14rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
  color: var(--themeColor, #5b8a72);
  background: var(--projectColorLight, #e3efe8);
  box-sizing: border-box;
}

.card-usage-deduct {
  font-size: 24rpx;
  color: #646566;
}

.card-usage-schedule {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}

.card-usage-tenant {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #c8c9cc;
}

.card-usage-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 14rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  color: var(--themeColor, #5b8a72);
  background: var(--projectColorLight, #e3efe8);
  box-sizing: border-box;
}

.card-usage-status.is-refund {
  color: #969799;
  background: #f2f3f5;
}

.card-usage-status.is-manual {
  color: #fa8c16;
  background: #fff7e6;
}

.card-info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-info-visual {
  position: relative;
  width: 240rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 0 auto 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}

.card-info-visual-img,
.card-info-visual-solid {
  width: 100%;
  height: 100%;
  display: block;
}

.card-info-vip {
  position: absolute;
  top: 16rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.card-info-type {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.card-info-section {
  margin-bottom: 8rpx;
}

.card-info-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 16rpx;
}

.card-info-divider {
  height: 1rpx;
  background: #ebedf0;
  margin: 28rpx 0;
}

.card-scope-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.card-scope-tag {
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: var(--themeColor, #5b8a72);
  background: var(--projectColorLight, #e3efe8);
}

.card-scope-tag--all {
  color: #646566;
  background: #f2f3f5;
}

.card-scope-hint-text {
  font-size: 24rpx;
  color: #969799;
}

.card-scope-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}

.card-info-rows {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.card-info-label {
  font-size: 28rpx;
  color: #969799;
  flex-shrink: 0;
}

.card-info-value {
  font-size: 28rpx;
  color: #323233;
  text-align: right;
  flex: 1;
}

.card-info-copy {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}
