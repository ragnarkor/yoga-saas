<page-meta page-style="{{pageStyle}}" />
<view class="card-detail-page theme-scope" style="{{pageStyle}}">
  <view wx:if="{{loading}}" class="card-detail-loading">
    <van-loading size="48rpx" color="{{themeColor}}">加载中...</van-loading>
  </view>

  <van-empty wx:elif="{{!card}}" description="会员卡不存在" />

  <block wx:else>
    <view class="card-detail-content">
      <view class="card-face-wrap {{showCardBack ? 'is-back' : ''}}" bindtap="bindToggleCardFace" aria-role="button" aria-label="翻转查看卡背面">
        <view class="card-face card-face--front {{card.isActive ? '' : 'is-invalid'}}">
          <image wx:if="{{card.coverUrl}}" class="card-face-cover" src="{{card.coverUrl}}" mode="aspectFill" />
          <view class="card-face-shade" style="{{card.shadeBg}}"></view>
          <view class="card-face-top"><text>{{tenantName || '会员卡'}}</text><text>{{card.isActive ? card.typeLabel : (card.statusLabel || '已失效')}}</text></view>
          <text class="card-face-name">{{card.name}}</text>
          <text class="card-face-scope">{{card.scopeDesc || '适用指定课程'}}</text>
          <view class="card-face-bottom">
            <view><text>{{card.type === 'period' ? '练习权益' : '剩余次数'}}</text><b>{{card.balanceText}}</b></view>
            <view class="card-face-end"><text>有效期至</text><b>{{card.endTimeDesc}}</b></view>
          </view>
        </view>
        <view class="card-face card-face--back">
          <view class="card-back-row"><text>适用课程</text><b>{{card.scopeDesc || '全馆课程'}}</b></view>
          <view class="card-back-row"><text>卡号</text><view class="card-back-copy" catchtap="bindCopyCardNo"><b>{{card.cardNo}}</b><van-icon name="description" size="28rpx" color="#fff" /></view></view>
          <view class="card-back-row"><text>开卡日期</text><b>{{card.startTimeDesc || '—'}}</b></view>
          <view wx:if="{{card.coachName}}" class="card-back-row"><text>归属教练</text><b>{{card.coachName}}</b></view>
          <view wx:if="{{card.memo}}" class="card-back-row"><text>备注</text><b class="card-back-memo">{{card.memo}}</b></view>
        </view>
      </view>

      <view class="card-detail-section">
        <view class="card-detail-section-head">
          <text class="card-detail-title">上课记录</text>
          <text class="card-detail-sub">共 {{usageTotal}} 次练习</text>
        </view>
        <van-empty wx:if="{{!usageList.length}}" description="暂无上课记录" />
        <view wx:else class="card-usage-list">
          <view class="card-usage-item" wx:for="{{usageList}}" wx:key="id">
            <view class="card-usage-dot {{item.isManual ? 'card-usage-dot--manual' : ''}} {{item.isRefund ? 'card-usage-dot--refund' : ''}}"></view>
            <view class="card-usage-body">
              <view class="card-usage-top">
                <text class="card-usage-title">{{item.meetTitle}}</text>
                <text class="card-usage-status {{item.isRefund ? 'is-refund' : ''}} {{item.isManual ? 'is-manual' : ''}}">{{item.statusLabel}}</text>
              </view>
              <view class="card-usage-meta">
                <text wx:if="{{item.meetTypeName}}" class="card-usage-type">{{item.meetTypeName}}</text>
                <text class="card-usage-deduct">{{item.deductText}}</text>
              </view>
              <view wx:if="{{item.scheduleText}}" class="card-usage-schedule">
                <van-icon name="clock-o" size="24rpx" color="#969799" />
                <text>{{item.scheduleText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
