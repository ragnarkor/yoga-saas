.ach-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}



.ach-loading {

  padding: 160rpx 0;

  display: flex;

  justify-content: center;

}



.ach-hero {
  position: relative;
  height: 380rpx;
  overflow: hidden;
  background: #e7e6db;
}

.ach-hero-emojis {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}

.ach-hero-badge {
  position: absolute;
  width: 82rpx;
  height: 82rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.18));
}



.ach-hero-bg {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  display: block;
}



.ach-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to right,
    rgba(0, 0, 0, 0.28) 0%,
    rgba(0, 0, 0, 0.08) 55%,
    rgba(255, 255, 255, 0.04) 100%
  );

  pointer-events: none;

}



.ach-hero-text {
  position: absolute;
  left: 32rpx;
  bottom: 40rpx;
  z-index: 3;
}



.ach-hero-label {

  display: block;

  font-size: 24rpx;

  color: rgba(255, 255, 255, 0.92);

  line-height: 1.4;

}



.ach-hero-num {

  display: block;

  margin-top: 4rpx;

  font-size: 72rpx;

  font-weight: 700;

  color: #fff;

  line-height: 1.1;

  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.18);

}



.ach-hero-sub {

  display: block;

  margin-top: 4rpx;

  font-size: 24rpx;

  color: rgba(255, 255, 255, 0.9);

}



.ach-body {

  position: relative;

  z-index: 2;

  margin-top: -24rpx;

}



.ach-stats {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 16rpx;

  margin: 0 24rpx 24rpx;

  padding: 28rpx 20rpx;

  background: #fff;

  border-radius: 24rpx;

  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);

}



.ach-stat-card {

  text-align: center;

  padding: 8rpx 0;

}



.ach-stat-num {

  display: block;

  font-size: 32rpx;

  font-weight: 700;

  line-height: 1.2;

}



.ach-stat-label {

  display: block;

  margin-top: 8rpx;

  font-size: 24rpx;

  color: #888;

}



.ach-section {

  margin: 0 24rpx 24rpx;

  padding: 24rpx;

  background: #fff;

  border-radius: 20rpx;

  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);

}



.ach-section-head {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 20rpx;

}



.ach-section-title {

  font-size: 30rpx;

  font-weight: 600;

  color: #2c2c2c;

  margin-bottom: 20rpx;

}



.ach-section-title--inline {

  margin-bottom: 0;

}



.ach-section-extra {

  font-size: 24rpx;

  color: #888;

}



.ach-heatmap-legend {

  display: flex;

  gap: 24rpx;

  margin-top: 16rpx;

  font-size: 22rpx;

  color: #969799;

}



.ach-legend-item {

  display: flex;

  align-items: center;

  gap: 8rpx;

}



.ach-legend-box {

  width: 20rpx;

  height: 20rpx;

  border-radius: 4rpx;

  background: #ebedf0;

}



.ach-section-sub {

  margin: -8rpx 0 16rpx;

  font-size: 24rpx;

  color: #888;

  line-height: 1.5;

}



.ach-heatmap-hint {

  margin-top: 16rpx;

  padding: 16rpx 20rpx;

  border-radius: 12rpx;

  background: #fff7e6;

  color: #d48806;

  font-size: 24rpx;

  line-height: 1.5;

}



.ach-badge-grid {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 16rpx;

}



.ach-badge-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.ach-badge-item--locked {
  opacity: 0.45;
  filter: grayscale(1);
}

.ach-badge-name {

  margin-top: 8rpx;

  font-size: 22rpx;

  color: #646566;

  text-align: center;

  line-height: 1.3;

}



.ach-badge-new {

  position: absolute;

  top: 0;

  right: 0;

  padding: 2rpx 8rpx;

  border-radius: 999rpx;

  background: #ee0a24;

  color: #fff;

  font-size: 18rpx;

}



.ach-actions {

  padding: 0 24rpx 24rpx;

  display: flex;

  flex-direction: column;

  gap: 16rpx;

}



.ach-btn {

  border-radius: 999rpx;

  font-size: 30rpx;

  height: 88rpx;

  line-height: 88rpx;

  border: none;

}



.ach-btn::after {

  border: none;

}



.ach-btn--primary {

  color: #fff;

}



.ach-canvas {

  position: fixed;

  left: -9999px;

  top: 0;

  width: 750px;

  height: 1100px;

}

.ach-poster-preview-image {
  display: block;
  width: 100%;
  max-height: 760rpx;
  margin: 28rpx auto 24rpx;
  border-radius: 20rpx;
  background: #f2f0ea;
  box-shadow: 0 12rpx 32rpx rgba(61, 81, 69, .13);
}

/* 成就预览统一采用黑色全屏沉浸模式。 */
.ach-fullscreen-modal { position:fixed; z-index:9999; inset:0; display:flex; align-items:center; justify-content:center; padding:48rpx; box-sizing:border-box; background:rgba(16,21,19,.82); }
.ach-fullscreen-badge { position:relative; width:100%; max-width:580rpx; padding:72rpx 48rpx 60rpx; box-sizing:border-box; border-radius:36rpx; text-align:center; background:linear-gradient(145deg,#252827,#111313); box-shadow:0 24rpx 80rpx rgba(0,0,0,.5); }
.ach-fullscreen-poster { position:relative; width:100%; max-height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:40rpx; }
.ach-fullscreen-badge .ach-badge-popup-name { color:#fff; }
.ach-fullscreen-badge .ach-badge-popup-desc { color:rgba(255,255,255,.72); }
.ach-fullscreen-badge .ach-badge-popup-meta { color:rgba(255,255,255,.52); }
.ach-fullscreen-badge .ach-badge-popup-done, .ach-fullscreen-badge .ach-badge-popup-progress { color:rgba(255,255,255,.82); }
.ach-fullscreen-poster .ach-poster-preview-image { width:100%; height:auto; max-width:100%; max-height:calc(100vh - 280rpx); margin:0; border-radius:18rpx; box-shadow:0 20rpx 64rpx rgba(0,0,0,.55); }
.ach-poster-tools { display:flex; align-items:flex-start; justify-content:center; gap:68rpx; width:100%; }
.ach-poster-tool { display:flex; flex-direction:column; align-items:center; justify-content:flex-start; gap:13rpx; min-width:120rpx; padding:0; margin:0; color:rgba(255,255,255,.9); font-size:22rpx; font-weight:400; line-height:1.2; background:transparent; border:0; }
.ach-poster-tool::after { border:0; }
.ach-poster-tool-icon { display:flex; align-items:center; justify-content:center; width:82rpx; height:82rpx; border-radius:50%; box-shadow:0 8rpx 20rpx rgba(0,0,0,.24); }
.ach-poster-tool-icon--share { background:rgba(255,255,255,.96); }
.ach-poster-tool--pressed { opacity:.7; transform:scale(.95); }

/* 成就页：从数据面板调整为温和的瑜伽旅程卡片 */
.ach-page { background: #f5f1e9; }
.ach-hero { height: 430rpx; background: #557e69; }
.ach-hero-overlay { background: linear-gradient(to bottom, rgba(24,55,42,.18), rgba(24,55,42,.62)); }
.ach-hero-text { left: 40rpx; bottom: 54rpx; }
.ach-hero-label { font-size: 25rpx; letter-spacing: 4rpx; }
.ach-hero-num { margin-top: 10rpx; font-size: 84rpx; letter-spacing: 2rpx; }
.ach-hero-sub { margin-top: 6rpx; font-size: 25rpx; }
.ach-body { margin-top: -32rpx; }
.ach-stats { margin: 0 28rpx 28rpx; padding: 26rpx 16rpx; border-radius: 28rpx; box-shadow: 0 12rpx 32rpx rgba(73,77,61,.09); }
.ach-stat-card { padding: 12rpx 0; }
.ach-stat-num { font-size: 36rpx; }
.ach-stat-label { font-size: 23rpx; color: #8a8f84; }
.ach-section { margin: 0 28rpx 24rpx; padding: 28rpx; border-radius: 26rpx; background: #fffdf9; box-shadow: 0 8rpx 24rpx rgba(73,77,61,.05); }
.ach-section-title { color: #3c5145; font-size: 31rpx; }
.ach-section-sub { color: #9a9c91; font-size: 23rpx; }
.ach-heatmap-legend, .ach-section-extra { color: #92958b; }
.ach-heatmap-legend { justify-content: flex-end; }
.ach-badge-grid { gap: 18rpx; }
.ach-badge-item { min-height: 170rpx; border-radius: 22rpx; background: #f3eee3; border: 1rpx solid #e9dfcd; }
.ach-badge-item--locked { background: #f8f7f3; border-color: #eee; }
.ach-badge-flip-scene { width:104rpx; height:104rpx; perspective:900rpx; }
.ach-badge-flip-card { position:relative; width:100%; height:100%; transform-style:preserve-3d; }
.ach-badge-icon { position:absolute; inset:0; width:104rpx; height:104rpx; backface-visibility:hidden; -webkit-backface-visibility:hidden; }
.ach-badge-icon--back { transform:rotateY(180deg); }
.ach-badge-item--spinning .ach-badge-flip-card { animation: ach-badge-flip 900ms cubic-bezier(.2,.72,.24,1); }
.ach-badge-popup-scene { width:300rpx; height:300rpx; margin:0 auto; perspective:1200rpx; }
.ach-badge-popup-card { position:relative; width:100%; height:100%; transform-style:preserve-3d; }
.ach-badge-popup-icon { position:absolute; inset:0; width:300rpx; height:300rpx; backface-visibility:hidden; -webkit-backface-visibility:hidden; }
.ach-badge-popup-icon--back { transform:rotateY(180deg); }
.ach-badge-popup-scene--spinning .ach-badge-popup-card { animation: ach-badge-flip 900ms cubic-bezier(.2,.72,.24,1); }
@keyframes ach-badge-flip {
  0% { transform: rotateY(0deg) scale(1); }
  50% { transform: rotateY(180deg) scale(1.06); }
  58% { transform: rotateY(180deg) scale(1.06); }
  100% { transform: rotateY(360deg) scale(1); }
}
.ach-badge-name { color: #53675b; font-size: 23rpx; }
.ach-badge-meta { margin-top: 6rpx; color: #a0a79d; font-size: 19rpx; }
.ach-badge-progress { width: 112rpx; height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 99rpx; background: #e8e6df; }
.ach-badge-progress-fill { height: 100%; border-radius: inherit; }
.ach-badge-item--rare { border-color: #d7c49b; }
.ach-badge-item--epic { border-color: #c7b5df; }
.ach-badge-item--legendary { border-color: #d4ae62; box-shadow: inset 0 0 0 1rpx rgba(212,174,98,.18); }
.ach-actions { margin: 8rpx 28rpx 36rpx; }
.ach-btn { border-radius: 999rpx; box-shadow: 0 8rpx 18rpx rgba(73,77,61,.08); }
.ach-page { background: #fcfbf8; }
.ach-stats { background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(67,84,73,.06); }
.ach-section { background: #ffffff; box-shadow: 0 6rpx 18rpx rgba(67,84,73,.045); }
.ach-badge-item { background: #f8f6ef; border-color: #eee8db; }
.ach-badge-item--locked { background: #fbfaf8; border-color: #f0efeb; }
.ach-actions { display:flex; flex-direction:column; margin: 12rpx 28rpx 40rpx; padding: 0; gap: 16rpx; }
.ach-btn { width:100%; flex:none; height: 78rpx; line-height: 78rpx; font-size: 27rpx; box-sizing: border-box; box-shadow: none; }
.ach-btn--primary { background: var(--themeColor, #6fae96) !important; color: #fff; box-shadow: 0 6rpx 14rpx rgba(111,174,150,.22); }

/* 与教练端会员卡页一致：完整底部栏 + 内嵌品牌色主按钮。 */
.ach-page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.ach-actions { position:fixed; z-index:100; right:0; bottom:0; left:0; display:block; padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); margin:0; box-sizing:border-box; background:#fff; box-shadow:0 -4rpx 20rpx rgba(0,0,0,.06); }
.ach-btn { display:flex; align-items:center; justify-content:center; gap:10rpx; width:100%; height:88rpx; padding:0 48rpx; line-height:1; border-radius:16rpx; box-sizing:border-box; box-shadow:none; }
.ach-heatmap-popup { padding: 48rpx 36rpx calc(48rpx + env(safe-area-inset-bottom)); text-align:center; background:#fff; }
.ach-heatmap-popup-icon { width:92rpx; height:92rpx; margin:0 auto 20rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#f2f1ec; }
.ach-heatmap-popup-icon.is-on { background:var(--projectColorLight,#e8f2ed); }
.ach-heatmap-popup-date { display:block; font-size:34rpx; font-weight:600; color:#3c5145; }
.ach-heatmap-popup-status { display:block; margin-top:12rpx; font-size:28rpx; color:#53675b; }
.ach-heatmap-popup-note { display:block; margin-top:18rpx; font-size:24rpx; color:#9a9c91; }

/* 练习日历：用真实日期和星期标题替代需要交叉解读的坐标热力图 */
.ach-heatmap-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; }
.ach-heatmap-heading .ach-section-title { margin-bottom:6rpx; }

/* 标准月历布局，用户无需理解热力图坐标 */
.ach-calendar-month-switch { display:flex; align-items:center; gap:10rpx; padding-top:2rpx; }
.ach-calendar-month { min-width:132rpx; text-align:center; color:#53675b; font-size:27rpx; font-weight:600; }
.ach-calendar-arrow { position:relative; width:42rpx; height:42rpx; line-height:36rpx; text-align:center; border-radius:50%; background:#f4f2ec; color:#6f806f; font-size:38rpx; }
.ach-calendar-arrow::before { content:""; position:absolute; inset:-23rpx; }
.ach-calendar { margin-top:18rpx; }
.ach-calendar-week-head, .ach-calendar-row { display:grid; grid-template-columns:repeat(7, 1fr); gap:8rpx; }
.ach-calendar-week-head { margin-bottom:10rpx; text-align:center; }
.ach-calendar-week-head text { font-size:21rpx; color:#9a9c91; }
.ach-calendar-row { margin-bottom:8rpx; }
.ach-calendar-cell { position:relative; height:64rpx; display:flex; align-items:center; justify-content:center; border-radius:14rpx; background:#f1eee7; color:#777b72; font-size:25rpx; }
/* 与 .ach-calendar-arrow 一致：自身有可见背景，使用不可见 ::before/inset 命中区扩大点击范围 */
.ach-calendar-cell::before { content:""; position:absolute; inset:-12rpx; }
.ach-calendar-cell--on { color:#fff; font-weight:600; box-shadow:0 5rpx 10rpx rgba(76,129,101,.18); }
.ach-calendar-cell--today { outline:3rpx solid #d8a84e; outline-offset:2rpx; }
.ach-calendar-cell--empty { background:transparent; }



.ach-badge-popup-name {

  display: block;

  margin-top: 16rpx;

  font-size: 34rpx;

  font-weight: 600;

  color: #2c2c2c;

}



.ach-badge-popup-desc {

  display: block;

  margin-top: 12rpx;

  font-size: 26rpx;

  color: #888;

}
.ach-badge-popup-meta { margin-top: 12rpx; color: #9a9c91; font-size: 23rpx; }
.ach-badge-popup-progress-track { width: 360rpx; height: 12rpx; margin: 20rpx auto 12rpx; overflow: hidden; border-radius: 99rpx; background: #eceae4; }
.ach-badge-popup-progress-fill { height: 100%; border-radius: inherit; }



.ach-badge-popup-done,

.ach-badge-popup-progress {

  margin-top: 24rpx;

  font-size: 28rpx;

  color: #646566;

}

/* 详情信息直接浮在黑色遮罩上，不再使用第二层弹窗卡片。 */
.ach-fullscreen-badge { max-width:580rpx; padding:72rpx 48rpx 60rpx; background:transparent; box-shadow:none; }
