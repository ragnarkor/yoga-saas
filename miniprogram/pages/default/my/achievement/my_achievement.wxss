.ach-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}



.ach-loading {

  padding: 160rpx 0;

  display: flex;

  justify-content: center;

}



.ach-hero {
  position: relative;
  height: 380rpx;
  overflow: hidden;
  background: #e7e6db;
}

.ach-hero-emojis {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}

.ach-hero-emoji {
  position: absolute;
  font-size: 44rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.18));
}



.ach-hero-bg {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  display: block;
}



.ach-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to right,
    rgba(0, 0, 0, 0.28) 0%,
    rgba(0, 0, 0, 0.08) 55%,
    rgba(255, 255, 255, 0.04) 100%
  );

  pointer-events: none;

}



.ach-hero-text {
  position: absolute;
  left: 32rpx;
  bottom: 40rpx;
  z-index: 3;
}



.ach-hero-label {

  display: block;

  font-size: 24rpx;

  color: rgba(255, 255, 255, 0.92);

  line-height: 1.4;

}



.ach-hero-num {

  display: block;

  margin-top: 4rpx;

  font-size: 72rpx;

  font-weight: 700;

  color: #fff;

  line-height: 1.1;

  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.18);

}



.ach-hero-sub {

  display: block;

  margin-top: 4rpx;

  font-size: 24rpx;

  color: rgba(255, 255, 255, 0.9);

}



.ach-body {

  position: relative;

  z-index: 2;

  margin-top: -24rpx;

}



.ach-stats {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 16rpx;

  margin: 0 24rpx 24rpx;

  padding: 28rpx 20rpx;

  background: #fff;

  border-radius: 24rpx;

  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);

}



.ach-stat-card {

  text-align: center;

  padding: 8rpx 0;

}



.ach-stat-num {

  display: block;

  font-size: 32rpx;

  font-weight: 700;

  line-height: 1.2;

}



.ach-stat-label {

  display: block;

  margin-top: 8rpx;

  font-size: 24rpx;

  color: #888;

}



.ach-section {

  margin: 0 24rpx 24rpx;

  padding: 24rpx;

  background: #fff;

  border-radius: 20rpx;

  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);

}



.ach-section-head {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 20rpx;

}



.ach-section-title {

  font-size: 30rpx;

  font-weight: 600;

  color: #2c2c2c;

  margin-bottom: 20rpx;

}



.ach-section-title--inline {

  margin-bottom: 0;

}



.ach-section-extra {

  font-size: 24rpx;

  color: #888;

}



.ach-heatmap-row {

  display: flex;

  align-items: center;

  gap: 8rpx;

  margin-bottom: 6rpx;

}



.ach-heatmap-label {

  width: 28rpx;

  font-size: 20rpx;

  color: #969799;

  flex-shrink: 0;

}



.ach-heatmap-cells {

  flex: 1;

  display: flex;

  gap: 6rpx;

}



.ach-heatmap-cell {

  flex: 1;

  height: 24rpx;

  border-radius: 4rpx;

  background: #ebedf0;

}



.ach-heatmap-legend {

  display: flex;

  gap: 24rpx;

  margin-top: 16rpx;

  font-size: 22rpx;

  color: #969799;

}



.ach-legend-item {

  display: flex;

  align-items: center;

  gap: 8rpx;

}



.ach-legend-box {

  width: 20rpx;

  height: 20rpx;

  border-radius: 4rpx;

  background: #ebedf0;

}



.ach-section-sub {

  margin: -8rpx 0 16rpx;

  font-size: 24rpx;

  color: #888;

  line-height: 1.5;

}



.ach-heatmap-hint {

  margin-top: 16rpx;

  padding: 16rpx 20rpx;

  border-radius: 12rpx;

  background: #fff7e6;

  color: #d48806;

  font-size: 24rpx;

  line-height: 1.5;

}



.ach-heatmap-tip {

  margin-top: 12rpx;

  font-size: 24rpx;

  color: #646566;

}



.ach-badge-grid {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 16rpx;

}



.ach-badge-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.ach-badge-item--locked {
  opacity: 0.45;
  filter: grayscale(1);
}

.ach-badge-emoji {
  font-size: 44rpx;
  line-height: 1.2;
}



.ach-badge-name {

  margin-top: 8rpx;

  font-size: 22rpx;

  color: #646566;

  text-align: center;

  line-height: 1.3;

}



.ach-badge-new {

  position: absolute;

  top: 0;

  right: 0;

  padding: 2rpx 8rpx;

  border-radius: 999rpx;

  background: #ee0a24;

  color: #fff;

  font-size: 18rpx;

}



.ach-actions {

  padding: 0 24rpx 24rpx;

  display: flex;

  flex-direction: column;

  gap: 16rpx;

}



.ach-btn {

  border-radius: 999rpx;

  font-size: 30rpx;

  height: 88rpx;

  line-height: 88rpx;

  border: none;

}



.ach-btn::after {

  border: none;

}



.ach-btn--primary {

  color: #fff;

}



.ach-btn--ghost {

  background: #fff;

  color: #646566;

  border: 1rpx solid #ebedf0;

}



.ach-canvas {

  position: fixed;

  left: -9999px;

  top: 0;

  width: 750px;

  height: 1100px;

}

/* 成就页：从数据面板调整为温和的瑜伽旅程卡片 */
.ach-page { background: #f5f1e9; }
.ach-hero { height: 430rpx; background: #557e69; }
.ach-hero-overlay { background: linear-gradient(to bottom, rgba(24,55,42,.18), rgba(24,55,42,.62)); }
.ach-hero-text { left: 40rpx; bottom: 54rpx; }
.ach-hero-label { font-size: 25rpx; letter-spacing: 4rpx; }
.ach-hero-num { margin-top: 10rpx; font-size: 84rpx; letter-spacing: 2rpx; }
.ach-hero-sub { margin-top: 6rpx; font-size: 25rpx; }
.ach-body { margin-top: -32rpx; }
.ach-stats { margin: 0 28rpx 28rpx; padding: 26rpx 16rpx; border-radius: 28rpx; box-shadow: 0 12rpx 32rpx rgba(73,77,61,.09); }
.ach-stat-card { padding: 12rpx 0; }
.ach-stat-num { font-size: 36rpx; }
.ach-stat-label { font-size: 23rpx; color: #8a8f84; }
.ach-section { margin: 0 28rpx 24rpx; padding: 28rpx; border-radius: 26rpx; background: #fffdf9; box-shadow: 0 8rpx 24rpx rgba(73,77,61,.05); }
.ach-section-title { color: #3c5145; font-size: 31rpx; }
.ach-section-sub { color: #9a9c91; font-size: 23rpx; }
.ach-heatmap-cell { height: 27rpx; border-radius: 7rpx; background: #eee9df; }
.ach-heatmap-cell:active { transform: scale(.86); }
.ach-heatmap-guide { margin-top: 18rpx; color: #9a9c91; font-size: 22rpx; }
.ach-heatmap-legend, .ach-section-extra { color: #92958b; }
.ach-badge-grid { gap: 18rpx; }
.ach-badge-item { min-height: 170rpx; border-radius: 22rpx; background: #f3eee3; border: 1rpx solid #e9dfcd; }
.ach-badge-item--locked { background: #f8f7f3; border-color: #eee; }
.ach-badge-emoji { font-size: 52rpx; }
.ach-badge-name { color: #53675b; font-size: 23rpx; }
.ach-actions { margin: 8rpx 28rpx 36rpx; }
.ach-btn { border-radius: 999rpx; box-shadow: 0 8rpx 18rpx rgba(73,77,61,.08); }
.ach-page { background: #fcfbf8; }
.ach-stats { background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(67,84,73,.06); }
.ach-section { background: #ffffff; box-shadow: 0 6rpx 18rpx rgba(67,84,73,.045); }
.ach-badge-item { background: #f8f6ef; border-color: #eee8db; }
.ach-badge-item--locked { background: #fbfaf8; border-color: #f0efeb; }
.ach-actions { display:flex; flex-direction:row; margin: 12rpx 28rpx 40rpx; padding: 0; gap: 16rpx; }
.ach-btn { flex:1; height: 78rpx; line-height: 78rpx; font-size: 27rpx; box-sizing: border-box; box-shadow: none; }
.ach-btn--primary { background: var(--themeColor, #6fae96) !important; color: #fff; box-shadow: 0 6rpx 14rpx rgba(111,174,150,.22); }
.ach-btn--ghost { background: #fff !important; color: var(--themeColor, #6fae96); border: 1rpx solid var(--themeColor, #6fae96); }
.ach-heatmap-popup { padding: 48rpx 36rpx calc(48rpx + env(safe-area-inset-bottom)); text-align:center; background:#fff; }
.ach-heatmap-popup-icon { width:92rpx; height:92rpx; margin:0 auto 20rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#f2f1ec; }
.ach-heatmap-popup-icon.is-on { background:var(--projectColorLight,#e8f2ed); }
.ach-heatmap-popup-date { display:block; font-size:34rpx; font-weight:600; color:#3c5145; }
.ach-heatmap-popup-status { display:block; margin-top:12rpx; font-size:28rpx; color:#53675b; }
.ach-heatmap-popup-note { display:block; margin-top:18rpx; font-size:24rpx; color:#9a9c91; }



.ach-badge-popup {
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  text-align: center;
  background: #fff;
}



.ach-badge-popup-emoji {
  display: block;
  font-size: 88rpx;
}



.ach-badge-popup-name {

  display: block;

  margin-top: 16rpx;

  font-size: 34rpx;

  font-weight: 600;

  color: #2c2c2c;

}



.ach-badge-popup-desc {

  display: block;

  margin-top: 12rpx;

  font-size: 26rpx;

  color: #888;

}



.ach-badge-popup-done,

.ach-badge-popup-progress {

  margin-top: 24rpx;

  font-size: 28rpx;

  color: #646566;

}
