<page-meta page-style="{{pageStyle}}" />

<view class="orders theme-scope" style="{{pageStyle}}">
	<cmpt-tenant-switch title="购卡订单" theme-color="{{themeColor}}" show-back="{{true}}" />

	<!-- 状态筛选 -->
	<view class="order-tabs">
		<view
			wx:for="{{tabs}}"
			wx:key="key"
			class="order-tab {{activeTab === item.key ? 'is-active' : ''}}"
			data-key="{{item.key}}"
			bindtap="bindTabTap"
		>
			{{item.name}}
			<view wx:if="{{activeTab === item.key}}" class="order-tab-bar"></view>
		</view>
	</view>

	<view wx:if="{{loading}}" class="order-loading">
		<van-loading color="{{themeColor}}">加载中...</van-loading>
	</view>

	<van-empty wx:elif="{{!showList.length}}" description="暂无相关订单" />

	<view wx:else class="order-list">
		<view wx:for="{{showList}}" wx:key="id" class="order-card">
			<!-- 头部：订单号（可复制）+ 状态徽标 -->
			<view class="order-head">
				<view class="order-sn" data-sn="{{item.sn}}" bindtap="bindCopySnTap">
					<text class="order-sn-label">单号</text>
					<text class="order-sn-num">{{item.sn}}</text>
					<text class="order-sn-copy">复制</text>
				</view>
				<text class="order-status order-status--{{item.statusTone}}">{{item.statusDesc}}</text>
			</view>
			<view class="order-meta">{{item.timeText}} · {{item.payTypeDesc}}</view>

			<!-- 套餐 -->
			<view class="order-goods">
				<view
					class="order-goods-cover"
					style="{{item.coverUrl ? '' : 'background:linear-gradient(135deg, ' + item.color + ' 0%, ' + item.colorDark + ' 100%);'}}"
				>
					<image wx:if="{{item.coverUrl}}" class="order-goods-cover-img" src="{{item.coverUrl}}" mode="aspectFill" />
				</view>
				<view class="order-goods-info">
					<view class="order-goods-name">{{item.name}}</view>
					<view class="order-goods-attr">{{item.typeDesc}} · {{item.mainAttr}}</view>
				</view>
				<view class="order-goods-fee">
					<text class="order-fee-cur">¥</text>
					<text class="order-fee-num">{{item.payYuan}}</text>
				</view>
			</view>

			<!-- 线下付款指引 -->
			<view wx:if="{{item.showGuide}}" class="order-guide">
				<van-icon name="info-o" size="26rpx" color="{{themeColor}}" />
				<text>{{item.guide}}</text>
			</view>

			<!-- 银行卡转账订单：账户、凭证和确认进度都在同一张订单里，避免会员下单后找不到下一步 -->
			<view wx:if="{{item.isOfflinePending}}" class="order-transfer">
				<view class="order-transfer-head">
					<view class="order-transfer-titlewrap">
						<text class="order-transfer-title">银行卡转账</text>
						<text class="order-transfer-status {{item.transferProof ? 'is-done' : ''}}">{{item.transferStatusText}}</text>
					</view>
					<van-icon name="certificate" size="34rpx" color="{{themeColor}}" />
				</view>
				<view wx:if="{{item.hasTransferAccount}}" class="order-transfer-account">
					<view wx:if="{{item.transferAccount.receiver}}" class="order-transfer-row">
						<text class="order-transfer-label">收款人</text>
						<text class="order-transfer-value">{{item.transferAccount.receiver}}</text>
					</view>
					<view wx:if="{{item.transferAccount.bank}}" class="order-transfer-row">
						<text class="order-transfer-label">开户行</text>
						<text class="order-transfer-value">{{item.transferAccount.bank}}</text>
					</view>
					<view wx:if="{{item.transferAccount.account}}" class="order-transfer-row">
						<text class="order-transfer-label">银行卡号</text>
						<text class="order-transfer-value">{{item.transferAccount.account}}</text>
						<text class="order-copy" data-account="{{item.transferAccount.account}}" catchtap="bindCopyAccountTap">复制</text>
					</view>
				</view>
				<view class="order-proof-row">
					<image
						wx:if="{{item.transferProof}}"
						class="order-proof-image"
						src="{{item.transferProof}}"
						mode="aspectFill"
						data-url="{{item.transferProof}}"
						catchtap="bindPreviewProofTap"
					/>
					<view wx:else class="order-proof-placeholder">
						<van-icon name="photo-o" size="34rpx" color="{{themeColor}}" />
						<text>上传凭证</text>
					</view>
					<view class="order-proof-action" data-id="{{item.id}}" catchtap="bindUploadProofTap">{{item.transferProof ? '更新凭证' : '上传转账凭证'}}</view>
				</view>
				<text wx:if="{{item.transferReference}}" class="order-transfer-reference">转账备注：{{item.transferReference}}</text>
			</view>
	
				<!-- 底部操作：仅待支付订单需要动作，其余状态信息已完整 -->
				<view wx:if="{{item.canPay}}" class="order-foot">
					<view class="order-btn order-btn--main" data-id="{{item.id}}" bindtap="bindRepayTap">继续支付</view>
				</view>
		</view>
	</view>
</view>
