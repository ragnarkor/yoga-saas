<page-meta page-style="{{pageStyle}}" />

<view class="orders theme-scope" style="{{pageStyle}}">
	<cmpt-tenant-switch title="购卡订单" theme-color="{{themeColor}}" show-back="{{true}}" />

	<!-- 状态筛选 -->
	<view class="order-tabs">
		<view
			wx:for="{{tabs}}"
			wx:key="key"
			class="order-tab {{activeTab === item.key ? 'is-active' : ''}}"
			style="{{activeTab === item.key ? 'color:' + themeColor + ';font-weight:600;' : ''}}"
			data-key="{{item.key}}"
			bindtap="bindTabTap"
		>
			{{item.name}}
			<view wx:if="{{activeTab === item.key}}" class="order-tab-bar" style="background:{{themeColor}}"></view>
		</view>
	</view>

	<view wx:if="{{loading}}" class="order-loading">
		<van-loading color="{{themeColor}}">加载中...</van-loading>
	</view>

	<van-empty wx:elif="{{!showList.length}}" description="暂无相关订单" />

	<view wx:else class="order-list">
		<view wx:for="{{showList}}" wx:key="id" class="order-card">
			<view class="order-head">
				<text class="order-sn">下单时间：{{item.timeText}}</text>
				<text class="order-status order-status--{{item.statusTone}}">{{item.statusDesc}}</text>
			</view>

			<view class="order-goods">
				<view
					class="order-goods-cover"
					style="background:linear-gradient(135deg, {{item.color}} 0%, {{item.colorDark}} 100%);"
				>
					<text class="order-goods-type">{{item.typeDesc}}</text>
				</view>
				<view class="order-goods-info">
					<view class="order-goods-name">{{item.name}}</view>
					<view class="order-goods-attr">{{item.mainAttr}}</view>
				</view>
				<view class="order-goods-fee">
					<view class="order-fee">
						<text class="order-fee-cur">¥</text>
						<text class="order-fee-num">{{item.payYuan}}</text>
					</view>
					<text class="order-pay-type">{{item.payType === 'wechat' ? '微信支付' : '线下付款'}}</text>
				</view>
			</view>

			<view wx:if="{{item.showGuide}}" class="order-guide">
				<van-icon name="info-o" size="26rpx" color="{{themeColor}}" />
				<text>{{item.guide}}</text>
			</view>

			<!-- 银行卡转账订单：账户、凭证和确认进度都在同一张订单里，避免会员下单后找不到下一步 -->
			<view wx:if="{{item.isOfflinePending}}" class="order-transfer">
				<view class="order-transfer-head">
					<view>
						<text class="order-transfer-title">银行卡转账</text>
						<text class="order-transfer-status {{item.transferProof ? 'is-done' : ''}}">{{item.transferStatusText}}</text>
					</view>
					<van-icon name="certificate" size="34rpx" color="{{themeColor}}" />
				</view>
				<view wx:if="{{item.hasTransferAccount}}" class="order-transfer-account">
					<view wx:if="{{item.transferAccount.receiver}}" class="order-transfer-row"><text>收款人</text><text>{{item.transferAccount.receiver}}</text></view>
					<view wx:if="{{item.transferAccount.bank}}" class="order-transfer-row"><text>开户行</text><text>{{item.transferAccount.bank}}</text></view>
					<view wx:if="{{item.transferAccount.account}}" class="order-transfer-row order-transfer-row--account"><text>银行卡号</text><text>{{item.transferAccount.account}}</text><text class="order-copy" data-account="{{item.transferAccount.account}}" catchtap="bindCopyAccountTap">复制</text></view>
				</view>
				<view class="order-proof-row">
					<image wx:if="{{item.transferProof}}" class="order-proof-image" src="{{item.transferProof}}" mode="aspectFill" data-url="{{item.transferProof}}" catchtap="bindPreviewProofTap" />
					<view wx:else class="order-proof-placeholder"><van-icon name="photo-o" size="36rpx" color="#b8c0bb" /><text>上传银行转账凭证</text></view>
					<view class="order-proof-action" style="color:{{themeColor}};border-color:{{themeColor}}" data-id="{{item.id}}" catchtap="bindUploadProofTap">{{item.transferProof ? '更新凭证' : '上传凭证'}}</view>
				</view>
				<text wx:if="{{item.transferReference}}" class="order-transfer-reference">转账备注：{{item.transferReference}}</text>
			</view>

			<view wx:if="{{item.canPay || item.canGoPack}}" class="order-foot">
				<view wx:if="{{item.canGoPack}}" class="order-btn order-btn--ghost" bindtap="bindGoPackTap">查看卡包</view>
				<view
					wx:if="{{item.canPay}}"
					class="order-btn order-btn--main"
					style="background:{{themeColor}}"
					data-id="{{item.id}}"
					bindtap="bindRepayTap"
				>继续支付</view>
			</view>
		</view>
	</view>
</view>
