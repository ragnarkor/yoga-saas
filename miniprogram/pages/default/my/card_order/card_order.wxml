<view class="orders"><van-empty wx:if="{{!loading && !list.length}}" description="暂无购卡申请"/><view wx:for="{{list}}" wx:key="ORDER_ID" class="order"><text class="name">{{item.ORDER_TPL_NAME}}</text><text class="status">{{item.ORDER_STATUS === 10 ? '已发卡' : item.ORDER_STATUS === 20 ? '已关闭' : '待馆方确认'}}</text><text class="price">¥{{item.ORDER_PAY_FEE / 100}}</text><text class="guide">{{item.ORDER_PAY_GUIDE}}</text></view></view>
