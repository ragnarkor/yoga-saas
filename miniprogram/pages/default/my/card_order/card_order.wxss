.orders {
  min-height: 100vh;
  background: var(--neutralBg, #f5f6f8);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 状态筛选 tab：sticky 白底，指示条贴住分隔线 ===== */
.order-tabs {
  display: flex;
  align-items: stretch;
  background: var(--neutralSurface, #ffffff);
  padding: 0 8rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--neutralBorder, #e8e9eb);
}

.order-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--neutralTextSecondary, #646a73);
  padding: 24rpx 0 20rpx;
  position: relative;
  transition: color 0.2s ease;
}

.order-tab.is-active {
  color: var(--themeColor, #5b8a72);
  font-weight: 600;
}

.order-tab-bar {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -1rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--themeColor, #5b8a72);
}

.order-loading {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

/* ===== 订单卡片 ===== */
.order-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  background: var(--neutralSurface, #ffffff);
  border-radius: 24rpx;
  padding: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx var(--neutralShadow, rgba(31, 35, 41, 0.06));
}

/* 头部：订单号 + 状态徽标 */
.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 0 12rpx;
}

.order-sn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.order-sn-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--neutralTextTertiary, #8f959e);
}

.order-sn-num {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  color: var(--neutralTextSecondary, #646a73);
}

.order-sn-copy {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--neutralIconBg, #f2f3f5);
  color: var(--neutralTextSecondary, #646a73);
  font-size: 20rpx;
}

/* 状态徽标：浅底胶囊，四色收敛 */
.order-status {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.order-status--warn {
  background: #fff4e5;
  color: #c77700;
}

.order-status--info {
  background: var(--projectColorLight, #e8f2ed);
  color: var(--themeColor, #5b8a72);
}

.order-status--ok {
  background: #e6f6ec;
  color: #1e9e52;
}

.order-status--muted {
  background: var(--neutralIconBg, #f2f3f5);
  color: var(--neutralTextTertiary, #8f959e);
}

/* 时间 + 支付方式 */
.order-meta {
  font-size: 22rpx;
  color: var(--neutralTextTertiary, #8f959e);
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--neutralIconBg, #f2f3f5);
}

/* ===== 套餐行 ===== */
.order-goods {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.order-goods-cover {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.12);
}

/* 封面与卡包页卡面统一：快照有 cover（预设/自定义）用图，否则纯色渐变 */
.order-goods-cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.order-goods-info {
  flex: 1;
  min-width: 0;
}

.order-goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--neutralText, #1f2329);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-goods-attr {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--neutralTextTertiary, #8f959e);
}

.order-goods-fee {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.order-fee-cur {
  font-size: 22rpx;
  color: var(--neutralText, #1f2329);
}

.order-fee-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--neutralText, #1f2329);
}

/* ===== 线下付款指引：主题浅底提示条 ===== */
.order-guide {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: var(--projectColorLight, #e8f2ed);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: var(--neutralTextSecondary, #646a73);
  line-height: 1.5;
}

.order-guide van-icon {
  flex-shrink: 0;
  margin-top: 2rpx;
}

/* ===== 银行转账面板：让会员在订单内完成付款信息查看与凭证提交 ===== */
.order-transfer {
  margin-top: 4rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--neutralBg, #f5f6f8);
}

.order-transfer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-transfer-titlewrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-transfer-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--neutralText, #1f2329);
}

.order-transfer-status {
  font-size: 22rpx;
  color: #c77700;
}

.order-transfer-status.is-done {
  color: var(--themeColor, #5b8a72);
}

.order-transfer-account {
  margin-top: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  background: var(--neutralSurface, #ffffff);
}

.order-transfer-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 56rpx;
}

.order-transfer-row + .order-transfer-row {
  border-top: 1rpx solid var(--neutralIconBg, #f2f3f5);
}

.order-transfer-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--neutralTextTertiary, #8f959e);
}

.order-transfer-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  word-break: break-all;
  font-size: 24rpx;
  color: var(--neutralText, #1f2329);
}

.order-copy {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--projectColorLight, #e8f2ed);
  color: var(--themeColor, #5b8a72);
  font-size: 20rpx;
}

/* 凭证：108rpx 缩略位 + 实底主行动按钮（该状态唯一 CTA） */
.order-proof-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.order-proof-image {
  width: 108rpx;
  height: 108rpx;
  border-radius: 16rpx;
  flex: 0 0 auto;
  background: var(--neutralIconBg, #f2f3f5);
  border: 1rpx solid var(--neutralBorder, #e8e9eb);
  box-sizing: border-box;
}

.order-proof-placeholder {
  width: 108rpx;
  height: 108rpx;
  border-radius: 16rpx;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--neutralTextTertiary, #8f959e);
  background: var(--neutralSurface, #ffffff);
  border: 2rpx dashed var(--neutralBorder, #e8e9eb);
  box-sizing: border-box;
  font-size: 20rpx;
}

.order-proof-action {
  margin-left: auto;
  height: 64rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: var(--themeColor, #5b8a72);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
}

.order-transfer-reference {
  display: block;
  margin-top: 14rpx;
  color: var(--neutralTextTertiary, #8f959e);
  font-size: 22rpx;
}

/* ===== 底部操作 ===== */
.order-foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--neutralIconBg, #f2f3f5);
}

.order-btn {
  min-width: 176rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.order-btn--main {
  background: var(--themeColor, #5b8a72);
  color: #ffffff;
  font-weight: 500;
}
