.orders {
  min-height: 100vh;
  background: #f6f7f8;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 状态筛选 tab */
.order-tabs {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 0 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.order-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #646566;
  padding: 24rpx 0 20rpx;
  position: relative;
}

.order-tab-bar {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 6rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
}

.order-loading {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

/* 订单卡片 */
.order-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f1f2;
}

.order-sn {
  font-size: 24rpx;
  color: #969799;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

.order-status--warn {
  color: #ff9c3f;
}

.order-status--info {
  color: #576b95;
}

.order-status--ok {
  color: #07c160;
}

.order-status--muted {
  color: #969799;
}

/* 商品行 */
.order-goods {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.order-goods-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.order-goods-type {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.order-goods-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.order-goods-name {
  font-size: 30rpx;
  color: #323233;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-goods-attr {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.order-goods-fee {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.order-fee {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}

.order-fee-cur {
  font-size: 22rpx;
  color: #323233;
}

.order-fee-num {
  font-size: 32rpx;
  color: #323233;
  font-weight: 600;
}

.order-pay-type {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #969799;
}

/* 线下付款指引 */
.order-guide {
  display: flex;
  align-items: flex-start;
  background: #f7f8f9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #646566;
  line-height: 1.5;
}

.order-guide van-icon {
  flex-shrink: 0;
  margin-right: 8rpx;
  margin-top: 2rpx;
}

/* 银行转账进度：让会员在订单内完成付款信息查看与凭证提交 */
.order-transfer { margin-top: 2rpx; padding: 20rpx; border-radius: 16rpx; background: #f8faf8; }
.order-transfer-head { display:flex; align-items:center; justify-content:space-between; }
.order-transfer-title { display:block; color:#36443c; font-size:27rpx; font-weight:600; }
.order-transfer-status { display:block; margin-top:6rpx; color:#a87937; font-size:22rpx; }
.order-transfer-status.is-done { color:#4f9871; }
.order-transfer-account { margin-top:16rpx; padding:12rpx 16rpx; border-radius:12rpx; background:#fff; }
.order-transfer-row { display:flex; align-items:center; gap:16rpx; min-height:48rpx; color:#69756d; font-size:23rpx; }
.order-transfer-row text:last-child:not(.order-copy) { flex:1; min-width:0; color:#34423a; text-align:right; word-break:break-all; }
.order-transfer-row--account { border-top:1rpx solid #f0f2f0; }
.order-copy { margin-left:10rpx; padding:4rpx 12rpx; color:var(--themeColor,#5b8a72); border-radius:999rpx; background:var(--projectColorLight,#e8f2ed); font-size:21rpx; }
.order-proof-row { display:flex; align-items:center; gap:16rpx; margin-top:16rpx; }
.order-proof-image,.order-proof-placeholder { width:92rpx; height:92rpx; border-radius:12rpx; flex:0 0 auto; }
.order-proof-image { background:#edf0ed; }
.order-proof-placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; color:#9aa49e; background:#fff; font-size:19rpx; }
.order-proof-action { margin-left:auto; padding:13rpx 20rpx; border:1rpx solid; border-radius:999rpx; font-size:24rpx; }
.order-transfer-reference { display:block; margin-top:12rpx; color:#88928c; font-size:22rpx; }

/* 底部操作 */
.order-foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f1f2;
}

.order-btn {
  min-width: 160rpx;
  height: 60rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.order-btn--ghost {
  color: #323233;
  border: 1rpx solid #dcdee0;
  background: #ffffff;
}

.order-btn--main {
  color: #ffffff;
}
