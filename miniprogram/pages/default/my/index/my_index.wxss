@import "../../skin/skin.wxss";
@import "../../../../style/project/my_index_base.wxss";

.main {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/*投影*/
.main .upside {
  height: 450rpx;
  padding: 0;
}

.main .down {
  margin-top: -130rpx;
  z-index: 3;
}

.avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  background: rgba(255, 255, 255, 0.95);
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder van-icon {
  line-height: 1;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.name-text {
  width: 100%;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  height: 52rpx;
  line-height: 52rpx;
  display: flex;
  align-items: center;
}

.name-edit-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.65);
  margin-left: 12rpx;
}

.profile-arrow {
  margin-left: auto;
  flex-shrink: 0;
}

.main .upside .user-bar {
  align-items: center;
  padding-right: 32rpx;
  z-index: 2;
}

/* 菜单列表图标：统一主题色，次要项略降透明度 */
.menu-group .van-icon {
  color: var(--themeColor, #5b8a72) !important;
}

.menu-group .mi-coach .van-icon,
.menu-group .mi-setting .van-icon {
  opacity: 0.82;
}
