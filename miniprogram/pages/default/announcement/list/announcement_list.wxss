.announce-list-page {
  min-height: 100vh;
  background: var(--neutralBg, #f5f6f8);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 空状态 ---------- */
.announce-list-empty {
  min-height: 50vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

/* ---------- 列表卡片 ---------- */
.announce-list {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(91, 138, 114, 0.08);
}

.announce-list-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--neutralBorderLight, #f0f1f3);
  transition: background-color 0.2s ease;
}

.announce-list-item:last-child {
  border-bottom: none;
}

.announce-list-item:active {
  background: var(--neutralIconBg, #f7f8fa);
}

/* ---------- 公告图标徽章 ---------- */
.announce-list-item-icon {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin-top: 4rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--projectColorLight, #e8f2ed);
}

.announce-list-item-main {
  flex: 1;
  min-width: 0;
}

/* ---------- 标题行 ---------- */
.announce-list-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.announce-list-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--neutralText, #323233);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.announce-list-badge {
  flex: none;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--themeColor, #6fae96);
  background: var(--projectColorLight, #e8f2ed);
}

/* ---------- 摘要：两行截断 ---------- */
.announce-list-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--neutralTextSecondary, #969799);
  line-height: 1.45;
}

/* ---------- 发布人 · 时间 ---------- */
.announce-list-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--neutralTextSecondary, #969799);
}

.announce-list-meta-sep {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #c8c9cc;
}

/* ---------- 触底加载状态 ---------- */
.announce-list-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0 6rpx;
}

.announce-list-more-text {
  font-size: 22rpx;
  color: var(--neutralTextSecondary, #969799);
}

/* ---------- 右侧箭头 ---------- */
.announce-list-arrow {
  flex: none;
  align-self: center;
  display: flex;
}

/* ---------- 加载骨架 ---------- */
@keyframes announce-skeleton-breath {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 0.9;
  }
}

.announce-skeleton-icon,
.announce-skeleton-line {
  background: #eef0f2;
  animation: announce-skeleton-breath 1.2s ease-in-out infinite;
}

.announce-skeleton-icon {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
}

.announce-skeleton-line {
  height: 22rpx;
  border-radius: 8rpx;
}

.announce-skeleton-line--title {
  width: 70%;
}

.announce-skeleton-line--desc {
  width: 90%;
  margin-top: 14rpx;
}

.announce-skeleton-line--meta {
  width: 32%;
  margin-top: 14rpx;
}
