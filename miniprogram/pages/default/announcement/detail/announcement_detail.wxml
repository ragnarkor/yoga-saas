<page-meta page-style="{{pageStyle}}" />
<view class="theme-scope" style="{{pageStyle}}">
  <cmpt-tenant-switch title="公告详情" show-back="{{true}}" theme-color="{{themeColor}}" />

  <view wx:if="{{!isLoad}}" class="loading-wrap">
    <van-loading size="48rpx" color="{{themeColor}}" />
  </view>

  <view wx:elif="{{loadError}}" class="loading-wrap">
    <van-empty description="加载失败，请重试" />
  </view>

  <view wx:elif="{{!detail}}" class="loading-wrap">
    <van-empty description="公告不存在" />
  </view>

  <view class="announce-detail" wx:else>
    <view class="announce-article">
      <view class="title">{{detail.title}}</view>
      <view class="desc" wx:if="{{detail.desc}}">{{detail.desc}}</view>
      <view class="announce-meta" wx:if="{{detail.authorName || detail.publishTime}}">
        <view class="announce-author-avatar" wx:if="{{detail.authorName}}">
          <image wx:if="{{detail.authorAvatar}}" src="{{detail.authorAvatar}}" mode="aspectFill" />
          <text wx:else>{{detail.authorName.slice(0, 1)}}</text>
        </view>
        <text>{{detail.authorName}}</text>
        <text wx:if="{{detail.publishTime}}">{{detail.publishTime}}</text>
      </view>
      <view class="announce-divider" />
      <view class="announce-content">
        <rich-text wx:if="{{detail.contentDelta}}" nodes="{{contentNodes}}" class="content-rich" />
        <block wx:else>
          <view class="content" wx:for="{{detail.content}}" wx:key="index">
            <text wx:if="{{item.type=='text'}}">{{item.val}}</text>
            <image wx:if="{{item.type=='img'}}" bindtap="url" data-url="{{item.val}}" data-type="img" src="{{item.val}}" mode="widthFix" class="content-image" aria-role="button" aria-label="查看图片，点击放大" />
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
