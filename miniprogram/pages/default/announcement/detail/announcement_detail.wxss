.loading-wrap {
  padding: 120rpx 32rpx;
  display: flex;
  justify-content: center;
}

.announce-detail {
  padding: 38rpx 36rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #fff;
  min-height: calc(100vh - 120rpx);
  box-sizing: border-box;
}

.announce-article {
  padding: 0;
}

.title {
  margin-top: 0;
  font-size: 40rpx;
  font-weight: 700;
  color: #2d332e;
  line-height: 1.38;
  letter-spacing: .5rpx;
}

.desc {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-left: 6rpx solid var(--themeColor, #6fae96);
  border-radius: 0 12rpx 12rpx 0;
  background: #f4f7f4;
  font-size: 27rpx;
  line-height: 1.7;
  color: #65736a;
}

.announce-meta {
  display:flex;
  align-items:center;
  gap:18rpx;
  margin-top:22rpx;
  color:#a1a9a2;
  font-size:22rpx;
}
.announce-author-avatar { width:34rpx; height:34rpx; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:50%; background:#e8f0e9; color:#5d806b; font-size:18rpx; }
.announce-author-avatar image { width:100%; height:100%; }

.announce-divider {
  height: 1rpx;
  margin: 32rpx 0 4rpx;
  background: #edf0ec;
}

.announce-content {
  padding-top: 8rpx;
}

.content {
  margin-top: 26rpx;
  font-size: 29rpx;
  line-height: 1.9;
  color: #4d5a52;
  white-space: pre-wrap;
}

.content-rich {
  display: block;
  margin-top: 18rpx;
  font-size: 29rpx;
  line-height: 1.9;
  color: #4d5a52;
}

.content-image {
  display: block;
  width: 100%;
  margin: 28rpx 0 4rpx;
  border-radius: 16rpx;
  background: #f2f3f1;
}
