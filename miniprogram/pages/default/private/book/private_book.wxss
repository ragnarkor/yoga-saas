.private-book-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pb-section {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.mcp-in-section {
  border-bottom: 1rpx solid #f3f3f3;
  padding: 24rpx 28rpx;
}

.pb-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pb-field:last-child {
  border-bottom: none;
}

.pb-field.coach-picker-field {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pb-field.coach-picker-field .coach-picker-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #646566;
}

.pb-field.coach-picker-field .coach-picker-value-wrap {
  flex: 1;
}

.pb-section-title {
  padding: 24rpx 32rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}

.pb-date-scroll {
  width: 100%;
}

.pb-date-list {
  display: flex;
  padding: 0 24rpx 20rpx;
  gap: 16rpx;
}

.pb-date-item {
  flex-shrink: 0;
  width: 104rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f7f8fa;
  text-align: center;
}

.pb-date-item.is-active {
  background: var(--projectColorLight, #e8f2ed);
  box-shadow: inset 0 0 0 2rpx var(--projectColor, #6fae96);
}

.pb-date-week {
  display: block;
  font-size: 22rpx;
  color: #969799;
}

.pb-date-day {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}

.pb-hint {
  padding: 0 32rpx 24rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}

.pb-schedule-link {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 32rpx 38rpx;
  margin: -14rpx 0 -14rpx;
  color: var(--projectColor, #6fae96);
  font-size: 26rpx;
}

.pb-schedule-link text {
  flex: 1;
}

.pb-day-schedule-sheet {
  padding: 28rpx 28rpx 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.pb-day-schedule-head {
  padding: 8rpx 8rpx 24rpx;
}

.pb-day-schedule-title,
.pb-day-schedule-sub {
  display: block;
}

.pb-day-schedule-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.pb-day-schedule-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.pb-day-schedule-list {
  max-height: 58vh;
  /* 左右各留 5rpx，避免 .pb-day-schedule-row::before 的负 inset 命中区被 scroll-view 裁切 */
  padding: 0 5rpx;
  box-sizing: border-box;
}

.pb-day-schedule-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.pb-day-schedule-row::before {
  content: "";
  position: absolute;
  inset: -5rpx;
}

.pb-day-schedule-row--available {
  color: #2d6a4f;
  background: #eef8f2;
}

.pb-day-schedule-time {
  font-weight: 600;
}

.pb-day-schedule-status {
  font-size: 24rpx;
}

.pb-day-schedule-legend {
  display: flex;
  gap: 28rpx;
  padding: 20rpx 8rpx 24rpx;
  color: #969799;
  font-size: 23rpx;
}

.pb-section--slots {
  padding-bottom: 8rpx;
}

.pb-slots-loading,
.pb-slots-empty {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #969799;
}

.pb-custom-time {
  margin: 0 24rpx 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
}

.pb-custom-time-label {
  font-size: 24rpx;
  color: #969799;
}

.pb-custom-time-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.pb-custom-time-hint {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #969799;
}

.pb-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.pb-card-hint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #969799;
}

.pb-sheet-actions {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.pb-card-sheet {
  padding: 24rpx 24rpx 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.pb-card-sheet-head {
  padding: 8rpx 8rpx 24rpx;
}

.pb-card-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.pb-card-sheet-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.pb-card-sheet-scroll {
  max-height: 52vh;
  box-sizing: border-box;
}

.pb-card-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pb-card-option.is-selected {
  background: rgba(111, 174, 150, 0.06);
  border-radius: 16rpx;
}

.pb-card-option-visual {
  position: relative;
  flex-shrink: 0;
  width: 88rpx;
  height: 56rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.pb-card-option-img,
.pb-card-option-solid {
  width: 100%;
  height: 100%;
  display: block;
}

.pb-card-option-type {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.pb-card-option-body {
  flex: 1;
  min-width: 0;
}

.pb-card-option-name {
  display: block;
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
}

.pb-card-option-balance {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #969799;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
}
