<page-meta page-style="{{pageStyle}}" />
<view class="theme-scope private-book-page" style="{{pageStyle}}">
  <cmpt-tenant-switch title="预约私教" show-back="{{true}}" theme-color="{{themeColor}}" />

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading size="48rpx" color="{{themeColor}}">加载中...</van-loading>
  </view>

  <van-empty wx:elif="{{!courses.length}}" description="暂无私教课程，请联系馆方" />

  <block wx:else>
    <view class="pb-section">
      <meet-course-picker
        value="{{form.meetId}}"
        courses="{{courses}}"
        load-from="none"
        theme-color="{{themeColor}}"
        label="私教课程"
        sheet-title="选择私教课程"
        placeholder="请选择"
        field-class="mcp-in-section"
        bind:pick="onCoursePick"
        bind:sheetchange="onPickerSheetChange"
      />
      <coach-picker
        id-mode="teacher"
        value="{{form.teacherId}}"
        teachers="{{teachers}}"
        theme-color="{{themeColor}}"
        label="授课教练"
        field-class="pb-field"
        bind:pick="onCoachPick"
        bind:sheetchange="onPickerSheetChange"
      />
    </view>

    <view class="pb-section">
      <view class="pb-section-title">选择日期</view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="pb-date-scroll">
        <view class="pb-date-list" aria-role="tablist">
          <view
            class="pb-date-item {{form.day === item.day ? 'is-active' : ''}}"
            wx:for="{{dateList}}"
            wx:key="day"
            data-day="{{item.day}}"
            bindtap="bindDayTap"
            aria-role="button"
            aria-selected="{{form.day === item.day}}"
            aria-label="{{item.shortLabel}} {{item.weekday}}"
          >
            <text class="pb-date-week">{{item.weekday}}</text>
            <text class="pb-date-day">{{item.shortLabel}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="pb-hint">{{scheduleHint}}</view>
      <view class="pb-schedule-link" bindtap="bindViewScheduleTap" aria-role="button" aria-label="查看{{form.teacherName || '教练'}}当天排班">
        <van-icon name="calendar-o" size="30rpx" color="{{themeColor}}" />
        <text>查看{{form.teacherName || '教练'}}当天排班</text>
        <van-icon name="arrow" size="26rpx" color="#c8c9cc" />
      </view>
    </view>

    <view class="pb-section pb-section--slots">
      <view class="pb-section-title">选择时间</view>
      <view class="pb-custom-time">
        <view class="pb-custom-time-label">开始时间</view>
        <picker mode="time" value="{{form.start || '09:00'}}" bindchange="bindCustomTimeChange">
          <view class="pb-custom-time-picker">
            <text wx:if="{{form.start && form.end}}">{{form.start}}–{{form.end}}</text>
            <text wx:else>{{form.start || '请选择时间'}}</text>
            <van-icon name="arrow" size="26rpx" color="#c8c9cc" />
          </view>
        </picker>
        <view wx:if="{{customTimeHint}}" class="pb-custom-time-hint">{{customTimeHint}}</view>
      </view>
    </view>

    <view class="pb-footer" wx:if="{{!cardSheetShow && !pickerSheetOpen}}">
      <view wx:if="{{cardHint}}" class="pb-card-hint">
        <van-icon name="info-o" size="28rpx" color="#969799" />
        <text>{{cardHint}}</text>
      </view>
      <van-button
        block
        round
        color="{{themeColor}}"
        loading="{{submitting}}"
        disabled="{{!form.start || !form.end || submitting || !cardCanBook}}"
        bind:click="bindSubmitTap"
      >
        {{submitBtnText}}
      </van-button>
    </view>
  </block>

  <van-popup
    show="{{dayScheduleShow}}"
    position="bottom"
    round
    closeable
    bind:close="bindDayScheduleClose"
  >
    <view class="pb-day-schedule-sheet">
      <view class="pb-day-schedule-head">
        <view>
          <text class="pb-day-schedule-title">{{form.teacherName || '教练'}}当天排班</text>
          <text class="pb-day-schedule-sub">{{form.day}} · 30分钟快速选择</text>
        </view>
      </view>
      <view wx:if="{{dayScheduleLoading}}" class="pb-slots-loading">
        <van-loading size="40rpx" color="{{themeColor}}">加载排班中...</van-loading>
      </view>
      <view wx:elif="{{dayScheduleError}}" class="pb-slots-empty">{{dayScheduleError}}</view>
      <scroll-view wx:else scroll-y class="pb-day-schedule-list">
        <view
          wx:for="{{dayQuickSlots}}"
          wx:key="start"
          class="pb-day-schedule-row pb-day-schedule-row--available"
          data-start="{{item.start}}"
          data-end="{{item.end}}"
          bindtap="bindQuickScheduleSlotTap"
        >
          <text class="pb-day-schedule-time">{{item.start}}–{{item.end}}</text>
          <text class="pb-day-schedule-status">快速选择</text>
        </view>
      </scroll-view>
      <view wx:if="{{!dayScheduleLoading && !dayScheduleError && !dayQuickSlots.length}}" class="pb-slots-empty">当天没有可快速选择的时段，请在下方选择时间。</view>
      <view class="pb-day-schedule-legend">每 30 分钟推荐一个可预约开始时间</view>
    </view>
  </van-popup>

  <van-popup show="{{cardSheetShow}}" position="bottom" round bind:close="bindCloseCardSheet">
    <view class="pb-card-sheet">
      <view class="pb-card-sheet-head">
        <text class="pb-card-sheet-title">选择划扣会员卡</text>
        <text class="pb-card-sheet-sub">本次预约需扣 {{cardNeedTimes}} 次</text>
      </view>
      <view wx:if="{{cardPickLoading}}" class="pb-slots-loading">
        <van-loading size="40rpx" color="{{themeColor}}" />
      </view>
      <scroll-view wx:else scroll-y class="pb-card-sheet-scroll">
        <view
          class="pb-card-option {{selectedCardId === item.id ? 'is-selected' : ''}}"
          wx:for="{{joinCardOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="bindCardPick"
        >
          <view class="pb-card-option-visual">
            <image
              wx:if="{{item.coverUrl}}"
              class="pb-card-option-img"
              src="{{item.coverUrl}}"
              mode="aspectFill"
            />
            <view
              wx:else
              class="pb-card-option-solid"
              style="background: {{item.color}};"
            ></view>
            <text class="pb-card-option-type">{{item.typeLabel}}</text>
          </view>
          <view class="pb-card-option-body">
            <text class="pb-card-option-name">{{item.name}}</text>
            <text class="pb-card-option-balance">{{item.balanceText}}</text>
          </view>
          <van-icon wx:if="{{selectedCardId === item.id}}" name="success" size="40rpx" color="{{themeColor}}" />
        </view>
      </scroll-view>
      <view class="pb-sheet-actions">
        <van-button block round color="{{themeColor}}" bind:click="bindConfirmBookTap">确认预约并扣卡</van-button>
      </view>
    </view>
  </van-popup>
</view>
