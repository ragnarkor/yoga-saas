@import "../coach_common.wxss";
.room-page{min-height:100vh;padding-bottom:160rpx}.room-loading,.room-empty{padding:120rpx 32rpx;text-align:center}.room-empty{display:flex;flex-direction:column;align-items:center}.room-list{padding:24rpx 32rpx}.room-swipe-cell{display:block;margin-bottom:20rpx;border-radius:20rpx!important;overflow:hidden}.room-card{display:flex;align-items:center;gap:20rpx;min-height:126rpx;box-sizing:border-box;padding:22rpx 24rpx;background:#fff;border-left:8rpx solid var(--themeColor,#5b8a72);box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}.room-card:active{opacity:.9}.room-card-icon{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;border-radius:16rpx;flex:0 0 auto}.room-card-info{flex:1;min-width:0}.room-card-title-row{display:flex;align-items:center;gap:12rpx}.room-card-name{max-width:290rpx;overflow:hidden;color:#333;font-size:31rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.room-card-state{padding:3rpx 10rpx;border-radius:999rpx;background:var(--themeColorLight,#edf7f0);color:var(--themeColor,#5b8a72);font-size:20rpx}.room-card-state--off{background:#f4f4f4;color:#999}.room-card-meta,.room-card-equipment{display:block;overflow:hidden;margin-top:8rpx;color:#999;font-size:23rpx;text-overflow:ellipsis;white-space:nowrap}.room-card-equipment{margin-top:5rpx;color:#aaa;font-size:21rpx}.room-swipe-delete{display:flex;align-items:center;justify-content:center;width:72px;height:100%;background:#ee0a24;color:#fff;font-size:28rpx;font-weight:500}.room-fab{position:fixed;right:40rpx;bottom:calc(140rpx + env(safe-area-inset-bottom));z-index:100;display:flex;align-items:center;justify-content:center;width:100rpx;height:100rpx;border-radius:50%;box-shadow:0 8rpx 24rpx rgba(0,0,0,.15)}.room-fab:active{transform:scale(.94)}
