@import "../coach_member_card.wxss";
@import "../course/coach_course_edit.wxss";

.card-edit-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.card-cover-thumb {
  width: 72rpx;
  height: 44rpx;
  border-radius: 10rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.card-cover-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-edit-preview {
  padding: 8rpx 32rpx 24rpx;
}

.card-edit-preview-label {
  font-size: 24rpx;
  color: #969799;
  margin-bottom: 12rpx;
}

.card-edit-preview-chip {
  position: relative;
  width: 220rpx;
  height: 132rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.1);
}

.card-edit-preview-img,
.card-edit-preview-solid {
  width: 100%;
  height: 100%;
  display: block;
}

.card-edit-preview-type {
  position: absolute;
  left: 12rpx;
  bottom: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.card-cover-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 20rpx;
}

.card-cover-upload {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0 24rpx 20rpx;
  min-height: 116rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border: 2rpx dashed var(--themeColorLight, #d9e1dc);
  border-radius: 16rpx;
  background: var(--neutralBg, #fafcfb);
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.card-cover-upload.active,
.card-cover-upload.uploading {
  border-style: solid;
  border-color: var(--themeColor, #5b8a72);
}

.card-cover-upload.active {
  background: var(--projectColorLight, #e5f1ec);
}

.card-cover-upload.uploading {
  background: var(--neutralBg, #fafcfb);
}

/* 上传槽位：固定卡面比例的缩略位，图标/加载指示居中，不再放文字避免溢出 */
.card-cover-upload-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 76rpx;
  border-radius: 10rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--themeColorLight, #eef3f0);
}

.card-cover-upload.active .card-cover-upload-slot {
  background: rgba(255, 255, 255, 0.72);
}

.card-cover-upload-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-cover-upload van-icon,
.card-cover-upload van-loading {
  flex-shrink: 0;
}

.card-cover-upload-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
  color: var(--neutralText, #323233);
  font-size: 26rpx;
}

.card-cover-upload-tip {
  color: var(--neutralTextTertiary, #969799);
  font-size: 21rpx;
}

.card-cover-item {
  position: relative;
  width: calc(50% - 8rpx);
  border-radius: 16rpx;
  overflow: hidden;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.card-cover-item.active {
  border-color: var(--themeColor, #5b8a72);
  background: var(--projectColorLight, #e5f1ec);
}

.card-cover-item-img-wrap,
.card-cover-item-solid {
  width: 100%;
  height: 120rpx;
}

.card-cover-item-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-cover-item-label {
  display: block;
  padding: 12rpx 16rpx 16rpx;
  font-size: 24rpx;
  color: #323233;
}

.card-cover-item-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
}

/* 弹窗滚动区：标题与底部按钮固定，中间内容独立滚动 */
.card-style-sheet-scroll {
  flex: 1;
  min-height: 0;
}

.card-style-sheet-footer {
  flex-shrink: 0;
  padding: 8rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
