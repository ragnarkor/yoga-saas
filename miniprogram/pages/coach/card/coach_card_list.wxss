@import "../coach_common.wxss";

.card-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.card-hero {
  position: relative;
  height: 340rpx;
  overflow: hidden;
  background: #f0ebe3;
}

.card-hero-bg {
  width: 100%;
  height: 100%;
  display: block;
}

.card-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.04) 0%,
    rgba(0, 0, 0, 0.22) 100%
  );
  pointer-events: none;
}

.card-hero-text {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 88rpx;
  z-index: 1;
}

.card-hero-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.35;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.18);
}

.card-hero-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.card-body {
  margin-top: -76rpx;
  padding: 0 24rpx;
  position: relative;
  z-index: 2;
}

.card-loading,
.card-empty {
  min-height: 360rpx;
  padding: 80rpx 32rpx;
}

.card-list {
  padding: 0 8rpx 24rpx;
}

.card-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-row:active {
  opacity: 0.88;
}

.card-chip {
  width: 112rpx;
  height: 72rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.18);
}

.card-chip-img,
.card-chip-solid {
  width: 100%;
  height: 100%;
  display: block;
}

.card-chip-type {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.card-info {
  flex: 1;
  min-width: 0;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.card-meta-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: #f5f6f8;
  font-size: 22rpx;
  line-height: 1.3;
}

.card-meta-tag-label {
  color: #969799;
}

.card-meta-tag-value {
  color: #323233;
  font-weight: 500;
}

.card-meta-tag--price {
  background: var(--projectColorLight, #e5f1ec);
}

.card-meta-tag--price .card-meta-tag-label {
  color: var(--themeColor, #5b8a72);
  opacity: 0.85;
}

.card-meta-tag--price .card-meta-tag-value {
  color: var(--themeColor, #5b8a72);
  font-weight: 600;
}

.card-hint {
  text-align: center;
  font-size: 24rpx;
  color: #969799;
  padding: 8rpx 0 16rpx;
}

.card-empty-btn,
.card-footer-btn {
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
  line-height: 1;
  box-sizing: border-box;
}

.card-empty-btn:active,
.card-footer-btn:active {
  opacity: 0.88;
}

.card-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.card-footer-btn {
  width: 100%;
}
