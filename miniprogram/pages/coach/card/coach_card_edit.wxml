<page-meta page-style="{{themeStyle}}" />
<view class="coach-page card-edit-page">
  <coach-tenant-switch
    title="{{pageTitle}}"
    show-back="{{true}}"
    theme-color="{{themeColor}}"
    nav-bg="{{themeNavBg}}"
  />

  <view wx:if="{{loading}}" class="card-loading">
    <van-loading size="48rpx" color="{{themeColor}}">加载中...</van-loading>
  </view>

  <block wx:else>
    <van-cell-group custom-class="course-edit-group">
      <van-field label="卡名称" value="{{form.name}}" placeholder="如：空中瑜伽" bind:change="bindFieldChange" data-field="name" />
      <van-cell title="卡类型" is-link value="{{form.typeLabel}}" bind:click="bindTypeTap" />
      <van-field label="有效期(天)" type="number" value="{{form.days}}" bind:change="bindFieldChange" data-field="days" />
      <van-field label="售价(元)" type="number" value="{{form.price}}" bind:change="bindFieldChange" data-field="price" />
      <van-field wx:if="{{form.type === 'times'}}" label="额度(次)" type="number" value="{{form.quota}}" bind:change="bindFieldChange" data-field="quota" />

      <view class="course-edit-field course-edit-field--inline" bindtap="bindStyleFieldTap">
        <text class="course-edit-field-label-inline">卡面样式</text>
        <view class="course-edit-field-row course-edit-field-row--inline">
          <view class="course-edit-color-inline">
            <view wx:if="{{coverPreviewUrl}}" class="card-cover-thumb">
              <image class="card-cover-thumb-img" src="{{coverPreviewUrl}}" mode="aspectFill" />
            </view>
            <view wx:else class="course-color-dot course-color-dot--md" style="background: {{form.color}};"></view>
            <text class="course-edit-field-value">{{selectedStyleLabel}}</text>
          </view>
          <van-icon name="arrow" size="32rpx" color="#c8c9cc" />
        </view>
      </view>

      <view class="card-edit-preview" wx:if="{{coverPreviewUrl || form.color}}">
        <view class="card-edit-preview-label">预览</view>
        <view class="card-edit-preview-chip">
          <image
            wx:if="{{coverPreviewUrl}}"
            class="card-edit-preview-img"
            src="{{coverPreviewUrl}}"
            mode="aspectFill"
          />
          <view
            wx:else
            class="card-edit-preview-solid"
            style="background: {{form.color}};"
          ></view>
          <text class="card-edit-preview-type">{{form.typeLabel}}</text>
        </view>
      </view>

      <meet-category-picker
        mode="scope"
        label="适用课程"
        theme-color="{{themeColor}}"
        scope-mode="{{scopeMode}}"
        scope-category-ids="{{scopeCategoryIds}}"
        scope-meet-ids="{{scopeMeetIds}}"
        bind:scopeChange="onScopeChange"
      />
    </van-cell-group>

    <view class="card-edit-footer">
      <van-button block round color="{{themeColor}}" bind:click="bindSaveTap">保存</van-button>
    </view>
  </block>

  <van-popup
    show="{{styleSheetShow}}"
    position="bottom"
    round
    bind:close="bindCloseStyleSheet"
    custom-class="course-edit-popup"
  >
    <view class="course-edit-sheet">
      <view class="course-edit-sheet-head">
        <text class="course-edit-sheet-title">选择卡面样式</text>
        <text class="course-edit-sheet-sub">可选预设卡面，或上传一张自己的横版图片</text>
      </view>
      <scroll-view scroll-y class="card-style-sheet-scroll" enhanced show-scrollbar="{{false}}">
      <view class="card-cover-grid">
        <view
          class="card-cover-item {{selectedStyleKey === item.pickerKey ? 'active' : ''}}"
          wx:for="{{styleOptions}}"
          wx:key="pickerKey"
          data-key="{{item.pickerKey}}"
          bindtap="bindStyleTap"
        >
          <view wx:if="{{item.url}}" class="card-cover-item-img-wrap">
            <image class="card-cover-item-img" src="{{item.url}}" mode="aspectFill" />
          </view>
          <view wx:else class="card-cover-item-solid" style="background: {{item.solidColor}};"></view>
          <text class="card-cover-item-label">{{item.label}}</text>
          <van-icon
            wx:if="{{selectedStyleKey === item.pickerKey}}"
            name="success"
            size="32rpx"
            color="{{themeColor}}"
            custom-class="card-cover-item-check"
          />
        </view>
      </view>
      <view class="card-cover-upload {{isCustomCover ? 'active' : ''}} {{uploadingCover ? 'uploading' : ''}}" bindtap="bindUploadCoverTap">
        <view class="card-cover-upload-slot">
          <image wx:if="{{isCustomCover && coverPreviewUrl && !uploadingCover}}" class="card-cover-upload-img" src="{{coverPreviewUrl}}" mode="aspectFill" />
          <van-loading wx:elif="{{uploadingCover}}" size="30rpx" color="{{themeColor}}" />
          <van-icon wx:else name="photo-o" size="34rpx" color="{{themeColor}}" />
        </view>
        <view class="card-cover-upload-copy">
          <text wx:if="{{uploadingCover}}">正在上传…</text>
          <text wx:elif="{{isCustomCover}}">更换自定义封面</text>
          <text wx:else>上传自定义封面</text>
          <text class="card-cover-upload-tip">从相册或相机选择，横版图片效果更佳</text>
        </view>
        <van-icon wx:if="{{isCustomCover && !uploadingCover}}" name="success" size="32rpx" color="{{themeColor}}" />
        <van-icon wx:elif="{{!uploadingCover}}" name="arrow" size="30rpx" color="#c8c9cc" />
      </view>
      </scroll-view>
      <view class="card-style-sheet-footer">
        <van-button block round color="{{themeColor}}" bind:click="bindCloseStyleSheet">完成</van-button>
      </view>
    </view>
  </van-popup>
</view>
