@import "../coach_common.wxss";
.sale-page{min-height:100vh;padding-bottom:calc(160rpx + env(safe-area-inset-bottom));background:#f7f8f7}.sale-loading{display:flex;justify-content:center;padding:140rpx 0}.sale-intro{display:flex;align-items:center;gap:22rpx;margin:24rpx 32rpx;padding:26rpx 24rpx;border-radius:20rpx;background:#fff}.sale-intro-icon{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border-radius:20rpx;flex:0 0 auto}.sale-intro-title,.sale-row-title,.sale-section-title,.sale-card-name{display:block;color:#34423a;font-size:31rpx;font-weight:700}.sale-intro-desc,.sale-row-desc,.sale-section-tip,.sale-card-meta,.sale-security{display:block;margin-top:8rpx;color:#8b968e;font-size:23rpx;line-height:1.55}.sale-group{margin:0 32rpx;border-radius:20rpx;background:#fff;overflow:hidden}.sale-row{display:flex;align-items:center;justify-content:space-between;padding:26rpx 24rpx}.sale-row--switch{border-bottom:1rpx solid #f0f1f0}.sale-section-head{display:flex;align-items:baseline;justify-content:space-between;margin:36rpx 36rpx 16rpx}.sale-section-tip{margin:0;font-size:21rpx}.sale-card-item{padding:24rpx;border-bottom:1rpx solid #f0f1f0}.sale-card-item:last-child{border-bottom:0}.sale-card-top,.sale-card-title-wrap{display:flex;align-items:center}.sale-card-top{justify-content:space-between}.sale-card-title-wrap{gap:16rpx}.sale-card-dot{width:18rpx;height:54rpx;border-radius:999rpx}.sale-card-meta{margin-top:5rpx}.sale-card-fields{margin:20rpx -8rpx -8rpx;padding-top:14rpx;border-top:1rpx solid #f4f4f4}.sale-security{display:flex;gap:10rpx;align-items:flex-start;margin:24rpx 38rpx}.sale-footer{position:fixed;right:0;bottom:0;left:0;z-index:100;box-sizing:border-box;padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -4rpx 20rpx rgba(0,0,0,.06)}.sale-submit-btn{height:88rpx!important;font-size:28rpx!important;box-shadow:0 6rpx 14rpx rgba(70,110,95,.18)}
