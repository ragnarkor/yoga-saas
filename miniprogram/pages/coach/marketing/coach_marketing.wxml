<page-meta page-style="{{themeStyle}}" />
<view class="coach-page coach-marketing">
  <coach-tenant-switch title="营销" theme-color="{{themeColor}}" nav-bg="{{themeNavBg}}" bind:change="bindCoachTenantChange" />

  <view class="marketing-hero">
    <image
      class="marketing-hero-bg"
      src="/pages/coach/images/coach_marketing_hero.jpg?v=3"
      mode="aspectFill"
    />
    <view class="marketing-hero-overlay"></view>
    <view class="marketing-hero-text">
      <text class="marketing-hero-title">营销</text>
      <text class="marketing-hero-sub">让会员更方便地购买课程套餐</text>
    </view>
  </view>

  <view class="marketing-body">
    <view wx:if="{{loading}}" class="marketing-loading"><van-loading size="44rpx" color="{{themeColor}}">加载中...</van-loading></view>
    <view wx:else class="marketing-card-sale" bindtap="bindCardSaleTap" aria-role="button" aria-label="会员购卡，{{purchaseEnabled ? '已开启' : '未开启'}}">
      <view class="marketing-card-sale-icon" style="background:{{themeColor}}18;"><van-icon name="coupon-o" size="48rpx" color="{{themeColor}}" /></view>
      <view class="marketing-card-sale-main">
        <view class="marketing-card-sale-title-row"><text class="marketing-card-sale-title">会员购卡</text><text class="marketing-card-sale-state {{purchaseEnabled ? 'marketing-card-sale-state--on' : ''}}" aria-role="text" aria-label="{{purchaseEnabled ? '已开启' : '未开启'}}" aria-selected="{{purchaseEnabled}}">{{purchaseEnabled ? '已开启' : '未开启'}}</text></view>
        <text class="marketing-card-sale-desc">{{purchaseEnabled ? '已有 ' + activeCount + ' 种套餐可提交购买申请' : '配置套餐与付款说明后，会员即可提交申请'}}</text>
      </view>
      <van-icon name="arrow" size="32rpx" color="#c8c9cc" />
    </view>

    <view wx:if="{{!loading}}" class="marketing-card-sale marketing-card-order" bindtap="bindCardOrderTap" aria-role="button" aria-label="购卡申请，查看会员购卡申请并确认发卡">
      <view class="marketing-card-sale-icon" style="background:{{themeColor}}18;"><van-icon name="orders-o" size="48rpx" color="{{themeColor}}" /></view>
      <view class="marketing-card-sale-main">
        <view class="marketing-card-sale-title-row"><text class="marketing-card-sale-title">购卡申请</text></view>
        <text class="marketing-card-sale-desc">查看会员购卡申请，确认收款并发卡</text>
      </view>
      <van-icon name="arrow" size="32rpx" color="#c8c9cc" />
    </view>

    <view wx:if="{{!loading}}" class="marketing-note">
      <van-icon name="info-o" size="28rpx" color="{{themeColor}}" />
      <text>支持线下/转账人工确认发卡；配置微信支付商户号后，会员付款即自动发卡。</text>
    </view>
  </view>

  <coach-tab-bar active="{{2}}" />
</view>
