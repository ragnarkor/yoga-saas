<page-meta page-style="{{themeStyle}}" />
<view class="coach-page card-order-page">
  <coach-tenant-switch
    title="购卡申请"
    show-back="{{true}}"
    theme-color="{{themeColor}}"
    nav-bg="{{themeNavBg}}"
    bind:change="bindCoachTenantChange"
  />

  <view class="co-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="co-tab {{activeTab === item.key ? 'co-tab--on' : ''}}"
      style="{{activeTab === item.key ? 'color:' + themeColor + ';border-color:' + themeColor : ''}}"
      data-key="{{item.key}}"
      bindtap="bindTabTap"
      aria-role="tab"
      aria-label="{{item.label}}"
      aria-selected="{{activeTab === item.key}}"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="co-loading">
    <van-loading size="48rpx" color="{{themeColor}}">加载中...</van-loading>
  </view>

  <view wx:elif="{{!orders.length}}" class="co-empty">暂无购卡申请</view>

  <view wx:else class="co-list">
    <view class="co-card" wx:for="{{orders}}" wx:key="id">
      <view class="co-card-head">
        <text class="co-user">{{item.userName}}</text>
        <text class="co-status co-status--{{item.status}}" aria-role="text" aria-label="状态：{{item.statusDesc}}">{{item.statusDesc}}</text>
      </view>

      <view class="co-tpl-row">
        <text class="co-tpl">{{item.tplName}}</text>
        <text class="co-fee" style="color:{{themeColor}}">¥{{item.payFeeYuan}}</text>
      </view>

      <view class="co-meta">
        <text class="co-paytype {{item.isWechat ? 'co-paytype--wx' : ''}}">{{item.payType}}</text>
        <text class="co-dot">·</text>
        <text class="co-time">{{item.timeDesc}}</text>
      </view>

      <view wx:if="{{item.remark}}" class="co-remark">备注：{{item.remark}}</view>
      <view wx:if="{{item.hasTransferProof}}" class="co-proof">
        <image class="co-proof-image" src="{{item.transferProof}}" mode="aspectFill" data-url="{{item.transferProof}}" catchtap="bindPreviewProofTap" aria-role="button" aria-label="查看转账凭证图片" />
        <view><text class="co-proof-title">会员已上传转账凭证</text><text wx:if="{{item.transferReference}}" class="co-proof-ref">转账备注：{{item.transferReference}}</text></view>
      </view>
      <view wx:elif="{{item.status === 1 && !item.isWechat}}" class="co-proof co-proof--empty"><van-icon name="photo-o" size="30rpx" color="#a6afa9" /><text>会员尚未上传转账凭证</text></view>
      <view wx:if="{{item.closeReason}}" class="co-close-reason">{{item.closeReason}}</view>

      <view wx:if="{{item.canClose || item.canConfirm}}" class="co-actions">
        <view
          wx:if="{{item.canClose}}"
          class="co-btn co-btn--ghost"
          data-id="{{item.id}}"
          catchtap="bindCloseTap"
          aria-role="button"
          aria-label="关闭订单"
        >关闭</view>
        <view
          wx:if="{{item.canConfirm}}"
          class="co-btn"
          style="background:{{themeColor}}"
          data-id="{{item.id}}"
          data-name="{{item.userName}}"
          data-paid="{{item.isPaidRecovery}}"
          catchtap="bindConfirmTap"
          aria-role="button"
          aria-label="核对后发卡"
        >核对后发卡</view>
      </view>

      <view wx:if="{{item.canRefund}}" class="co-actions">
        <view
          class="co-btn co-btn--danger"
          data-id="{{item.id}}"
          data-name="{{item.userName}}"
          catchtap="bindRefundTap"
          aria-role="button"
          aria-label="原路退款"
        >原路退款</view>
      </view>
    </view>
  </view>
</view>
