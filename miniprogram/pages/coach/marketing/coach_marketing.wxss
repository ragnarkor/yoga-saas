@import "../coach_common.wxss";

.marketing-hero {
  position: relative;
  height: 340rpx;
  overflow: hidden;
  background: #f0ebe3;
}

.marketing-hero-bg {
  width: 100%;
  height: 100%;
  display: block;
}

.marketing-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.04) 0%,
    rgba(0, 0, 0, 0.22) 100%
  );
  pointer-events: none;
}

.marketing-hero-text {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 88rpx;
  z-index: 1;
}

.marketing-hero-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.35;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.18);
}

.marketing-hero-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.marketing-body {
  margin-top: -76rpx;
  padding: 0 24rpx;
  position: relative;
  z-index: 2;
}

.marketing-body .coach-revenue-card {
  margin: 0 0 20rpx;
}

.marketing-loading { display:flex; justify-content:center; padding:86rpx 0; }
.marketing-card-sale { display:flex; align-items:center; gap:22rpx; padding:30rpx 26rpx; border-radius:24rpx; background:#fff; box-shadow:0 10rpx 36rpx rgba(43,36,54,.08); }
.marketing-card-sale:active { opacity:.88; }
.marketing-card-order { margin-top: 20rpx; }
.marketing-card-sale-icon { display:flex; align-items:center; justify-content:center; width:92rpx; height:92rpx; border-radius:22rpx; flex:0 0 auto; }
.marketing-card-sale-main { flex:1; min-width:0; }
.marketing-card-sale-title-row { display:flex; align-items:center; gap:12rpx; }
.marketing-card-sale-title { color:#34423a; font-size:32rpx; font-weight:700; }
.marketing-card-sale-state { padding:4rpx 12rpx; border-radius:999rpx; background:#f2f2f2; color:#9a9a9a; font-size:21rpx; }
.marketing-card-sale-state--on { background:var(--themeColorLight,#eef6f1); color:var(--themeColor,#5b8a72); }
.marketing-card-sale-desc { display:block; overflow:hidden; margin-top:10rpx; color:#8a958d; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }
.marketing-note { display:flex; gap:12rpx; align-items:flex-start; margin:24rpx 4rpx; color:#8a958d; font-size:23rpx; line-height:1.65; }
