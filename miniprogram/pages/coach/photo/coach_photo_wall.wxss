@import "../coach_common.wxss";

.cpw-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
  background: #f7f8fa;
}

.cpw-body {
  flex: 1;
  height: 0;
  overflow-y: auto;
  padding: 20rpx 24rpx 32rpx;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.cpw-tip {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #969799;
  text-align: center;
}

.cpw-add-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 35, 41, 0.05);
}

.cpw-add-card:active {
  opacity: 0.92;
}

.cpw-add-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cpw-add-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cpw-add-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.cpw-add-sub {
  font-size: 24rpx;
  color: #969799;
}

.cpw-album-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cpw-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cpw-photo-cell {
  position: relative;
  width: calc(33.333% - 6rpx);
  height: 220rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f2f3f5;
}

.cpw-photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cpw-body--batch {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.cpw-photo-cell--selected .cpw-photo-img {
  opacity: 0.72;
}

.cpw-photo-select-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.cpw-photo-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  background: rgba(0, 0, 0, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.cpw-photo-check--on {
  background: #ee0a24;
  border-color: #ee0a24;
}

.cpw-batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(31, 35, 41, 0.08);
}

.cpw-batch-cancel {
  padding: 16rpx 8rpx;
  font-size: 30rpx;
  color: #646566;
}

.cpw-batch-del {
  padding: 16rpx 36rpx;
  background: #ee0a24;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.cpw-batch-del--disabled {
  opacity: 0.45;
}

.cpw-swipe-cell {
  border-radius: 20rpx !important;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.cpw-album-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: #fff;
}

.cpw-album-row:active {
  opacity: 0.92;
}

.cpw-album-thumbs {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  display: grid;
  gap: 3rpx;
  background: #f2f3f5;
  flex-shrink: 0;
}

.cpw-album-thumbs--1 {
  grid-template-columns: 1fr;
  grid-template-rows: 1fr;
}

.cpw-album-thumbs--2 {
  grid-template-columns: 1fr 1fr;
}

.cpw-album-thumbs--3 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.cpw-album-thumbs--3 .cpw-album-thumb:first-child {
  grid-row: span 2;
}

.cpw-album-thumbs--4 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.cpw-album-thumb {
  width: 100%;
  height: 100%;
  min-height: 0;
  background: #f2f3f5;
}

.cpw-album-thumb--empty {
  grid-column: 1 / -1;
  grid-row: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cpw-album-info {
  flex: 1;
  min-width: 0;
}

.cpw-album-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.cpw-album-count {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.cpw-swipe-del {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 65px;
  height: 100%;
  background: #ee0a24;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.cpw-upload-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.cpw-upload-bar:active {
  opacity: 0.92;
}

.cpw-upload-bar-text {
  font-size: 30rpx;
  font-weight: 600;
}

.cpw-popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}

.cpw-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.cpw-popup-close {
  padding: 26rpx;
  margin: -18rpx;
}

.cpw-popup-form {
  padding: 0 16rpx;
}

.cpw-popup-foot {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.cpw-upload {
  padding: 16rpx 32rpx 8rpx;
}

.cpw-upload-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #323233;
}

.cpw-upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cpw-upload-preview {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.cpw-upload-img {
  width: 100%;
  height: 100%;
}

.cpw-upload-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cpw-upload-del::before { content: ""; position: absolute; inset: -24rpx; }

.cpw-upload-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #dcdee0;
  border-radius: 16rpx;
  background: #f7f8fa;
}
