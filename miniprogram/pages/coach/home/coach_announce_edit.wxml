<page-meta page-style="{{themeStyle}}" />
<view class="coach-page announce-edit-page">
  <coach-tenant-switch title="{{isEdit ? '编辑公告' : '新增公告'}}" show-back="{{true}}" theme-color="{{themeColor}}" nav-bg="{{themeNavBg}}" />
  <view wx:if="{{!isLoad}}" class="loading-wrap"><van-loading size="48rpx" color="{{themeColor}}">加载中...</van-loading></view>
  <scroll-view wx:else scroll-y class="edit-scroll" enhanced show-scrollbar="{{false}}">
    <view class="edit-intro"><van-icon name="info-o" size="30rpx" color="{{themeColor}}" /><text>完成编辑后点击“预览效果”，确认无误再发布。</text></view>
    <view class="editor-card">
      <view class="section-title">编辑内容</view>
      <van-field value="{{form.title}}" data-field="title" bind:input="bindFormInput" label="标题" placeholder="请输入公告标题" border="{{false}}" />
      <van-field value="{{form.desc}}" data-field="desc" bind:input="bindFormInput" label="摘要" type="textarea" placeholder="可选，用于列表展示" autosize="{{ {maxHeight: 160} }}" border="{{false}}" />
      <editor id="announceEditor" class="announce-editor" placeholder="请输入公告正文" show-img-size show-img-toolbar show-img-resize bindready="bindEditorReady" bindinput="bindEditorInput"></editor>
      <scroll-view scroll-x class="editor-toolbar">
        <view class="tool" data-name="header" data-value="2" bindtap="bindFormatTap" aria-role="button" aria-label="标题">标题</view><view class="tool" data-name="bold" bindtap="bindFormatTap" aria-role="button" aria-label="加粗">加粗</view><view class="tool" data-name="italic" bindtap="bindFormatTap" aria-role="button" aria-label="斜体">斜体</view><view class="tool" data-name="underline" bindtap="bindFormatTap" aria-role="button" aria-label="下划线">下划线</view><view class="tool" data-name="align" data-value="center" bindtap="bindFormatTap" aria-role="button" aria-label="居中">居中</view><view class="tool" data-name="image" bindtap="bindFormatTap" aria-role="button" aria-label="插入图片">图片</view><view class="tool" data-name="clear" bindtap="bindFormatTap" aria-role="button" aria-label="清除格式">清除格式</view>
      </scroll-view>
    </view>
    <van-button plain block round color="{{themeColor}}" bind:click="bindPreviewTap" custom-class="preview-btn">预览会员端效果</van-button>
    <van-button block round color="{{themeColor}}" loading="{{submitting}}" bind:click="bindSubmitTap" custom-class="save-btn">{{isEdit ? '保存修改' : '发布公告'}}</van-button>
  </scroll-view>
</view>
<van-popup wx:if="{{previewShow}}" show="{{previewShow}}" position="bottom" round closeable bind:close="bindPreviewClose" custom-class="announce-preview-popup">
  <view class="preview-popup-head">会员端预览</view>
  <scroll-view scroll-y class="preview-popup-scroll">
    <view class="preview-phone"><view class="preview-title">{{form.title || '公告标题'}}</view><view wx:if="{{form.desc}}" class="preview-desc">{{form.desc}}</view><rich-text nodes="{{previewNodes}}" class="preview-content" /></view>
  </scroll-view>
</van-popup>
