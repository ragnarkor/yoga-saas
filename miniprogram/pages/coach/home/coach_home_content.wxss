@import "../coach_common.wxss";

.hc-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
}

.hc-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--projectColorLight, #e8f2ed);
  border-radius: 16rpx;
}

.hc-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #646566;
  line-height: 1.6;
}

.hc-tab-scroll {
  flex-shrink: 0;
  margin-top: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.hc-tab-bar {
  display: inline-flex;
  min-width: 100%;
  padding: 0 8rpx;
}

.hc-tab-item {
  flex: 1;
  min-width: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 22rpx 16rpx 18rpx;
  font-size: 28rpx;
  color: #646566;
  border-bottom: 4rpx solid transparent;
  box-sizing: border-box;
}

.hc-tab-item--active {
  font-weight: 600;
}

.hc-tab-count {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  font-size: 20rpx;
  color: #969799;
  line-height: 32rpx;
  text-align: center;
}

.hc-tab-item--active .hc-tab-count {
  background: var(--projectColorLight, #e8f2ed);
  color: var(--themeColor, #6fae96);
}

.hc-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.hc-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 2rpx dashed var(--themeColor, #6fae96);
  border-radius: 16rpx;
  background: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.hc-photo-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #969799;
}

.hc-album-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hc-album-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hc-album-card:active {
  opacity: 0.9;
}

.hc-album-cover {
  width: 100%;
  height: 220rpx;
  background: #f2f3f5;
  display: block;
}

.hc-album-cover--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hc-album-meta {
  padding: 16rpx 18rpx 18rpx;
}

.hc-album-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}

.hc-album-count {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #969799;
}

.hc-album-subhead {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 8rpx 0;
}

.hc-album-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: #646566;
  flex-shrink: 0;
}

.hc-album-subhead-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.hc-album-subhead-count {
  font-size: 24rpx;
  color: #969799;
  flex-shrink: 0;
}

.hc-album-locked {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  gap: 24rpx;
}

.hc-album-locked-label {
  font-size: 28rpx;
  color: #323233;
  flex-shrink: 0;
}

.hc-album-locked-value {
  flex: 1;
  font-size: 28rpx;
  color: #646566;
}

.hc-upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hc-upload-placeholder--sm {
  width: 160rpx;
  height: 160rpx;
}

.hc-banner-card {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.hc-banner-img {
  width: 100%;
  height: 280rpx;
  background: #f2f3f5;
}

.hc-banner-img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hc-banner-meta {
  padding: 20rpx 24rpx 24rpx;
}

.hc-list-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hc-list-icon {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hc-list-body {
  flex: 1;
  min-width: 0;
}

.hc-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hc-card-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hc-card-actions {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.hc-action-btn {
  padding: 12rpx;
}

.hc-action-btn--sm {
  padding: 8rpx;
}

.hc-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hc-photo-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hc-photo-img {
  width: 100%;
  height: 200rpx;
  background: #f2f3f5;
}

.hc-photo-img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hc-photo-info {
  padding: 16rpx;
}

.hc-photo-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hc-photo-album {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

.hc-album-chips {
  width: 100%;
  padding: 0 32rpx 8rpx;
  box-sizing: border-box;
}

.hc-album-chips-inner {
  display: inline-flex;
  gap: 12rpx;
  white-space: nowrap;
}

.hc-album-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #646566;
  background: #f7f8fa;
  border: 1rpx solid #ebedf0;
  border-radius: 999rpx;
}

.hc-album-chip--active {
  font-weight: 600;
}

.hc-photo-actions {
  display: flex;
  justify-content: flex-end;
  gap: 4rpx;
  padding: 0 8rpx 12rpx;
}

.hc-popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}

.hc-popup { max-height: 88vh; overflow-y: auto; }

.hc-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.hc-popup-close {
  padding: 8rpx;
}

.hc-popup-form {
  padding: 0 16rpx;
}

.hc-popup-foot {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.hc-upload {
  padding: 16rpx 32rpx 8rpx;
}

.hc-upload-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #323233;
}

.hc-upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #dcdee0;
  border-radius: 16rpx;
  background: #f7f8fa;
  font-size: 24rpx;
  color: #969799;
}

.hc-upload-preview {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.hc-upload-img {
  width: 100%;
  height: 100%;
}

.hc-upload-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hc-editor-wrap { margin: 16rpx 32rpx 8rpx; border: 1rpx solid #e5e6eb; border-radius: 12rpx; overflow: hidden; }
.hc-editor { min-height: 360rpx; padding: 20rpx; box-sizing: border-box; background: #fff; }
.hc-editor-toolbar { border-top: 1rpx solid #e5e6eb; white-space: nowrap; background: #fafafa; }
.hc-editor-tool { display: inline-block; padding: 16rpx 20rpx; color: #4e5969; font-size: 24rpx; }

/* 首页内容管理：统一为轻量卡片式管理界面 */
.hc-page { background: #f5f7f6; }
.hc-tip { margin: 20rpx 24rpx 0; padding: 22rpx 24rpx; border: 1rpx solid rgba(111,174,150,.16); background: linear-gradient(135deg, #eef7f1, #f8fbf8); box-shadow: 0 6rpx 18rpx rgba(59,92,76,.05); }
.hc-tip-text { color: #53665b; font-size: 25rpx; }
.hc-tab-scroll { margin: 20rpx 24rpx 0; border: 1rpx solid #e8eeea; border-radius: 18rpx; box-shadow: 0 4rpx 16rpx rgba(40,70,56,.04); }
.hc-tab-bar { padding: 6rpx; }
.hc-tab-item { min-width: 220rpx; padding: 18rpx 20rpx; border: 0; border-radius: 14rpx; font-size: 27rpx; transition: background .2s; }
.hc-tab-item--active { background: var(--projectColorLight, #e8f2ed); }
.hc-tab-count { min-width: 36rpx; height: 30rpx; line-height: 30rpx; background: #fff; border: 1rpx solid #e8eeea; }
.hc-body { padding: 24rpx; }
.hc-add-btn { margin-bottom: 20rpx; padding: 20rpx; border: 0; border-radius: 16rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(40,70,56,.06); }
.hc-add-btn:active { transform: scale(.985); opacity: .9; }
.hc-banner-card, .hc-list-card { border: 1rpx solid #edf1ee; box-shadow: 0 6rpx 22rpx rgba(40,70,56,.06); }
.hc-banner-card { margin-bottom: 20rpx; border-radius: 22rpx; }
.hc-banner-img { height: 300rpx; }
.hc-banner-meta { padding: 22rpx 24rpx 20rpx; }
.hc-list-card { gap: 18rpx; margin-bottom: 14rpx; padding: 20rpx; border-radius: 18rpx; }
.hc-list-icon { width: 76rpx; height: 76rpx; border-radius: 20rpx; }
.hc-card-title { font-size: 29rpx; }
.hc-card-desc { margin-top: 6rpx; color: #8b968f; }
.hc-action-btn { width: 56rpx; height: 56rpx; padding: 0; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: #f5f8f6; }
.hc-action-btn--danger { background: #fff3f2; }
.hc-swipe-cell { display:block; margin-bottom:16rpx; border-radius:20rpx; overflow:hidden; }
.hc-swipe-cell .hc-banner-card, .hc-swipe-cell .hc-list-card { margin-bottom:0; }
.hc-swipe-del { width:72px; height:100%; display:flex; align-items:center; justify-content:center; background:#ee0a24; color:#fff; font-size:28rpx; font-weight:500; }
.hc-fab { position:fixed; right:40rpx; bottom:calc(140rpx + env(safe-area-inset-bottom)); width:100rpx; height:100rpx; border-radius:50%; background:linear-gradient(135deg,var(--themeColorLight,#c4b5fd),var(--themeColor,#5b8a72)); display:flex; align-items:center; justify-content:center; box-shadow:0 8rpx 24rpx rgba(0,0,0,.16); z-index:100; }
.hc-fab:active { transform:scale(.94); }
