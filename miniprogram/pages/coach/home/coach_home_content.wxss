@import "../coach_common.wxss";

.hc-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
}

.hc-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--projectColorLight, #e8f2ed);
  border-radius: 16rpx;
}

.hc-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #646566;
  line-height: 1.6;
}

.hc-tab-scroll {
  flex-shrink: 0;
  margin-top: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.hc-tab-bar {
  display: inline-flex;
  min-width: 100%;
  padding: 0 8rpx;
}

.hc-tab-item {
  flex: 1;
  min-width: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 22rpx 16rpx 18rpx;
  font-size: 28rpx;
  color: #646566;
  border-bottom: 4rpx solid transparent;
  box-sizing: border-box;
}

.hc-tab-item--active {
  font-weight: 600;
}

.hc-tab-count {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  font-size: 20rpx;
  color: #969799;
  line-height: 32rpx;
  text-align: center;
}

.hc-tab-item--active .hc-tab-count {
  background: var(--projectColorLight, #e8f2ed);
  color: var(--themeColor, #6fae96);
}

.hc-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.hc-banner-card {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.hc-banner-img {
  width: 100%;
  height: 280rpx;
  background: #f2f3f5;
}

.hc-banner-img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hc-banner-meta {
  padding: 20rpx 24rpx 24rpx;
}

.hc-list-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hc-list-icon {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hc-list-body {
  flex: 1;
  min-width: 0;
}

.hc-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hc-card-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 首页内容管理：统一为轻量卡片式管理界面 */
.hc-page { background: #f5f7f6; }
.hc-tip { margin: 20rpx 24rpx 0; padding: 22rpx 24rpx; border: 1rpx solid rgba(111,174,150,.16); background: linear-gradient(135deg, #eef7f1, #f8fbf8); box-shadow: 0 6rpx 18rpx rgba(59,92,76,.05); }
.hc-tip-text { color: #53665b; font-size: 25rpx; }
.hc-tab-scroll { margin: 20rpx 24rpx 0; border: 1rpx solid #e8eeea; border-radius: 18rpx; box-shadow: 0 4rpx 16rpx rgba(40,70,56,.04); }
.hc-tab-bar { padding: 6rpx; }
.hc-tab-item { min-width: 220rpx; padding: 18rpx 20rpx; border: 0; border-radius: 14rpx; font-size: 27rpx; transition: background .2s; }
.hc-tab-item--active { background: var(--projectColorLight, #e8f2ed); }
.hc-tab-count { min-width: 36rpx; height: 30rpx; line-height: 30rpx; background: #fff; border: 1rpx solid #e8eeea; }
.hc-body { padding: 24rpx; }
.hc-banner-card, .hc-list-card { border: 1rpx solid #edf1ee; box-shadow: 0 6rpx 22rpx rgba(40,70,56,.06); }
.hc-banner-card { margin-bottom: 20rpx; border-radius: 22rpx; }
.hc-banner-img { height: 300rpx; }
.hc-banner-meta { padding: 22rpx 24rpx 20rpx; }
.hc-list-card { gap: 18rpx; margin-bottom: 14rpx; padding: 20rpx; border-radius: 18rpx; }
.hc-list-icon { width: 76rpx; height: 76rpx; border-radius: 20rpx; }
.hc-card-title { font-size: 29rpx; }
.hc-card-desc { margin-top: 6rpx; color: #8b968f; }
.hc-swipe-cell { display:block; margin-bottom:16rpx; border-radius:20rpx; overflow:hidden; }
.hc-swipe-cell .hc-banner-card, .hc-swipe-cell .hc-list-card { margin-bottom:0; }
.hc-swipe-del { width:72px; height:100%; display:flex; align-items:center; justify-content:center; background:#ee0a24; color:#fff; font-size:28rpx; font-weight:500; }
.hc-fab { position:fixed; right:40rpx; bottom:calc(140rpx + env(safe-area-inset-bottom)); width:100rpx; height:100rpx; border-radius:50%; background:linear-gradient(135deg,var(--themeColorLight,#c4b5fd),var(--themeColor,#5b8a72)); display:flex; align-items:center; justify-content:center; box-shadow:0 8rpx 24rpx rgba(0,0,0,.16); z-index:100; }
.hc-fab:active { transform:scale(.94); }
