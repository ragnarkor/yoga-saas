<page-meta page-style="{{themeStyle}}" />
<view class="coach-page hc-page">
  <coach-tenant-switch
    title="首页内容"
    show-back="{{true}}"
    theme-color="{{themeColor}}"
    nav-bg="{{themeNavBg}}"
    bind:change="bindCoachTenantChange"
  />

  <view wx:if="{{!isLoad}}" class="coach-page-loading">
    <van-loading size="48rpx" color="{{themeColor}}">加载中...</van-loading>
  </view>

  <block wx:else>
    <view class="hc-tip">
      <van-icon name="info-o" size="28rpx" color="{{themeColor}}" />
      <text class="hc-tip-text">管理会员端首页的横幅与公告。照片墙请在「我的 → 照片墙」中管理。</text>
    </view>

    <scroll-view scroll-x class="hc-tab-scroll" enhanced show-scrollbar="{{false}}">
      <view class="hc-tab-bar">
        <view
          wx:for="{{tabs}}"
          wx:key="id"
          class="hc-tab-item {{activeTab === index ? 'hc-tab-item--active' : ''}}"
          style="{{activeTab === index ? 'color:' + themeColor + ';border-color:' + themeColor : ''}}"
          data-index="{{index}}"
          bindtap="bindTabTap"
        >
          <van-icon name="{{item.icon}}" size="28rpx" color="{{activeTab === index ? themeColor : '#969799'}}" />
          <text>{{item.name}}</text>
          <text class="hc-tab-count" wx:if="{{index === 0}}">{{banners.length}}</text>
          <text class="hc-tab-count" wx:else>{{announces.length}}</text>
        </view>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="hc-body" enhanced show-scrollbar="{{false}}">
      <block wx:if="{{activeTab === 0}}">
        <van-empty wx:if="{{!banners.length}}" description="暂无横幅，会员端将显示默认封面" />
        <van-swipe-cell wx:for="{{banners}}" wx:key="_id" id="home-swipe-{{item._id}}" data-swipe-id="{{item._id}}" right-width="72" bind:open="bindSwipeOpen" custom-class="hc-swipe-cell">
          <view class="hc-banner-card" data-type="banner" data-id="{{item._id}}" bindtap="bindEditTap">
            <image wx:if="{{item.BANNER_PIC}}" class="hc-banner-img" src="{{item.BANNER_PIC}}" mode="aspectFill" />
            <view wx:else class="hc-banner-img hc-banner-img--placeholder"><van-icon name="photo-o" size="48rpx" color="#c8c9cc" /></view>
            <view class="hc-banner-meta"><text class="hc-card-title">{{item.BANNER_TITLE || '未命名横幅'}}</text><text class="hc-card-desc">排序 {{item.BANNER_ORDER || 0}}</text></view>
          </view>
          <view slot="right" class="hc-swipe-del" data-type="banner" data-id="{{item._id}}" catchtap="bindDelTap">删除</view>
        </van-swipe-cell>
      </block>

      <block wx:else>
        <van-empty wx:if="{{!announces.length}}" description="暂无公告" />
        <van-swipe-cell wx:for="{{announces}}" wx:key="_id" id="home-swipe-{{item._id}}" data-swipe-id="{{item._id}}" right-width="72" bind:open="bindSwipeOpen" custom-class="hc-swipe-cell">
          <view class="hc-list-card" data-type="announce" data-id="{{item._id}}" bindtap="bindEditTap">
            <view class="hc-list-icon" style="background: {{themeColor}}18;"><van-icon name="volume-o" size="36rpx" color="{{themeColor}}" /></view>
            <view class="hc-list-body"><text class="hc-card-title">{{item.ANNOUNCE_TITLE}}</text><text class="hc-card-desc">{{item.ANNOUNCE_DESC || '无描述'}}</text></view>
            <van-icon name="arrow" size="28rpx" color="#c8c9cc" />
          </view>
          <view slot="right" class="hc-swipe-del" data-type="announce" data-id="{{item._id}}" catchtap="bindDelTap">删除</view>
        </van-swipe-cell>
      </block>
    </scroll-view>
  </block>

  <van-popup wx:if="{{popupShow}}" show="{{popupShow}}" position="bottom" round bind:close="bindPopupClose" custom-class="hc-popup">
    <view class="hc-popup-head">
      <text class="hc-popup-title">{{popupTitle}}</text>
      <view class="hc-popup-close" bindtap="bindPopupClose">
        <van-icon name="cross" size="36rpx" color="#969799" />
      </view>
    </view>
    <view class="hc-popup-form">
      <van-field
        value="{{form.title}}"
        data-field="title"
        bind:input="bindFormInput"
        label="标题"
        placeholder="请输入标题"
        border="{{ false }}"
      />
      <view wx:if="{{popupType == 'banner'}}" class="hc-upload">
        <text class="hc-upload-label">图片</text>
        <view wx:if="{{imgList.length}}" class="hc-upload-preview">
          <image src="{{imgList[0]}}" mode="aspectFill" class="hc-upload-img" />
          <view class="hc-upload-del" catchtap="bindDelImg">
            <van-icon name="cross" size="28rpx" color="#fff" />
          </view>
        </view>
        <view wx:else class="hc-upload-placeholder" bindtap="bindChooseImg">
          <van-icon name="photograph" size="48rpx" color="#c8c9cc" />
          <text>选择图片</text>
        </view>
      </view>
    </view>
    <view class="hc-popup-foot">
      <van-button block round color="{{themeColor}}" loading="{{submitting}}" bind:click="bindSubmitTap">
        {{submitBtnText}}
      </van-button>
    </view>
  </van-popup>
  <view class="hc-fab" data-type="{{activeTab === 0 ? 'banner' : 'announce'}}" bindtap="bindAddTap"><van-icon name="plus" size="46rpx" color="#fff" /></view>
</view>
