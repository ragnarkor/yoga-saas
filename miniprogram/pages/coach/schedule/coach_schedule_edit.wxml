<page-meta page-style="{{themeStyle}}" />
<view class="coach-page schedule-edit-page">
  <coach-tenant-switch
    title="{{pageTitle}}"
    show-back="{{true}}"
    theme-color="{{themeColor}}"
    nav-bg="{{themeNavBg}}"
  />

  <view wx:if="{{loading}}" class="schedule-edit-loading">
    <van-loading size="48rpx" color="{{themeColor}}">加载中...</van-loading>
  </view>

  <block wx:else>

    <view class="schedule-common-card">
      <text class="schedule-form-card-title">排课信息</text>
      <van-cell-group custom-class="schedule-edit-group">
        <meet-course-picker
          value="{{formMeetId}}"
          theme-color="{{themeColor}}"
          label="课程"
          required="{{true}}"
          disabled="{{isEdit}}"
          empty-text="请先在课程管理中添加课程"
          bind:pick="onCoursePick"
        />
      <coach-picker
          id-mode="teacher"
          value="{{formTeacherId}}"
          theme-color="{{themeColor}}"
          label="授课老师"
          required="{{true}}"
          field-class="schedule-edit-coach-field"
        bind:pick="onCoachPick"
      />
      <van-cell wx:if="{{roomOptions.length > 1}}" title="上课教室" value="{{formRoomName || '不指定教室'}}" is-link bindtap="bindRoomPickerOpen" />
      <van-field
          label="人数上限"
          type="number"
          value="{{formLimit}}"
          placeholder="0 表示不限"
          bind:change="bindLimitChange"
        />
      </van-cell-group>
    </view>

    <view wx:if="{{!isEdit}}" class="schedule-mode-switch">
      <view class="schedule-mode-item {{scheduleMode === 'repeat' ? 'is-active' : ''}}" style="{{scheduleMode === 'repeat' ? 'color:' + themeColor + ';background:' + themeColor + '18;' : ''}}" data-mode="repeat" bindtap="bindScheduleModeTap">周期排课</view>
      <view class="schedule-mode-item {{scheduleMode === 'day' ? 'is-active' : ''}}" style="{{scheduleMode === 'day' ? 'color:' + themeColor + ';background:' + themeColor + '18;' : ''}}" data-mode="day" bindtap="bindScheduleModeTap">按天排课</view>
    </view>

    <view wx:if="{{isEdit || scheduleMode === 'day'}}" class="schedule-repeat-card schedule-day-card">
      <view class="schedule-repeat-head">
        <view>
          <text class="schedule-repeat-title">{{isEdit ? '编辑上课时间' : '按天排课'}}</text>
          <text class="schedule-repeat-sub">{{isEdit ? '仅修改当前课程时段' : '可一次选择多个指定日期'}} </text>
        </view>
        <text class="schedule-repeat-duration">每节 {{duration}} 分钟</text>
      </view>
      <view class="schedule-repeat-label">上课日期 <text>*</text></view>
      <view class="schedule-day-picker" bindtap="bindDayTap">
        <text class="schedule-day-picker-value">{{formDayDisplay || '请选择日期'}}</text>
        <van-icon wx:if="{{!isEdit}}" name="arrow" size="26rpx" color="#9ca29b" />
      </view>
      <view class="schedule-repeat-label">上课时间 <text>*</text></view>
      <view class="schedule-time-row">
        <view class="schedule-time-picker" bindtap="bindStartTimeTap">{{formStartTime || '请选择'}} <van-icon name="arrow-down" size="22rpx" /></view>
        <text class="schedule-time-to">—</text>
        <text class="schedule-time-end">{{formEndTime}}</text>
      </view>
    </view>

    <view wx:if="{{!isEdit && scheduleMode === 'repeat'}}" class="schedule-repeat-card">
      <view class="schedule-repeat-head">
        <view>
          <text class="schedule-repeat-title">周期排课</text>
          <text class="schedule-repeat-sub">按星期和日期范围批量生成课程</text>
        </view>
        <text class="schedule-repeat-duration">每节 {{duration}} 分钟</text>
      </view>

      <view class="schedule-repeat-label">上课星期 <text>*</text></view>
      <view class="schedule-weekdays">
        <view
          wx:for="{{weekOptions}}"
          wx:key="value"
          class="schedule-weekday {{item.selected ? 'is-selected' : ''}}"
          style="{{item.selected ? 'border-color:' + themeColor + ';background:' + themeColor + ';' : ''}}"
          data-value="{{item.value}}"
          bindtap="bindBatchWeekdayTap"
        >{{item.label}}</view>
      </view>

      <view class="schedule-repeat-label">排课日期 <text>*</text></view>
      <view class="schedule-date-range">
        <picker mode="date" start="{{minDay}}" value="{{batchStartDay}}" bindchange="bindBatchStartDayChange">
          <view class="schedule-date-picker"><text>{{batchStartDay}}</text><van-icon name="arrow-down" size="24rpx" /></view>
        </picker>
        <text class="schedule-date-range-line">至</text>
        <picker mode="date" start="{{batchStartDay}}" value="{{batchEndDay}}" bindchange="bindBatchEndDayChange">
          <view class="schedule-date-picker"><text>{{batchEndDay}}</text><van-icon name="arrow-down" size="24rpx" /></view>
        </picker>
      </view>

      <view class="schedule-repeat-label">上课时间 <text>*</text></view>
      <view class="schedule-time-list">
        <view class="schedule-time-row" wx:for="{{formTimeSlots}}" wx:key="index">
          <picker mode="time" value="{{item.start}}" data-index="{{index}}" bindchange="bindSlotStartChange">
            <view class="schedule-time-picker">{{item.start}} <van-icon name="arrow-down" size="22rpx" /></view>
          </picker>
          <text class="schedule-time-to">—</text>
          <text class="schedule-time-end">{{item.end}}</text>
          <van-icon wx:if="{{formTimeSlots.length > 1}}" name="cross" size="28rpx" color="#a8aba4" data-index="{{index}}" bindtap="bindRemoveTimeSlot" />
        </view>
      </view>
      <view class="schedule-add-time" style="color:{{themeColor}}" bindtap="bindAddTimeSlot"><van-icon name="plus" size="27rpx" />添加上课时间</view>
    </view>

    <view class="schedule-edit-save">
      <van-button
        block
        round
        color="{{themeColor}}"
        loading="{{saving}}"
        disabled="{{saving}}"
        bind:click="bindSaveTap"
      >{{isEdit ? '保存修改' : '确认排课'}}</van-button>
    </view>

    <view wx:if="{{isEdit}}" class="schedule-edit-del">
      <van-button block plain type="danger" loading="{{saving}}" bind:click="bindDeleteTap">删除此排课</van-button>
    </view>
  </block>

  <van-popup
    show="{{datePickerShow}}"
    position="bottom"
    round
    bind:close="bindDatePickerClose"
    custom-class="schedule-calendar-popup"
  >
    <view class="schedule-calendar-wrap">
      <view class="schedule-calendar-head">{{isEdit ? '选择日期' : '选择日期（可多选）'}}</view>
      <van-calendar
        poppable="{{ false }}"
        type="{{isEdit ? 'single' : 'multiple'}}"
        show-confirm="{{ true }}"
        color="{{themeColor}}"
        min-date="{{datePickerMin}}"
        default-date="{{calendarDefaultDate}}"
        bind:confirm="bindCalendarConfirm"
      />
    </view>
  </van-popup>

  <van-popup show="{{timePickerShow}}" position="bottom" round bind:close="bindTimePickerClose">
    <van-datetime-picker
      type="time"
      value="{{formStartTime}}"
      bind:confirm="bindTimeConfirm"
      bind:cancel="bindTimePickerClose"
    />
  </van-popup>

  <van-popup show="{{roomPickerShow}}" position="bottom" round bind:close="bindRoomPickerClose" custom-class="schedule-room-popup">
    <view class="schedule-room-sheet">
      <view class="schedule-room-sheet-head"><view><text>选择上课教室</text><text>教室为可选项，不选也可正常排课</text></view><van-icon name="cross" size="34rpx" color="#969799" bindtap="bindRoomPickerClose" /></view>
      <scroll-view scroll-y class="schedule-room-sheet-scroll">
        <view wx:for="{{roomOptions}}" wx:key="id" class="schedule-room-option {{item.id === formRoomId ? 'is-active' : ''}}" data-index="{{index}}" bindtap="bindRoomPick">
          <view class="schedule-room-option-icon" style="background:{{item.id === formRoomId ? themeColor + '18' : '#f3f5f4'}};"><van-icon name="shop-o" size="34rpx" color="{{item.id === formRoomId ? themeColor : '#97a09a'}}" /></view>
          <view class="schedule-room-option-info"><text>{{item.name}}</text><text wx:if="{{item.id}}">{{item.location || '未设置位置'}} · {{item.capacity ? item.capacity + ' 人容量' : '容量不限'}}</text><text wx:else>不限制场地，适合线上或灵活排课</text></view>
          <van-icon wx:if="{{item.id === formRoomId}}" name="success" size="36rpx" color="{{themeColor}}" />
        </view>
      </scroll-view>
    </view>
  </van-popup>
</view>
