@import "../coach_common.wxss";

.schedule-edit-page {
  min-height: 100vh;
  background: #f5f6f7;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.schedule-edit-loading {
  /* 见 coach_common.wxss */
}

.schedule-edit-group {
  margin: 0 !important;
}

.schedule-common-card {
  margin: 24rpx 24rpx 0;
  overflow: hidden;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 22rpx rgba(40, 70, 56, 0.05);
}

.schedule-form-card-title {
  display: block;
  padding: 28rpx 28rpx 14rpx;
  color: #34463a;
  font-size: 31rpx;
  font-weight: 700;
}

.schedule-mode-switch {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 24rpx 0;
  padding: 8rpx;
  background: #edf0ec;
  border-radius: 18rpx;
}

.schedule-mode-item {
  position: relative;
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b9289;
  font-size: 25rpx;
  border-radius: 13rpx;
}

.schedule-mode-item::before {
  content: "";
  position: absolute;
  inset: -12rpx 0;
}

.schedule-mode-item.is-active {
  font-weight: 700;
}

.schedule-repeat-card {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(40, 70, 56, 0.05);
}

.schedule-day-picker {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 18rpx;
  color: #4b554d;
  font-size: 25rpx;
  background: #fafaf8;
  border: 1rpx solid #e8e9e5;
  border-radius: 14rpx;
}

.schedule-day-picker-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-repeat-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.schedule-repeat-title {
  display: block;
  color: #34463a;
  font-size: 31rpx;
  font-weight: 700;
}

.schedule-repeat-sub {
  display: block;
  margin-top: 7rpx;
  color: #989c94;
  font-size: 22rpx;
}

.schedule-repeat-duration {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  color: var(--themeColor, #5b8a72);
  font-size: 21rpx;
  background: var(--projectColorLight, #edf5f0);
  border-radius: 999rpx;
}

.schedule-repeat-label {
  margin: 24rpx 0 14rpx;
  color: #4c554d;
  font-size: 26rpx;
  font-weight: 600;
}

.schedule-repeat-label text {
  color: #ee0a24;
}

.schedule-weekdays {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
}

.schedule-weekday {
  position: relative;
  width: 76rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #7e857d;
  font-size: 22rpx;
  background: #fafaf8;
  border: 1rpx solid #e6e8e2;
  border-radius: 14rpx;
}

.schedule-weekday::before {
  content: "";
  position: absolute;
  inset: -14rpx -6rpx;
}

.schedule-weekday.is-selected {
  color: #fff;
  font-weight: 600;
}

.schedule-date-range {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.schedule-date-range picker {
  flex: 1;
  min-width: 0;
}

.schedule-date-picker,
.schedule-time-picker,
.schedule-time-end {
  position: relative;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 18rpx;
  color: #4b554d;
  font-size: 25rpx;
  background: #fafaf8;
  border: 1rpx solid #e8e9e5;
  border-radius: 14rpx;
}

.schedule-date-picker::before,
.schedule-time-picker::before,
.schedule-time-end::before {
  content: "";
  position: absolute;
  inset: -9rpx 0;
}

.schedule-date-range-line,
.schedule-time-to {
  flex-shrink: 0;
  color: #a4a7a0;
  font-size: 23rpx;
}

.schedule-time-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.schedule-time-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.schedule-time-row picker,
.schedule-time-picker,
.schedule-time-end {
  flex: 1;
  min-width: 0;
}

.schedule-time-end {
  height: 70rpx;
  justify-content: flex-start;
  padding: 0;
  color: #667066;
  font-weight: 600;
  background: transparent;
  border: 0;
}

.schedule-add-time {
  position: relative;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  background: #fafbf9;
  border: 1rpx dashed #d9ddd5;
  border-radius: 14rpx;
}

.schedule-add-time::before {
  content: "";
  position: absolute;
  inset: -8rpx;
}

.schedule-time-remove-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  margin: -30rpx;
}

.schedule-edit-coach-field.coach-picker-field {
  padding: 24rpx 32rpx;
  background: #fff;
}

.schedule-edit-coach-field.coach-picker-field .coach-picker-label {
  width: 6.2em;
  color: #646566;
}

.schedule-edit-coach-field.coach-picker-field .coach-picker-value-wrap {
  flex: 1;
}

.schedule-edit-save {
  margin: 48rpx 32rpx 0;
}

.schedule-edit-del {
  margin: 24rpx 32rpx 0;
}

.schedule-calendar-wrap {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.schedule-calendar-popup {
  min-height: 930rpx;
}

.schedule-calendar-head {
  padding: 28rpx 32rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.schedule-calendar-wrap .van-calendar {
  height: 800rpx !important;
}

.schedule-room-sheet { max-height: 72vh; padding-bottom: env(safe-area-inset-bottom); }
.schedule-room-sheet-head { display:flex; align-items:center; justify-content:space-between; padding:30rpx 32rpx 18rpx; }
.schedule-room-sheet-head text { display:block; color:#323233; font-size:32rpx; font-weight:700; }
.schedule-room-sheet-head text:last-child { margin-top:8rpx; color:#969799; font-size:23rpx; font-weight:400; }
.schedule-room-sheet-scroll { max-height:calc(72vh - 132rpx); padding:0 24rpx 24rpx; box-sizing:border-box; }
.schedule-room-option { display:flex; align-items:center; gap:18rpx; padding:20rpx; margin-bottom:14rpx; border:1rpx solid #eef0ed; border-radius:18rpx; background:#fff; }
.schedule-room-option.is-active { border-color:var(--themeColor,#5b8a72); background:var(--projectColorLight,#edf5f0); }
.schedule-room-option-icon { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; border-radius:16rpx; flex:0 0 auto; }
.schedule-room-option-info { flex:1; min-width:0; }
.schedule-room-option-info text { display:block; overflow:hidden; color:#323233; font-size:28rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.schedule-room-option-info text:last-child { margin-top:7rpx; color:#969799; font-size:22rpx; font-weight:400; }

.schedule-room-close-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 27rpx;
  margin: -27rpx;
}
