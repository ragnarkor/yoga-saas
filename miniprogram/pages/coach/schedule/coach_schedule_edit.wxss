@import "../coach_common.wxss";

.schedule-edit-page {
  min-height: 100vh;
  background: #f5f6f7;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.schedule-edit-loading {
  /* 见 coach_common.wxss */
}

.schedule-edit-group {
  margin: 0 !important;
}

.schedule-common-card {
  margin: 24rpx 24rpx 0;
  overflow: hidden;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 22rpx rgba(40, 70, 56, 0.05);
}

.schedule-form-card-title {
  display: block;
  padding: 28rpx 28rpx 14rpx;
  color: #34463a;
  font-size: 31rpx;
  font-weight: 700;
}

.schedule-mode-switch {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 24rpx 0;
  padding: 8rpx;
  background: #edf0ec;
  border-radius: 18rpx;
}

.schedule-mode-item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b9289;
  font-size: 25rpx;
  border-radius: 13rpx;
}

.schedule-mode-item.is-active {
  font-weight: 700;
}

.schedule-repeat-card {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(40, 70, 56, 0.05);
}

.schedule-day-picker {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 18rpx;
  color: #4b554d;
  font-size: 25rpx;
  background: #fafaf8;
  border: 1rpx solid #e8e9e5;
  border-radius: 14rpx;
}

.schedule-day-picker-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-repeat-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.schedule-repeat-title {
  display: block;
  color: #34463a;
  font-size: 31rpx;
  font-weight: 700;
}

.schedule-repeat-sub {
  display: block;
  margin-top: 7rpx;
  color: #989c94;
  font-size: 22rpx;
}

.schedule-repeat-duration {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  color: var(--themeColor, #5b8a72);
  font-size: 21rpx;
  background: var(--projectColorLight, #edf5f0);
  border-radius: 999rpx;
}

.schedule-repeat-label {
  margin: 24rpx 0 14rpx;
  color: #4c554d;
  font-size: 26rpx;
  font-weight: 600;
}

.schedule-repeat-label text {
  color: #ee0a24;
}

.schedule-weekdays {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
}

.schedule-weekday {
  width: 76rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #7e857d;
  font-size: 22rpx;
  background: #fafaf8;
  border: 1rpx solid #e6e8e2;
  border-radius: 14rpx;
}

.schedule-weekday.is-selected {
  color: #fff;
  font-weight: 600;
}

.schedule-date-range {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.schedule-date-range picker {
  flex: 1;
  min-width: 0;
}

.schedule-date-picker,
.schedule-time-picker,
.schedule-time-end {
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 18rpx;
  color: #4b554d;
  font-size: 25rpx;
  background: #fafaf8;
  border: 1rpx solid #e8e9e5;
  border-radius: 14rpx;
}

.schedule-date-range-line,
.schedule-time-to {
  flex-shrink: 0;
  color: #a4a7a0;
  font-size: 23rpx;
}

.schedule-time-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.schedule-time-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.schedule-time-row picker,
.schedule-time-picker,
.schedule-time-end {
  flex: 1;
  min-width: 0;
}

.schedule-time-end {
  height: 70rpx;
  justify-content: flex-start;
  padding: 0;
  color: #667066;
  font-weight: 600;
  background: transparent;
  border: 0;
}

.schedule-add-time {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  background: #fafbf9;
  border: 1rpx dashed #d9ddd5;
  border-radius: 14rpx;
}

.schedule-edit-coach-field.coach-picker-field {
  padding: 24rpx 32rpx;
  background: #fff;
}

.schedule-edit-coach-field.coach-picker-field .coach-picker-label {
  width: 6.2em;
  color: #646566;
}

.schedule-edit-coach-field.coach-picker-field .coach-picker-value-wrap {
  flex: 1;
}

.schedule-edit-save {
  margin: 48rpx 32rpx 0;
}

.schedule-edit-del {
  margin: 24rpx 32rpx 0;
}

.schedule-edit-tip {
  padding: 16rpx 32rpx 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: #969799;
}

.schedule-calendar-wrap {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.schedule-calendar-popup {
  min-height: 930rpx;
}

.schedule-calendar-head {
  padding: 28rpx 32rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.schedule-calendar-wrap .van-calendar {
  height: 800rpx !important;
}

.schedule-course-field {
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #ebedf0;
}

.schedule-course-field-label {
  font-size: 28rpx;
  color: #646566;
  margin-bottom: 16rpx;
}

.schedule-course-required {
  color: #ee0a24;
  margin-left: 4rpx;
}

.schedule-course-selected,
.schedule-course-placeholder {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.schedule-course-placeholder {
  justify-content: space-between;
  font-size: 28rpx;
  color: #969799;
  padding: 8rpx 0;
}

.schedule-course-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.schedule-course-info {
  flex: 1;
  min-width: 0;
}

.schedule-course-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-course-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.schedule-course-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #c8c9cc;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.schedule-course-sheet {
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.schedule-course-sheet-head {
  padding: 28rpx 32rpx 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-shrink: 0;
}

.schedule-course-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #323233;
}

.schedule-course-sheet-sub {
  font-size: 24rpx;
  color: #969799;
}

.schedule-course-sheet-scroll {
  max-height: calc(75vh - 100rpx);
  padding: 8rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.schedule-course-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  border-left: 8rpx solid #81c784;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.schedule-course-option.is-active {
  background: var(--projectColorLight, #e5f1ec);
}

.schedule-course-option-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.schedule-course-option-body {
  flex: 1;
  min-width: 0;
}

.schedule-course-option-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-course-option-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.5;
}

.schedule-course-option-tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--themeColor, #5b8a72);
  background: var(--projectColorLight, #e5f1ec);
}

.schedule-course-option-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #c8c9cc;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
