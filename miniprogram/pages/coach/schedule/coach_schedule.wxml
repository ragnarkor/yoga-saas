<page-meta page-style="{{themeStyle}}" />
<view class="coach-page schedule-page">
  <coach-tenant-switch title="排课" show-back="{{true}}" theme-color="{{themeColor}}" nav-bg="{{themeNavBg}}" />

  <view class="schedule-top-placeholder" style="height:{{topControlsHeight}}px;"></view>
  <view class="schedule-top-controls" style="top:{{navBarHeight}}px;">
    <van-tabs
      wx:if="{{tabsReady}}"
      id="scheduleTabs"
      active="{{activeTab}}"
      color="{{themeColor}}"
      title-active-color="{{themeColor}}"
      line-width="40rpx"
      line-height="6rpx"
      ellipsis="{{false}}"
      bind:change="bindTabChange"
      custom-class="schedule-tabs"
    >
      <van-tab wx:for="{{tabs}}" wx:key="id" title="{{item.name}}" />
    </van-tabs>

    <view class="schedule-week-bar">
      <view class="schedule-week-btn" bindtap="bindPrevWeek">◀ 上周</view>
      <view class="schedule-week-range">{{weekLabel}}</view>
      <view class="schedule-week-btn" bindtap="bindNextWeek">下周 ▶</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="schedule-loading">
    <van-loading size="48rpx" color="{{themeColor}}">加载中...</van-loading>
  </view>

  <van-empty wx:elif="{{!gridRows.length}}" description="本周暂无排课">
    <van-button round color="{{themeColor}}" size="small" bind:click="bindGoSchedule">去排课</van-button>
  </van-empty>

  <scroll-view wx:else scroll-x enhanced show-scrollbar="{{false}}" class="schedule-scroll" enable-flex="{{false}}">
    <view class="schedule-grid-wrap">
      <view class="schedule-grid">
        <view class="schedule-row schedule-head">
          <view class="schedule-time-col schedule-time-col--head"></view>
          <view class="schedule-day-col schedule-day-col--head" wx:for="{{weekDays}}" wx:key="day">
            <text class="schedule-day-date">{{item.shortLabel}}</text>
            <text class="schedule-day-week">{{item.weekday}}</text>
          </view>
        </view>
        <view class="schedule-row" wx:for="{{gridRows}}" wx:for-index="rowIdx" wx:key="time">
          <view class="schedule-time-col">
            <text class="schedule-time-start">{{item.time}}</text>
            <view wx:if="{{item.end}}" class="schedule-time-axis-line"></view>
            <text wx:if="{{item.end}}" class="schedule-time-end-label">{{item.end}}</text>
          </view>
          <view
            class="schedule-day-col {{cell ? 'schedule-day-col--filled' : 'schedule-day-col--empty'}}"
            wx:for="{{item.cells}}"
            wx:for-item="cell"
            wx:for-index="dayIdx"
            wx:key="dayIdx"
            bindtap="{{cell ? '' : 'bindCellTap'}}"
            data-row="{{rowIdx}}"
            data-col="{{dayIdx}}"
            data-day="{{weekDays[dayIdx].day}}"
            data-time="{{item.time}}"
          >
            <block wx:if="{{cell && cell.mode === 'multi'}}">
              <view class="schedule-cell-stack">
                <view
                  wx:for="{{cell.items}}"
                  wx:for-item="slot"
                  wx:key="cardId"
                  class="schedule-card schedule-card--mini"
                  style="{{slot.cardStyle}}"
                  catchtap="bindSlotTap"
                  catchlongpress="bindSlotLongPress"
                  data-row="{{rowIdx}}"
                  data-col="{{dayIdx}}"
                  data-item-idx="{{index}}"
                >
                  <text class="schedule-card-teacher">{{slot.teacherName || '教练'}}</text>
                  <text class="schedule-card-title">{{slot.title}}</text>
                </view>
                <view
                  wx:if="{{cell.overflow > 0}}"
                  class="schedule-card-overflow"
                  catchtap="bindOverflowTap"
                  data-row="{{rowIdx}}"
                  data-col="{{dayIdx}}"
                >+{{cell.overflow}}</view>
              </view>
            </block>
            <view
              wx:elif="{{cell}}"
              class="schedule-card"
              style="{{cell.cardStyle}}"
              catchtap="bindSlotTap"
              catchlongpress="bindSlotLongPress"
              data-row="{{rowIdx}}"
              data-col="{{dayIdx}}"
              data-item-idx="0"
            >
              <text class="schedule-card-teacher">{{cell.teacherName || '教练'}}</text>
              <text class="schedule-card-title">{{cell.title}}</text>
              <text class="schedule-stars">{{cell.starText}}</text>
              <text class="schedule-card-meta">{{cell.duration}}m · {{cell.typeName}}</text>
            </view>
            <view wx:else class="schedule-empty-hint">+</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="schedule-bottom">
    <view class="schedule-bottom-item schedule-bottom-item--side">
      <van-button block icon="photo-o" color="{{themeColor}}" plain custom-class="schedule-bottom-button" bind:click="bindSaveImageTap">保存图片</van-button>
    </view>
    <view class="schedule-bottom-item schedule-bottom-item--copy">
      <van-button
        block
        icon="records"
        color="{{themeColor}}"
        plain
        loading="{{copying}}"
        custom-class="schedule-bottom-button"
        bind:click="bindCopyMonth"
      >复制月课表</van-button>
    </view>
    <view class="schedule-bottom-item schedule-bottom-item--side">
      <van-button block icon="plus" color="{{themeColor}}" custom-class="schedule-bottom-button" bind:click="bindGoSchedule">排课</van-button>
    </view>
  </view>

  <canvas
    type="2d"
    id="scheduleCanvas"
    class="schedule-canvas-hidden"
    style="height: {{canvasHeight}}px;"
  />

  <view wx:if="{{previewShow && previewUrl}}" class="schedule-poster-modal" bindtap="bindClosePreview">
    <view class="schedule-poster-preview" catchtap="noop">
      <image class="schedule-preview-img" src="{{previewUrl}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      <view class="schedule-poster-tools">
        <button class="schedule-poster-tool" hover-class="schedule-poster-tool--pressed" bindtap="bindConfirmSave">
          <view class="schedule-poster-tool-icon" style="background:{{themeColor}}"><van-icon name="down" size="32rpx" color="#fff" /></view>
          <text>保存到相册</text>
        </button>
        <button class="schedule-poster-tool" hover-class="schedule-poster-tool--pressed" bindtap="bindClosePreview">
          <view class="schedule-poster-tool-icon schedule-poster-tool-icon--done"><van-icon name="success" size="32rpx" color="{{themeColor}}" /></view>
          <text>完成</text>
        </button>
      </view>
    </view>
  </view>

  <van-action-sheet
    show="{{slotActionShow}}"
    actions="{{slotActions}}"
    cancel-text="取消"
    bind:select="bindSlotActionSelect"
    bind:close="bindSlotActionClose"
  />
</view>
