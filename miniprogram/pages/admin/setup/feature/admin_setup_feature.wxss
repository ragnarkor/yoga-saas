.main-admin {
  min-height: 100vh;
  background-color: #f7f8fa;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 200rpx;
}

.form-submit-wrap {
  padding: 30rpx;
}

.switch-touch {
  position: relative;
}

.switch-touch::before {
  content: "";
  position: absolute;
  inset: -14rpx;
}