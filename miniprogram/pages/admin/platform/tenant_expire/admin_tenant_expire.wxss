@import '../../../../style/project/base/admin.wxss';
@import '../tenant_form/admin_tenant_form.wxss';

.page-loading {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

.field--readonly {
  padding-bottom: 20rpx;
}

.readonly-value {
  display: block;
  font-size: 30rpx;
  color: var(--adminText);
  font-weight: 500;
}

.status-chip {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #4a7c8c;
  background: rgba(74, 124, 140, 0.12);
}

.status-chip--warn {
  color: #ee0a24;
  background: rgba(238, 10, 36, 0.1);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-row-text {
  font-size: 28rpx;
  color: var(--adminText);
}

.field-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--adminTextSecondary);
  line-height: 1.5;
}

.inline-btn {
  position: relative;
  margin-top: 20rpx;
  background: var(--adminColor);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  border: none;
}

.inline-btn::before {
  content: "";
  position: absolute;
  inset: -6rpx;
}

.inline-btn::after {
  border: none;
}

.feature-link {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: var(--adminPageBg);
  border: 1rpx solid var(--adminBorder);
  font-size: 28rpx;
  color: var(--adminText);
}

.feature-link::before {
  content: "";
  position: absolute;
  inset: -5rpx;
}

.feature-link-arrow {
  color: #c8c9cc;
  font-size: 32rpx;
}

.expire-mode-row {
  display: flex;
  gap: 16rpx;
}

.expire-mode {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--adminBorder);
  background: var(--adminPageBg);
  color: var(--adminTextSecondary);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.expire-mode.is-active {
  color: var(--adminColor);
  border-color: var(--adminColor);
  background: var(--adminIconBg);
  font-weight: 500;
}

.expire-day-pick {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: var(--adminPageBg);
  border: 1rpx solid var(--adminBorder);
  font-size: 28rpx;
  color: var(--adminText);
}

.danger-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid rgba(238, 10, 36, 0.18);
}

.danger-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ee0a24;
}

.danger-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--adminTextSecondary);
  line-height: 1.5;
}

.danger-input {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: var(--adminPageBg);
  border: 1rpx solid var(--adminBorder);
  font-size: 28rpx;
}

.danger-btn {
  position: relative;
  margin-top: 20rpx;
  background: #ee0a24;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  border: none;
}

.danger-btn::before {
  content: "";
  position: absolute;
  inset: -6rpx;
}

.danger-btn::after {
  border: none;
}
