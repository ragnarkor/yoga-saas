.audit-list {
  padding: 18rpx 24rpx 36rpx;
}

.audit-total {
  padding: 0 4rpx 18rpx;
  font-size: 23rpx;
  color: var(--adminTextSecondary);
}

.audit-item {
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx 18rpx;
  background: var(--adminSurface);
  border-radius: var(--adminRadiusLg);
  box-shadow: var(--adminShadowSm);
}
.audit-head-left { display: flex; align-items: center; min-width: 0; }
.audit-symbol { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; margin-right:16rpx; border-radius:18rpx; background:var(--adminColorLight); color:var(--adminColor); font-size:25rpx; font-weight:700; }

.audit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.audit-action {
  font-size: 28rpx;
  color: var(--adminText);
  font-weight: 600;
}

/* 删除馆等高危动作醒目标红 */
.audit-action--tenant_del {
  color: var(--adminRedColor);
}
.audit-operator { display:block; margin-top:4rpx; color:var(--adminTextSecondary); font-size:22rpx; }

.audit-time {
  font-size: 21rpx;
  color: var(--adminTextTertiary);
}

.audit-content {
  margin-top: 20rpx;
  padding: 17rpx 18rpx;
  border-radius: var(--adminRadiusSm);
  background: #f7f9fa;
  font-size: 25rpx;
  color: #405057;
  line-height: 1.65;
  word-break: break-all;
}

.audit-meta {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.audit-meta-item {
  font-size: 21rpx;
  color: var(--adminTextSecondary);
}

.audit-diff {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--adminRadiusSm);
  background: #f9fafb;
  font-size: 23rpx;
}

.audit-diff-before {
  color: #969799;
  text-decoration: line-through;
}

.audit-diff-arrow {
  color: #c8c9cc;
}

.audit-diff-after {
  color: #323233;
}
