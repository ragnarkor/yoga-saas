<block wx:if="{{isAdmin}}">
	<cmpt-comm-list type="admin_log_list" search="{{search}}" _menus="{{sortMenus}}" _items="{{sortItems}}" sortMenusDefaultIndex="0" route="admin/log_list" topBottom="50" placeholder="搜索标题，IP地址" bind:list="bindCommListCmpt">

		<!-- List Begin -->
		<view class="operation-log-list">
			<view wx:if="{{dataList && dataList.total }}" class="log-list-summary">共 {{dataList.total}} 条操作记录</view>
			<view class="operation-log-card" wx:for="{{dataList.list}}" wx:key="key">
				<view class="operation-log-top">
					<view class="operation-log-badge">操</view>
					<view class="operation-log-title"><text>{{item.LOG_TYPE_DESC || '系统'}}操作</text><text>{{item.LOG_ADMIN_NAME || '系统管理员'}}</text></view>
					<text class="operation-log-time">{{item.LOG_ADD_TIME}}</text>
				</view>
				<view class="operation-log-content">{{item.LOG_CONTENT || '—'}}</view>
				<view class="operation-log-footer"><text wx:if="{{item.LOG_ADD_IP}}">IP · {{item.LOG_ADD_IP}}</text><text wx:else>平台后台操作记录</text></view>
			</view>
		</view>
		<!-- List END --> 

		<!--load begin-->
		<import src="../../../../tpls/public/list_load_tpl.wxml" />
		<template is="listLoadTpl" data="{{dataList, skin:'text-grey'}}" />
		<!--load end--> 

	</cmpt-comm-list>
</block>
