<!-- Tab 切换 -->
<view class="platform-tabs" aria-role="tablist">
  <view class="platform-tab {{platformTab === 0 ? 'platform-tab--active' : ''}}" bindtap="onPlatformTabTap" data-tab="0" aria-role="tab" aria-selected="{{platformTab === 0}}">
    <text>概览</text>
  </view>
  <view class="platform-tab {{platformTab === 1 ? 'platform-tab--active' : ''}}" bindtap="onPlatformTabTap" data-tab="1" aria-role="tab" aria-selected="{{platformTab === 1}}">
    <text>瑜伽馆</text>
    <text class="platform-tab-count">{{data.tenantList.length || 0}}</text>
  </view>
</view>

<!-- Tab 0: 概览 -->
<block wx:if="{{platformTab === 0}}">
  <!-- 租户健康度看板 -->
  <view class="platform-section" wx:if="{{data.health}}">
    <view class="platform-section-head">
      <text class="platform-section-title">运营健康度</text>
      <text class="platform-health-time">{{data.healthDetail.generatedAt}}</text>
    </view>
    <view class="platform-health-grid">
      <view class="platform-health-item {{data.health.zombieCount > 0 ? 'is-warn' : ''}}"
        bindtap="bindHealthDetailTap" data-type="zombie" aria-role="button" aria-label="僵尸馆，30天零预约，共{{data.health.zombieCount}}家，查看明细">
        <text class="platform-health-num">{{data.health.zombieCount}}</text>
        <text class="platform-health-label">僵尸馆</text>
        <text class="platform-health-hint">30天零预约</text>
      </view>
      <view class="platform-health-item {{data.health.expiringCount > 0 ? 'is-warn' : ''}}"
        bindtap="bindHealthDetailTap" data-type="expiring" aria-role="button" aria-label="到期预警，即将或已到期，共{{data.health.expiringCount}}家，查看明细">
        <text class="platform-health-num">{{data.health.expiringCount}}</text>
        <text class="platform-health-label">到期预警</text>
        <text class="platform-health-hint">即将/已到期</text>
      </view>
      <view class="platform-health-item {{data.health.stagnantCount > 0 ? 'is-warn' : ''}}"
        bindtap="bindHealthDetailTap" data-type="stagnant" aria-role="button" aria-label="增长停滞，本月零新增，共{{data.health.stagnantCount}}家，查看明细">
        <text class="platform-health-num">{{data.health.stagnantCount}}</text>
        <text class="platform-health-label">增长停滞</text>
        <text class="platform-health-hint">本月零新增</text>
      </view>
    </view>
  </view>

  <view class="platform-section">
    <view class="platform-section-head">
      <text class="platform-section-title">快捷操作</text>
    </view>
    <view class="platform-action-grid">
      <view class="platform-action-item" bindtap="url" data-url="/pages/admin/platform/tenant_form/admin_tenant_form" aria-role="button" aria-label="新建瑜伽馆">
        <view class="platform-action-icon">
          <van-icon name="add-o" size="40rpx" color="#4a7c8c" />
        </view>
        <text class="platform-action-text">新建瑜伽馆</text>
      </view>
      <view class="platform-action-item" bindtap="url" data-url="/pages/admin/platform/mgr_form/admin_mgr_form" aria-role="button" aria-label="新建管理员">
        <view class="platform-action-icon">
          <van-icon name="manager-o" size="40rpx" color="#4a7c8c" />
        </view>
        <text class="platform-action-text">新建管理员</text>
      </view>
      <view class="platform-action-item" bindtap="bindPlatformTenantTabTap" aria-role="button" aria-label="瑜伽馆管理">
        <view class="platform-action-icon">
          <van-icon name="shop-o" size="40rpx" color="#4a7c8c" />
        </view>
        <text class="platform-action-text">瑜伽馆管理</text>
      </view>
      <view class="platform-action-item" bindtap="bindStaffManageTap" aria-role="button" aria-label="管理员配置">
        <view class="platform-action-icon">
          <van-icon name="friends-o" size="40rpx" color="#4a7c8c" />
        </view>
        <text class="platform-action-text">管理员配置</text>
      </view>
    </view>
  </view>

  <view class="platform-section platform-section--footer">
    <view class="platform-section-head">
      <text class="platform-section-title">系统</text>
    </view>
    <view class="platform-menu-item" bindtap="url" data-url="/pages/admin/mgr/log/admin_log_list" aria-role="button" aria-label="操作日志">
      <van-icon name="description" size="32rpx" color="#4a7c8c" />
      <text class="platform-menu-text">操作日志</text>
      <van-icon name="arrow" size="24rpx" color="#c8c9cc" />
    </view>
    <view class="platform-menu-item" bindtap="url" data-url="/pages/admin/platform/audit_log/admin_audit_log" aria-role="button" aria-label="平台审计日志">
      <van-icon name="shield-o" size="32rpx" color="#4a7c8c" />
      <text class="platform-menu-text">平台审计日志</text>
      <van-icon name="arrow" size="24rpx" color="#c8c9cc" />
    </view>
    <view class="platform-menu-item" bindtap="bindSettingTap" aria-role="button" aria-label="清除缓存">
      <van-icon name="delete-o" size="32rpx" color="#4a7c8c" />
      <text class="platform-menu-text">清除缓存</text>
      <van-icon name="arrow" size="24rpx" color="#c8c9cc" />
    </view>
  </view>
</block>

<!-- Tab 1: 瑜伽馆 -->
<block wx:else>
  <view class="platform-section">
    <view wx:if="{{!data.tenantList.length}}" class="empty-block">暂无瑜伽馆，点击上方新建</view>
    <view class="tenant-row {{item.isClosed ? 'tenant-row--closed' : ''}}" wx:for="{{data.tenantList}}" wx:key="TENANT_ID">
      <view class="tenant-row-main">
        <view class="tenant-row-title-line">
          <text class="tenant-row-name">{{item.TENANT_NAME}}</text>
          <text class="tenant-row-badge tenant-row-badge--closed" wx:if="{{item.isClosed}}">已停用</text>
        </view>
        <text class="tenant-row-desc" wx:if="{{item.TENANT_DESC}}">{{item.TENANT_DESC}}</text>
        <text class="tenant-row-meta {{item.isClosed ? 'tenant-row-meta--warn' : (item.isExpired ? 'tenant-row-meta--warn' : (item.isExpiringSoon ? 'tenant-row-meta--soon' : ''))}}">{{item.statusDesc}} · {{item.expireDesc}}</text>
      </view>
      <view class="tenant-row-actions">
        <view
          class="tenant-row-btn tenant-row-btn--ghost"
          data-pid="{{item._pid}}"
          data-name="{{item.TENANT_NAME}}"
          bindtap="bindTenantManageTap"
          aria-role="button"
          aria-label="管理{{item.TENANT_NAME}}"
        >管理</view>
        <view
          class="tenant-row-btn tenant-row-btn--ghost"
          data-pid="{{item._pid}}"
          data-name="{{item.TENANT_NAME}}"
          bindtap="bindTenantFeatureTap"
          aria-role="button"
          aria-label="{{item.TENANT_NAME}}功能设置"
        >功能</view>
        <view class="tenant-row-btn" data-item="{{item}}" bindtap="bindEnterCoachTap" aria-role="button" aria-label="进入{{item.TENANT_NAME}}">进入</view>
      </view>
    </view>
  </view>
</block>

<!-- 健康度明细弹层 -->
<van-popup show="{{ healthModalShow }}" position="bottom" round bind:close="bindHealthModalCloseTap" custom-style="max-height:70%;">
  <view class="health-modal">
    <view class="health-modal-head">
      <text class="health-modal-title">{{ healthModalTitle }}</text>
      <van-icon class="health-modal-close" name="cross" size="36rpx" color="#969799" bindtap="bindHealthModalCloseTap" aria-role="button" aria-label="关闭" />
    </view>
    <view wx:if="{{ !healthModalList.length }}" class="empty-block">暂无相关瑜伽馆</view>
    <scroll-view scroll-y class="health-modal-list" wx:else>
      <view class="health-modal-item" wx:for="{{ healthModalList }}" wx:key="_pid">
        <view class="health-modal-item-main">
          <text class="health-modal-item-name">{{ item.TENANT_NAME }}</text>
          <text class="health-modal-item-meta" wx:if="{{ healthModalType === 'zombie' }}">最近活跃：{{ item.lastActiveDesc }} · 会员 {{ item.members }}</text>
          <text class="health-modal-item-meta" wx:elif="{{ healthModalType === 'expiring' }}">{{ item.expireDesc }} · 近30天预约 {{ item.recentJoins }}</text>
          <text class="health-modal-item-meta" wx:else>会员 {{ item.members }} · 本月新增 {{ item.newMembers }}</text>
        </view>
        <view class="health-modal-item-btn" data-pid="{{ item._pid }}" data-name="{{ item.TENANT_NAME }}" bindtap="bindHealthEnterTap" aria-role="button" aria-label="进入{{ item.TENANT_NAME }}管理">管理</view>
      </view>
    </scroll-view>
  </view>
</van-popup>
