/* [AI_START TIMESTAMP=2025-01-20 12:35:00] */

.main {
  padding: 0;
}

.main .upside {
  background: linear-gradient(
    135deg,
    var(--projectColorDark, #4a7160) 0%,
    var(--projectColor, #5b8a72) 100%
  );
  height: 250rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.main .upside::before {
  content: "";
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.main .upside::after {
  content: "";
  position: absolute;
  bottom: -120rpx;
  left: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}

.main .upside .upImg {
  height: inherit;
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.main .upside .user-bar {
  width: 100%;
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  padding-left: 40rpx;
  position: relative;
  z-index: 2;
}

.main .upside .user-bar .detail {
  flex: 1;
  margin-left: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  color: #fff;
  box-sizing: border-box;
  min-width: 0;
}

.main .down {
  box-sizing: border-box;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
  position: relative;
  z-index: 3;
}

