.ucp-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.ucp-field-label {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  line-height: 1.2;
  font-size: var(--cell-font-size, 28rpx);
  color: #646566;
}

.ucp-field-value-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.ucp-field-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--cell-font-size, 28rpx);
  line-height: 1.2;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ucp-field-value--placeholder {
  color: #969799;
}

.ucp-sheet {
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  box-sizing: border-box;
}

.ucp-sheet-head {
  padding: 8rpx 32rpx 16rpx;
}

.ucp-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.ucp-sheet-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.ucp-sheet-scroll {
  max-height: 52vh;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.ucp-popup {
  border-radius: 20rpx 20rpx 0 0 !important;
}

.ucp-card-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 18rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.ucp-card-item.is-active {
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.12);
  outline: 2rpx solid var(--projectColor, #5b8a72);
  outline-offset: -2rpx;
}

.ucp-card-item:active {
  transform: translateY(1rpx);
}

.ucp-card-visual {
  position: relative;
  width: 86rpx;
  height: 56rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.ucp-card-visual-img,
.ucp-card-visual-solid {
  width: 100%;
  height: 100%;
  display: block;
}

.ucp-card-type {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6rpx;
  text-align: center;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.ucp-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ucp-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.ucp-card-sub {
  font-size: 24rpx;
  color: #969799;
}

