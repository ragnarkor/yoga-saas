.ucp-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.ucp-field-label {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  line-height: 1.2;
  font-size: var(--cell-font-size, 28rpx);
  color: #646566;
}

.ucp-field-value-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.ucp-field-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--cell-font-size, 28rpx);
  line-height: 1.2;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ucp-field-value--placeholder {
  color: #969799;
}

.ucp-sheet {
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.ucp-sheet-head {
  padding: 8rpx 8rpx 24rpx;
}

.ucp-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.ucp-sheet-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.ucp-sheet-loading {
  padding: 48rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ucp-sheet-scroll {
  max-height: 60vh;
}

.ucp-popup {
  border-radius: 20rpx 20rpx 0 0 !important;
}

.ucp-card-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #f0f1f3;
  border-radius: 16rpx;
}

.ucp-card-option.is-selected {
  background: rgba(91, 138, 114, 0.08);
  border: 2rpx solid var(--projectColor, #5b8a72);
}

.ucp-card-option:active {
  background: #f7f8fa;
}

.ucp-card-option.is-selected:active {
  background: rgba(91, 138, 114, 0.12);
}

.ucp-card-option-visual {
  position: relative;
  width: 88rpx;
  height: 56rpx;
  border-radius: 10rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.ucp-card-option-img,
.ucp-card-option-solid {
  width: 100%;
  height: 100%;
  display: block;
}

.ucp-card-option-type {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6rpx;
  text-align: center;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.ucp-card-option-body {
  flex: 1;
  min-width: 0;
}

.ucp-card-option-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.ucp-card-option-balance {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #646566;
}

.ucp-card-option-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #969799;
}
