<!-- 会员持卡选择（代约/预约扣次，样式与用户端选卡弹窗一致） -->
<view class="ucp-field field-class" bindtap="bindFieldTap">
  <view class="ucp-field-label course-edit-field-label-inline {{required ? 'course-edit-field-label-inline--required' : ''}}">{{label}}</view>
  <view class="ucp-field-value-wrap">
    <view class="ucp-field-value {{selectedCard ? '' : 'ucp-field-value--placeholder'}}">
      {{displayText}}
    </view>
    <van-icon name="arrow" size="32rpx" color="#c8c9cc" />
  </view>
</view>

<van-popup show="{{sheetShow}}" position="bottom" round bind:close="bindCloseSheet" custom-class="ucp-popup">
  <view class="ucp-sheet">
    <view class="ucp-sheet-head">
      <text class="ucp-sheet-title">选择划扣会员卡</text>
      <text wx:if="{{meetId}}" class="ucp-sheet-sub">仅显示适用于本课程的会员卡</text>
      <text wx:else class="ucp-sheet-sub">选择会员持有的可用卡</text>
    </view>
    <view wx:if="{{loading}}" class="ucp-sheet-loading">
      <van-loading size="40rpx" color="{{themeColor}}">加载中...</van-loading>
    </view>
    <scroll-view wx:else scroll-y class="ucp-sheet-scroll" enhanced show-scrollbar="{{false}}">
      <view
        class="ucp-card-option {{value === item.id ? 'is-selected' : ''}}"
        wx:for="{{cardList}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="bindCardPick"
      >
        <view class="ucp-card-option-visual">
          <image
            wx:if="{{item.coverUrl}}"
            class="ucp-card-option-img"
            src="{{item.coverUrl}}"
            mode="aspectFill"
          />
          <view
            wx:else
            class="ucp-card-option-solid"
            style="background: {{item.color}};"
          ></view>
          <text class="ucp-card-option-type">{{item.typeLabel}}</text>
        </view>
        <view class="ucp-card-option-body">
          <text class="ucp-card-option-name">{{item.name}}</text>
          <text class="ucp-card-option-balance">{{item.balanceText}}</text>
          <text class="ucp-card-option-hint">{{item.deductHint || ''}}</text>
        </view>
        <van-icon wx:if="{{value === item.id}}" name="success" size="36rpx" color="{{themeColor}}" />
        <van-icon wx:else name="arrow" size="32rpx" color="#c8c9cc" />
      </view>
      <van-empty wx:if="{{!cardList.length}}" description="{{emptyDesc}}" />
    </scroll-view>
  </view>
</van-popup>
