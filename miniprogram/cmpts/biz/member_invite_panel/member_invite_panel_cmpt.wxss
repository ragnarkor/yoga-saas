.panel {
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  max-height: 85vh;
  overflow-y: auto;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}

.panel-close {
  padding: 8rpx;
}

.panel-loading {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

.invite-poster {
  width: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(31, 35, 41, 0.12);
}

.invite-poster-main {
  position: relative;
  width: 100%;
  aspect-ratio: 750 / 864;
  min-height: 792rpx;
}

.invite-poster-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.invite-poster-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.12) 0%,
    rgba(255, 255, 255, 0.04) 42%,
    rgba(0, 0, 0, 0.12) 100%
  );
  pointer-events: none;
}

.invite-poster-body {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.invite-poster-head {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.28);
}

.invite-qr-shell {
  width: 280rpx;
  height: 280rpx;
  margin: 32rpx 0 28rpx;
  padding: 12rpx;
  border-radius: 50%;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
}

.invite-qr {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.invite-qr-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}

.invite-poster-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.55;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}

.invite-poster-foot {
  width: 100%;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.invite-actions {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 0 12rpx;
}

.invite-action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  border: 1rpx solid transparent;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.invite-action-btn::after {
  border: none;
}

.invite-action-btn--primary {
  color: #fff;
}

.invite-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding-bottom: 8rpx;
}

.invite-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 960px;
  pointer-events: none;
}
