.invite-fullscreen-modal {
  position: fixed;
  z-index: 10000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(16, 21, 19, 0.82);
}

.panel-loading {
  min-height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.invite-poster-scene {
  width: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.invite-poster {
  width: 100%;
  max-width: 600rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(31, 35, 41, 0.12);
}

.invite-poster-main {
  position: relative;
  width: 100%;
  aspect-ratio: 750 / 864;
  min-height: 0;
}

.invite-poster-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.invite-poster-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.12) 0%,
    rgba(255, 255, 255, 0.04) 42%,
    rgba(0, 0, 0, 0.12) 100%
  );
  pointer-events: none;
}

.invite-poster-body {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.invite-poster-head {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.28);
}

.invite-qr-shell {
  width: 280rpx;
  height: 280rpx;
  margin: 32rpx 0 28rpx;
  padding: 12rpx;
  border-radius: 50%;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
}

.invite-qr {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.invite-qr-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}

.invite-poster-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.55;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}

.invite-poster-foot {
  width: 100%;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.invite-actions {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 68rpx;
  padding: 32rpx 0 12rpx;
}

.invite-action-btn {
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 13rpx;
  color: #646a73;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.2;
  border: 0;
  padding: 0;
  margin: 0;
  background: transparent;
}

.invite-action-btn::after {
  border: none;
}

.invite-action-icon {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(31, 35, 41, 0.14);
}

.invite-action-icon--share { background: #f4f5f7; }

.invite-tip {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  padding-bottom: 8rpx;
}

.invite-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 960px;
  pointer-events: none;
}
