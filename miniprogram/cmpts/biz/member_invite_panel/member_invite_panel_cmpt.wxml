<root-portal>
<van-popup
  show="{{ show }}"
  position="bottom"
  round
  z-index="{{10000}}"
  safe-area-inset-bottom
  bind:close="bindCloseTap"
>
  <view class="panel">
    <view class="panel-header">
      <text class="panel-title">邀请会员</text>
      <view class="panel-close" bindtap="bindCloseTap">
        <van-icon name="cross" size="36rpx" color="#999" />
      </view>
    </view>

    <view wx:if="{{loading}}" class="panel-loading">
      <van-loading size="48rpx" color="{{accentColor}}">生成邀请码...</van-loading>
    </view>

    <block wx:else>
      <view class="invite-poster">
        <view class="invite-poster-main">
          <image
            class="invite-poster-bg"
            src="/pages/coach/images/member_invite_poster.jpg?v=3"
            mode="aspectFill"
          />
          <view class="invite-poster-overlay"></view>
          <view class="invite-poster-body">
            <view class="invite-poster-head">{{slogan}}</view>
            <view class="invite-qr-shell">
              <image
                wx:if="{{qrUrl}}"
                class="invite-qr"
                src="{{qrUrl}}"
                mode="aspectFit"
                show-menu-by-longpress="{{true}}"
              />
              <view wx:else class="invite-qr-placeholder">二维码加载失败</view>
            </view>
            <view class="invite-poster-hint">微信扫一扫或</view>
            <view class="invite-poster-hint">微信长按识别</view>
          </view>
        </view>
        <view class="invite-poster-foot" style="background: {{accentColor}};">
          {{tenantName}}（门店）
        </view>
      </view>

      <view class="invite-actions">
        <button
          class="invite-action-btn invite-action-btn--ghost"
          style="color: {{accentColor}}; border-color: {{accentColor}}33; background: #fff;"
          open-type="share"
        >
          <van-icon name="share-o" size="36rpx" color="{{accentColor}}" />
          <text>发送给朋友</text>
        </button>
        <view
          class="invite-action-btn invite-action-btn--primary"
          style="background: {{accentColor}};"
          bindtap="bindSaveTap"
        >
          <van-icon name="photo-o" size="36rpx" color="#fff" />
          <text>保存图片</text>
        </view>
      </view>

      <view class="invite-tip">会员扫码后将自动加入本馆</view>
    </block>
  </view>
</van-popup>

<canvas type="2d" id="inviteCanvas" class="invite-canvas" />
</root-portal>
