<!-- 与 van-field / 卡面颜色等表单项同一套 inline 行样式 -->
<view class="mcp-field course-edit-field course-edit-field--inline" bindtap="bindFieldTap">
  <text class="course-edit-field-label-inline {{required ? 'course-edit-field-label-inline--required' : ''}}">{{label}}</text>
  <view class="course-edit-field-row course-edit-field-row--inline">
    <text class="course-edit-field-value {{fieldValueIsPlaceholder ? 'course-edit-field-placeholder-text' : ''}}">{{fieldValue}}</text>
    <van-icon name="arrow" size="32rpx" color="#c8c9cc" />
  </view>
</view>

<van-popup
  show="{{sheetShow}}"
  position="bottom"
  round
  bind:close="bindCloseSheet"
  custom-class="course-edit-popup"
>
  <view class="course-edit-sheet">
    <view class="course-edit-sheet-head">
      <text class="course-edit-sheet-title">{{sheetTitle}}</text>
      <text class="course-edit-sheet-sub">{{sheetSub}}</text>
    </view>

    <scroll-view scroll-y class="course-edit-sheet-scroll" enhanced show-scrollbar="{{false}}">
      <!-- single：课程类型单选 -->
      <block wx:if="{{mode === 'single'}}">
        <view
          class="course-edit-type-item {{value === item.id ? 'is-active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="bindTypePick"
        >
          <view class="course-edit-type-dot"></view>
          <text class="course-edit-type-name">{{item.name}}</text>
          <view class="course-edit-type-check" wx:if="{{value === item.id}}">
            <van-icon name="success" size="32rpx" color="{{themeColor}}" />
          </view>
        </view>
        <van-empty
          wx:if="{{!categories.length && !loading}}"
          description="暂无课程分类，请先在「我的门店」配置"
        />
      </block>

      <!-- scope：分类 Tab + 课程多选。选择「分类全选」会自动包含后续新增课程，勾单课则精确指定 -->
      <block wx:elif="{{mode === 'scope'}}">
        <scroll-view scroll-x class="mcp-tabs" enhanced show-scrollbar="{{false}}">
          <view class="mcp-tabs-inner">
            <view
              class="mcp-tab {{tab.typeId === draftActiveTab ? 'is-active' : ''}}"
              wx:for="{{tabList}}"
              wx:key="typeId"
              wx:for-item="tab"
              data-type-id="{{tab.typeId}}"
              bindtap="bindTabTap"
            >
              <text class="mcp-tab-name">{{tab.typeName}}</text>
              <text wx:if="{{tab.badge}}" class="mcp-tab-badge {{tab.full ? 'is-full' : ''}}">{{tab.badge}}</text>
            </view>
          </view>
        </scroll-view>

        <view wx:if="{{!meetsLoaded}}" class="mcp-hint">课程加载中…</view>
        <block wx:else>
          <!-- 全部 Tab：全馆总开关 -->
          <view
            wx:if="{{draftActiveTab === ''}}"
            class="mcp-quick {{draftAllChecked ? 'is-active' : ''}}"
            bindtap="bindDraftAllToggle"
          >
            <view class="mcp-opt-text">
              <text class="mcp-quick-name">全部课程</text>
              <text class="mcp-opt-sub">馆内所有课程都可用，含后续新增</text>
            </view>
            <view class="mcp-meet-check">
              <van-icon wx:if="{{draftAllChecked}}" name="success" size="32rpx" color="{{themeColor}}" />
            </view>
          </view>
          <!-- 分类 Tab：分类全选快捷行 -->
          <view
            wx:elif="{{activeCateName}}"
            class="mcp-quick {{activeCateFull ? 'is-active' : ''}}"
            data-type-id="{{draftActiveTab}}"
            catchtap="bindDraftGroupToggle"
          >
            <view class="mcp-opt-text">
              <text class="mcp-quick-name">全选{{activeCateName}}分类</text>
              <text class="mcp-opt-sub">本分类现有及后续新增课程均可使用</text>
            </view>
            <view class="mcp-meet-check">
              <van-icon wx:if="{{activeCateFull}}" name="success" size="32rpx" color="{{themeColor}}" />
            </view>
          </view>

          <view class="mcp-meet-list">
            <view
              class="mcp-meet {{item.selected ? 'is-active' : ''}}"
              wx:for="{{activeMeets}}"
              wx:key="id"
              data-id="{{item.id}}"
              data-type-id="{{item.typeId}}"
              bindtap="bindDraftMeetToggle"
            >
              <text class="mcp-meet-name">{{item.name}}</text>
              <view class="mcp-meet-check">
                <van-icon wx:if="{{item.selected}}" name="success" size="28rpx" color="{{themeColor}}" />
              </view>
            </view>
            <van-empty wx:if="{{!activeMeets.length}}" description="{{emptyMeetText}}" />
          </view>
        </block>
      </block>
    </scroll-view>

    <!-- scope 模式：取消（丢弃草稿） / 确定（带已选计数，提交生效） -->
    <view wx:if="{{mode === 'scope'}}" class="mcp-foot">
      <view class="mcp-foot-btn mcp-foot-btn--ghost" bindtap="bindSheetCancel">取消</view>
      <view class="mcp-foot-btn mcp-foot-btn--main" bindtap="bindSheetConfirm">确定{{draftCountText}}</view>
    </view>
  </view>
</van-popup>
