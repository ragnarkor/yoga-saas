/* 表单项行（与 coach_course_edit course-edit-field--inline 一致） */
.mcp-field.course-edit-field {
  padding: var(--cell-vertical-padding, 24rpx)
    var(--cell-horizontal-padding, 32rpx);
  background: #fff;
  border-bottom: 1rpx solid var(--neutralBorder, #ebedf0);
  box-sizing: border-box;
}

.mcp-field.course-edit-field--inline {
  display: flex;
  align-items: center;
  gap: var(--cell-horizontal-padding, 32rpx);
  min-height: var(--cell-line-height, 48rpx);
}

.course-edit-field-label-inline {
  width: 6.2em;
  max-width: 6.2em;
  font-size: var(--cell-font-size, 28rpx);
  color: #646566;
  flex-shrink: 0;
  line-height: var(--cell-line-height, 48rpx);
}

.course-edit-field-label-inline--required::before {
  content: "*";
  color: #ee0a24;
  margin-right: 4rpx;
}

.course-edit-field-row--inline {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
}

.course-edit-field-row--inline .course-edit-field-value,
.course-edit-field-row--inline .course-edit-field-placeholder-text {
  flex: 1;
  min-width: 0;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-edit-field-value {
  font-size: var(--cell-font-size, 28rpx);
  color: #323233;
}

.course-edit-field-placeholder-text {
  font-size: var(--cell-font-size, 28rpx);
  color: #969799;
}

/* 弹层选项列表（与课程编辑 type-item 一致） */
.course-edit-type-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  margin: 0 0 12rpx;
  border-radius: 16rpx;
  background: var(--neutralBg, #f7f8fa);
  transition: all 0.2s ease;
}

.course-edit-type-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #c8c9cc;
  transition: background 0.2s ease;
}

.course-edit-type-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--neutralText, #323233);
}

.course-edit-type-check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.course-edit-type-item.is-active {
  background: var(--projectColorLight, #e5f1ec);
}

.course-edit-type-item.is-active .course-edit-type-name {
  color: var(--themeColor, #5b8a72);
  font-weight: 600;
}

.course-edit-type-item.is-active .course-edit-type-dot {
  background: var(--themeColor, #5b8a72);
  box-shadow: 0 0 0 6rpx rgba(91, 138, 114, 0.15);
}

.course-edit-popup {
  border-radius: 20rpx 20rpx 0 0 !important;
}

.course-edit-sheet {
  height: 72vh;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.course-edit-sheet-head {
  padding: 28rpx 32rpx 12rpx;
  flex-shrink: 0;
}

.course-edit-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #323233;
}

.course-edit-sheet-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #969799;
}

.course-edit-sheet-scroll {
  flex: 1;
  min-height: 0;
  max-height: none;
  padding: 8rpx 24rpx 20rpx;
  box-sizing: border-box;
}

.mcp-hint {
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #969799;
}

/* scope 选项行（复用 course-edit-type-item 视觉，附副标题） */
.mcp-opt-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mcp-opt-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

/* 分类 Tab 条：横向滑动胶囊，徽标实时反馈已选（数字/整类） */
.mcp-tabs {
  width: 100%;
  white-space: nowrap;
}

.mcp-tabs-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

.mcp-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: var(--neutralBg, #f7f8fa);
  color: #646566;
  font-size: 26rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.mcp-tab-name {
  line-height: 72rpx;
}

.mcp-tab-badge {
  font-size: 20rpx;
  color: #969799;
  background: #fff;
  border-radius: 16rpx;
  padding: 2rpx 10rpx;
  line-height: 28rpx;
}

.mcp-tab-badge.is-full {
  color: #fff;
  background: var(--themeColor, #5b8a72);
}

.mcp-tab.is-active {
  background: var(--projectColorLight, #e5f1ec);
  color: var(--themeColor, #5b8a72);
  font-weight: 600;
}

/* 分类全选/全馆快捷行：选中时展示主题框与勾选 */
.mcp-quick {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e8eaed;
  background: #fff;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.mcp-quick-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--neutralText, #323233);
}

.mcp-quick.is-active {
  border-color: var(--themeColor, #5b8a72);
  border-style: solid;
  background: var(--projectColorLight, #e5f1ec);
}

.mcp-quick.is-active .mcp-quick-name {
  color: var(--themeColor, #5b8a72);
}

/* 课程多选列表 */
.mcp-meet-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mcp-meet {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--neutralBg, #f7f8fa);
  transition: all 0.2s ease;
}

.mcp-meet.is-active {
  background: var(--projectColorLight, #e5f1ec);
}

.mcp-meet-name {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: var(--neutralText, #323233);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mcp-meet.is-active .mcp-meet-name {
  color: var(--themeColor, #5b8a72);
  font-weight: 600;
}

.mcp-meet-check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* scope 底部：取消 / 确定 */
.mcp-foot {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--neutralBorder, #ebedf0);
}

.mcp-foot-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.mcp-foot-btn--ghost {
  background: var(--neutralBg, #f7f8fa);
  color: #646566;
}

.mcp-foot-btn--main {
  background: var(--themeColor, #5b8a72);
  color: #fff;
  font-weight: 600;
}
