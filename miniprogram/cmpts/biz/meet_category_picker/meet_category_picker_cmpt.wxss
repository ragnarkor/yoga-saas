/* 表单项行（与 coach_course_edit course-edit-field--inline 一致） */
.mcp-field.course-edit-field {
  padding: var(--cell-vertical-padding, 24rpx) var(--cell-horizontal-padding, 32rpx);
  background: #fff;
  border-bottom: 1rpx solid var(--neutralBorder, #ebedf0);
  box-sizing: border-box;
}

.mcp-field.course-edit-field--inline {
  display: flex;
  align-items: center;
  gap: var(--cell-horizontal-padding, 32rpx);
  min-height: var(--cell-line-height, 48rpx);
}

.course-edit-field-label-inline {
  width: 6.2em;
  max-width: 6.2em;
  font-size: var(--cell-font-size, 28rpx);
  color: #646566;
  flex-shrink: 0;
  line-height: var(--cell-line-height, 48rpx);
}

.course-edit-field-label-inline--required::before {
  content: "*";
  color: #ee0a24;
  margin-right: 4rpx;
}

.course-edit-field-row--inline {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
}

.course-edit-field-row--inline .course-edit-field-value,
.course-edit-field-row--inline .course-edit-field-placeholder-text {
  flex: 1;
  min-width: 0;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-edit-field-value {
  font-size: var(--cell-font-size, 28rpx);
  color: #323233;
}

.course-edit-field-placeholder-text {
  font-size: var(--cell-font-size, 28rpx);
  color: #969799;
}

/* 弹层选项列表（与课程编辑 type-item 一致） */
.course-edit-type-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  margin: 0 0 12rpx;
  border-radius: 16rpx;
  background: var(--neutralBg, #f7f8fa);
  transition: all 0.2s ease;
}

.course-edit-type-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #c8c9cc;
  transition: background 0.2s ease;
}

.course-edit-type-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--neutralText, #323233);
}

.course-edit-type-check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.course-edit-type-item.is-active {
  background: var(--projectColorLight, #e5f1ec);
}

.course-edit-type-item.is-active .course-edit-type-name {
  color: var(--themeColor, #5b8a72);
  font-weight: 600;
}

.course-edit-type-item.is-active .course-edit-type-dot {
  background: var(--themeColor, #5b8a72);
  box-shadow: 0 0 0 6rpx rgba(91, 138, 114, 0.15);
}

/* 移动端分类 Tab：横向滑动 + 胶囊选择，不使用树状缩进。 */
.mcp-category-tabs { white-space: nowrap; margin: 10rpx 0 8rpx; }
.mcp-category-tabs-inner { display: inline-flex; gap: 14rpx; padding: 4rpx 2rpx 14rpx; }
.mcp-category-tab {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 19rpx 26rpx;
  border: 1rpx solid #e9ece9;
  border-radius: 18rpx;
  color: #646566;
  background: #fff;
  font-size: 27rpx;
  white-space: nowrap;
}
.mcp-category-tab.is-active {
  color: var(--themeColor, #5b8a72);
  border-color: transparent;
  background: var(--projectColorLight, #e9e2fb);
  font-weight: 600;
}
.mcp-category-hint { padding: 8rpx 4rpx 18rpx; color: #969799; font-size: 22rpx; }
.mcp-selected-category-list { min-height: 56rpx; display: flex; flex-wrap: wrap; gap: 10rpx; align-items: center; }
.mcp-selected-category-chip { display: inline-flex; align-items: center; gap: 8rpx; padding: 11rpx 16rpx; border-radius: 12rpx; color: var(--themeColor, #5b8a72); background: var(--projectColorLight, #e9e2fb); font-size: 23rpx; }
.mcp-no-category { color: #b0b3b0; font-size: 24rpx; padding: 8rpx 0; }

.mcp-custom-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid #e9ece9;
  border-radius: 16rpx;
  background: #fafbfa;
}

.mcp-custom-entry-title,
.mcp-custom-entry-sub {
  display: block;
}

.mcp-custom-entry-title {
  color: var(--themeColor, #5b8a72);
  font-size: 27rpx;
  font-weight: 600;
}

.mcp-custom-entry-sub {
  margin-top: 6rpx;
  color: #969799;
  font-size: 22rpx;
}

.course-edit-popup {
  border-radius: 20rpx 20rpx 0 0 !important;
}

.course-edit-sheet {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.course-edit-sheet-head {
  padding: 28rpx 32rpx 12rpx;
  flex-shrink: 0;
}

.course-edit-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #323233;
}

.course-edit-sheet-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #969799;
}

.course-edit-sheet-scroll {
  max-height: calc(80vh - 150rpx);
  padding: 8rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* scope 三段切换 */
.mcp-seg {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 24rpx 18rpx;
  padding: 6rpx;
  background: #f5f7f5;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.mcp-seg-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 0 13rpx;
  font-size: 26rpx;
  color: #646566;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.mcp-seg-item.is-active {
  background: #fff;
  color: var(--themeColor, #5b8a72);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.mcp-seg-desc { color: #a5aba6; font-size: 19rpx; font-weight: 400; }
.mcp-seg-item.is-active .mcp-seg-desc { color: var(--themeColor, #5b8a72); opacity: .7; }

.mcp-hint {
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #969799;
}

.mcp-section-title { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx 6rpx; color: #4d5850; font-size: 27rpx; font-weight: 600; }
.mcp-section-title text:last-child { color: var(--themeColor, #5b8a72); font-size: 22rpx; font-weight: 400; }
.mcp-all-state { display: flex; align-items: center; gap: 20rpx; margin: 16rpx 0; padding: 30rpx 24rpx; border-radius: 18rpx; background: var(--projectColorLight, #e9e2fb); }
.mcp-all-state-icon { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 50%; background: var(--themeColor, #5b8a72); color: #fff; font-size: 28rpx; font-weight: 700; }
.mcp-all-state-title, .mcp-all-state-sub { display: block; }
.mcp-all-state-title { color: var(--themeColor, #5b8a72); font-size: 28rpx; font-weight: 600; }
.mcp-all-state-sub { margin-top: 6rpx; color: #839087; font-size: 22rpx; }

/* 指定课程条目：主标题 + 分类副标题 */
.mcp-meet-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mcp-meet-text .course-edit-type-name {
  flex: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mcp-meet-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

/* 多选底部完成条 */
.mcp-sheet-foot {
  flex-shrink: 0;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--neutralBorder, #ebedf0);
}

.mcp-done-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--themeColor, #5b8a72);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
