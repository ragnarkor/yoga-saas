.coach-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  box-sizing: border-box;
  overflow: hidden;
  z-index: 999;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.coach-tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--neutralTextTertiary, #8f959e);
  font-size: 22rpx;
  gap: 6rpx;
  position: relative;
  transition: color var(--transition-base, 0.25s ease);
}

.coach-tab-item:active {
  opacity: 0.7;
}

.coach-tab-item.active {
  color: var(--themeColor, #5b8a72);
}

.coach-tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.coach-tab-text {
  line-height: 1;
  transition: font-weight var(--transition-base, 0.25s ease);
}

.coach-tab-item.active .coach-tab-text {
  font-weight: 600;
}
/* [AI_END LINES=18 TIMESTAMP=2025-01-26 10:35:00] */
